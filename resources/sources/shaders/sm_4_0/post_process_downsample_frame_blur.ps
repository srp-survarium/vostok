#include "common.h"

Texture2D	t_frame_color;

struct v2p_quad
{
	float4	hpos	: SV_POSITION;
	float2	tc		: TEXCOORD0;
};

float4 main( v2p_quad I ) : SV_TARGET
{
	float3	sum	= 0;

	[unroll] for (int x = -2; x <= 2; x++)
		[unroll] for (int y = -2; y <= 2; y++)
			sum	+= t_frame_color.SampleLevel( s_material1, I.tc, 0, int2( x, y)).xyz;

	return	float4( sum*0.04f, 0.0f);
}
