#else // NULL_VERTEX_INPUT_TYPE

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
};

material_parameters get_material_parameters(vertex_output_struct input)
{
	material_parameters parameters;
	clear_material_parameters(parameters);
	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(mul(m_V, float4( input.position, 1.f)), 1.0f);
	parameters.tc						= input.position.xz;

	return parameters;
}

#endif

#include "gbuffer.h"
#include "gamma_correction.h"

Texture2D t_transparency;
float 	  solid_transparency;
float	  attenuation_power;

float4 	main			(in vertex_output_struct input): SV_TARGET0
{
	material_parameters parameters = get_material_parameters(input);
	fill_material_parameters(parameters);

	float3 view_direction		= normalize(eye_position - parameters.world_position);
	float3 normal				= mul(m_V2W, float4(mul(parameters.tangent_to_viewspace, parameters.normal), 0.f));

	float  attenuation			= 1.f - pow(saturate(dot(normal, view_direction)), attenuation_power);
	attenuation					= saturate(attenuation > 0.045f ? attenuation + 1.f : attenuation);

	parameters.tc				*= constant_tile_uv;

	float4 final_color			= 0;
	final_color.rgb				= convert_to_linear_space(solid_color_specular.rgb);
	final_color.rgb				*= t_base.Sample( s_base, parameters.tc ).rgb;

	final_color.a				= solid_transparency;
	final_color.a 				*= t_transparency.Sample( s_linear, parameters.tc ).a;

	final_color					*= parameters.color;

	if (CONFIG_USE_SOFT_EDGES)
	{
		float pixel_depth 		= parameters.world_view_position.z;
		float frame_depth		= gbuffer_read_frame_depth(input.homogeneous_position.xy * screen_res.zw);
		final_color.a			*= saturate((frame_depth - pixel_depth) * 3.99f);
	}

	final_color.a				= saturate(final_color.a + attenuation);

	return final_color;
}
