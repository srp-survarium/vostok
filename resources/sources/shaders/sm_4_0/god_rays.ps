////////////////////////////////////////////////////////////////////////////
//	Ship source, verbatim out of build 816's /Zi blob (the only seven blobs in
//	the v0.1 line carrying an SDBG chunk), back-dated to 802 by the five edits
//	marked "802:" below - this is the one file of the seven whose source really
//	did move in those five days.  816 grew a second additive lobe, a 0.7
//	horizontal squeeze and a clamped falloff, and dropped the 5x gain.
//	See vostok/docs/shaders.md, "Ship source, verbatim".
////////////////////////////////////////////////////////////////////////////

/*	$DEFINES$:
*/

#include "common.h"

struct vertex_output_struct
{
	half4 hposition: SV_POSITION;
	half2 uv		: TEXCOORD0;
};


Texture2D t_light_scattering_mask;

float3 sun_direction_parameter;
//static const float3 sun_position 	= -sun_direction_parameter * 500.0h;

float4 god_rays_parameters0;
float4 god_rays_parameters1;
float4 god_rays_parameters2;

static const float3 god_rays_color_0 			= 	god_rays_parameters0.xyz;
static const float3 god_rays_color_1 			= 	god_rays_parameters1.xyz;
static const float god_rays_color_blend_power 	= 	god_rays_parameters0.w;
static const float god_rays_intensity 			= 	god_rays_parameters1.w;
static const float god_rays_attenuation_power	= 	god_rays_parameters2.x;


half3 scattered_color(half2 screen_uv)
{
	half scattering_power			= 1.0h;//1.0h - saturate(get_luminance(frame_color));
	
	// TODO: optimize, do in lower resolution target
	static const int num_samples 	= 100;
	
	half4 projected_sun_position 	= mul(m_VP, half4(eye_position.xyz - sun_direction_parameter * 500.0h, 1.0h));
	projected_sun_position.xy 		/= projected_sun_position.w;
	projected_sun_position.y		*= -1.0h;
	projected_sun_position.xy		= projected_sun_position.xy * 0.5h + 0.5h;
	
	half2 projected_sun_position_scaled	=	projected_sun_position.xy;
	
	half2 screen_uv_scaled			=	screen_uv;
	half ratio						=	screen_res.x / screen_res.y;	//	802: no 0.7 factor
	projected_sun_position_scaled.x	*=	ratio;
	screen_uv_scaled.x				*=	ratio;

	
	half2 to_sun_vector_delta		= (screen_uv - projected_sun_position.xy) / num_samples;
	
	half final_color				= 0.0h;
	
	half dist						= pow(distance(screen_uv_scaled, projected_sun_position_scaled.xy), god_rays_attenuation_power);
	dist							= exp(-dist*20);	//	802: no saturate/pow wrapper

	//dist							= pow((1-pow(dist, 2)), 0.5);
	//to_sun_vector_delta				*= 2.0h * (1.0h - dist);
	
	half2 current_uv = screen_uv;
	for (int i = 0; i < num_samples; i++)
	{
		current_uv 				-= to_sun_vector_delta;
		half occluder_color 	= t_light_scattering_mask.Sample(s_base, current_uv).r;
		final_color				+= occluder_color;
	}
	
	half alpha = max((dist) * scattering_power * final_color / num_samples, 0);
	
	half3 out_c = lerp(god_rays_color_0, god_rays_color_1, min(pow(alpha, god_rays_color_blend_power), 1.0h));
	//	802: the blend factor is min(...,1) - the blob emits an explicit `min`,
	//	not the `exp_sat` an outer saturate() would fuse - and there is no
	//	second, alpha2-weighted term.  816 adds both.

	return god_rays_intensity * alpha * out_c;
}

half4 main(vertex_output_struct input) : SV_TARGET
{
	half2 screen_uv					=	input.uv;
	
	half3 final_color 					=	t_light_scattering_mask.Sample(s_position, screen_uv).rrr;
	
	//return half4(final_color / 1.0h, 0.0h);
	/*
	for (int x = -1; x <= 1; x++)
	{
		for (int y = -1; y <= 1; y++)
		{
			final_color					+=	(1.0h - length(half2(x, y) / 1.4h)) * t_light_scattering_mask.Sample(s_position, screen_uv, int2(x,y)).rrr;
		}
	}
	*/
	final_color							= scattered_color(screen_uv);
	
	//	802: the pack carries a 5x gain (the blob's mul_sat is l(0.625), which
	//	is 5/8 against MAX_LIGHTING_COLOR = 8.0h).  816 drops it.
	return half4( PACK_LIGHTING_COLOR( final_color * 5.0h ), 0.0h);
	
}




























