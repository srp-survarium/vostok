	return parameters;
}

#else // NULL_VERTEX_INPUT_TYPE

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
};

material_parameters get_material_parameters(vertex_output_struct input)
{
	material_parameters parameters;
	clear_material_parameters(parameters);
	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(mul(m_V, float4( input.position, 1.f)), 1.0f);
	parameters.tc						= input.position.xz;

	return parameters;
}

#endif

#include "brdf.h"
#include "psf_alpha_test.h"

float4		m_probe_parameters0;		// xyz - probe centre in world space, w - probe range
float4		m_probe_parameters1;		// x - diffuse scale, y - specular scale, z - mip count

float 	  	solid_transparency;

TextureCube	t_probe_cubemap;
Texture2D	t_transparency;
Texture2D	t_roughness;
Texture2D	t_specular_intensity;

//	psf_normal.h's psf_tnormal, sampled through s_anisotropic.
float3 forward_tnormal( Texture2D _t_normal, float3x3 tangent_trans, float2 tc, float3 multiplier)
{
	float3 normal;
	normal.xy = _t_normal.Sample( s_anisotropic, tc).wy * 2.f - 1.f;
	normal.z  = sqrt( max( 1.0f - dot(normal.xy, normal.xy), 0.f));
	normal.y  = -normal.y;
	normal 	  = normalize(normal);
	normal 	  = mul( tangent_trans, normal * multiplier);
	return normalize( normal);
}

//	The probe cube stores colour pre-divided by its own alpha, in gamma space.
float3 sample_probe( float3 direction, float mip_level )
{
	float4 value	= t_probe_cubemap.SampleLevel( s_base, direction, mip_level );
	return	convert_to_linear_space( value.xyz/value.w );
}

float3 sample_probe_diffuse( float3 direction, float mip_level )
{
	float4 value	= t_probe_cubemap.SampleLevel( s_material1, direction, mip_level );
	return	convert_to_linear_space( value.xyz/value.w );
}

float4 	main			(in vertex_output_struct input): SV_TARGET0
{
	material_parameters parameters = get_material_parameters(input);
	fill_material_parameters(parameters);

	float2 		tc				= 	parameters.tc;
	float3x3	tangent_trans	= 	parameters.tangent_to_viewspace;

	float3 view_normal;
	if( CONFIG_TNORMAL)
		view_normal				= 	forward_tnormal( t_normal, tangent_trans, tc, float3(1,1,1));
	else
		view_normal				= 	parameters.normal;

	float3	normal				= normalize( mul( (float3x3)m_V2W, view_normal ) );
	float3	view_direction		= normalize( eye_position - parameters.world_position );

	float3	reflection			= -reflect( view_direction, normal );
	float3	light_direction		= normalize( reflection );
	float	light_dot_normal	= saturate( dot( light_direction, normal ) );
	float	view_dot_normal		= dot( view_direction, normal );

	float3	halfway_direction	= normalize( light_direction + view_direction );
	float	view_dot_halfway	= dot( view_direction, halfway_direction );
	float	view_dot_halfway_plus	= max( view_dot_halfway, 0.f );
	//	Named here, not spelled inside the quotient: the blobs fold the two
	//	maxes into one two-lane instruction and take the *4 straight after it.
	float	specular_denominator	= 4.f*max( view_dot_halfway, 0.00001f );

	float3 	diffuse_color;
	if( CONFIG_TDIFFUSE)
		diffuse_color			= 	t_base.Sample( s_base, tc).xyz;
	else
		diffuse_color			= 	convert_to_linear_space(solid_color_specular.xyz);

	//	CONFIG_ALPHA_TEST ships only as 0, and diffuse_color has no alpha lane
	//	here at all, so there is nothing for psf_alpha_test to clip against and
	//	no blob to answer to.  The include stays because ship's dependency table
	//	lists it; the call is deliberately absent rather than guessed.

	float 	transparency 		=	solid_transparency;
	if( CONFIG_TTRANSPARENCY)
		transparency 			*= 	t_transparency.Sample( s_linear, tc ).a;

	float 	smoothness			= 	specular_fresnel_roughness_parameters.z;
	if( CONFIG_TROUGHNESS)
		smoothness				+=	specular_fresnel_roughness_parameters.w*t_roughness.Sample( s_linear, tc ).x;

	float 	surface_roughness	=	1.f - smoothness;
	float 	fresnel_at_0_degree	=	specular_fresnel_roughness_parameters.x;

	//	The mirror direction puts the halfway vector exactly on the normal, so
	//	the Beckmann distribution collapses to its own normalisation constant.
	float	specular_power		= 255.f*(1.f - surface_roughness);
	float	roughness			= pow( 2.f/(specular_power + 2.f) - 0.00778f, 0.48f );
	float	normalized_distribution_function	= 1.f/(square( roughness )*pi);

	float	fresnel_factor		= fresnel_at_0_degree + (1.f - fresnel_at_0_degree)*pow( 1.f - view_dot_halfway_plus, 5.f );

	float	specular			=
		light_dot_normal > 0.f
		?
			normalized_distribution_function*(light_dot_normal*fresnel_factor)/
			(
				specular_denominator*ABS_TO_REMOVE_WARNING( view_dot_normal*light_dot_normal )
			)
		:
			0.f;

	float	specular_factor		= min( fresnel_factor*saturate( specular ), 100.f );
	if ( dot( reflection, normal ) < 0.f )
		specular_factor			= 1.f;

	float	mip					= (surface_roughness*saturate( view_dot_normal ))*m_probe_parameters1.z;
	float3	upper				= sample_probe( reflection, trunc( mip + 1.f ) );
	float3	lower				= sample_probe( reflection, trunc( mip ) );

	float3	specular_lighting	= lerp( lower*specular_factor, specular_factor*upper, frac( mip ) );
	float	clamped_roughness	= saturate( surface_roughness );
	specular_lighting			= lerp( specular_lighting, 0.f, clamped_roughness*(clamped_roughness*clamped_roughness) );
	specular_lighting			= m_probe_parameters1.y*specular_lighting;
	specular_lighting			= min( specular_lighting, 4.f );
	specular_lighting			= specular_lighting*convert_to_linear_space( specular_color_parameter );

	float3	to_probe			= m_probe_parameters0.xyz - parameters.world_position;
	float	normalized_distance	= sqrt( dot( to_probe, to_probe ) )/(m_probe_parameters0.w*0.95f);
	float	attenuation			= exp( -2.f*square( square( square( normalized_distance ) ) ) );
	attenuation					= square( square( attenuation ) );

	specular_lighting			= specular_lighting*attenuation;

	float3	diffuse_lighting	= sample_probe_diffuse( normal, m_probe_parameters1.z - 2.f );
	diffuse_lighting			= m_probe_parameters1.x*diffuse_lighting;
	diffuse_lighting			= min( diffuse_lighting, 10.f );
	diffuse_lighting			= diffuse_lighting*(1.f - fresnel_factor);
	diffuse_lighting			= diffuse_lighting*diffuse_color;

	float3	final_color			= diffuse_lighting*attenuation + specular_lighting;

	float soft_edge				= 1.f;
	if ( CONFIG_USE_SOFT_EDGES)
	{
		float pixel_depth		= parameters.world_view_position.z;
		float frame_depth		= gbuffer_read_frame_depth( input.homogeneous_position.xy/screen_res.xy );
		soft_edge				= saturate( (frame_depth - pixel_depth)*4.f );
	}

	return float4( final_color, soft_edge*saturate( parameters.color.a*transparency ) );
}
