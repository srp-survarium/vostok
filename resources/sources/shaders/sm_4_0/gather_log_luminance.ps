#include "common.h"
#include "gbuffer.h"
#include "gamma_correction.h"

Texture2D t_frame_color0;

struct v2p_gather
{
	float4	hpos	: SV_POSITION;
	float2	tc		: TEXCOORD0;
};

float4 main( v2p_gather vin) : SV_TARGET
{
	float3 color = clamp( t_frame_color0.Sample( s_accumulator, vin.tc).xyz, 0.0f, 1000000.0f);

	float luminance = dot( color, float3( 0.2125f, 0.7154f, 0.0721f));

	return float4( ( luminance + 0.001f).xxx, 0.0f);
}
