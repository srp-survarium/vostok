#include "common.h"

Texture2D	t_frame_color;

struct v2p_quad
{
	float4	hpos	: SV_POSITION;
	float2	tc		: TEXCOORD0;
};

float4 main( v2p_quad I ) : SV_TARGET
{
	float4	sum	= 0;

	[unroll] for (int x = 0; x < 4; x++)
		[unroll] for (int y = 0; y < 4; y++)
			sum	+= t_frame_color.Sample( s_accumulator, I.tc, int2( x, y));

	return	sum*0.0625f;
}
