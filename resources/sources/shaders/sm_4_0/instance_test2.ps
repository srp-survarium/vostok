/*	$DEFINES$:
		GLOBAL_SHADING_QUALITY,
		CONFIG_SHADOWED_LIGHT,
*/

#include "common.h"
#include "brdf.h"
#include "gbuffer.h"
#include "gamma_correction.h"
#include "light.h"
#include "positional_light.h"
#include "colored_light.h"
#include "spot_shadow.h"
#include "light_ps_helper.h"

uniform float3	s_eye_ray_corner;

light_accumulator main(
		float4	position		: SV_Position,
		float3	light_color		: LightColor,
		float	light_range		: LightRange,
		float3	light_position	: LightPosition
	)	: SV_Target
{
	light_accumulator			result;

	float2	tc					= position.xy*screen_res.zw;

	// Statement order is load-bearing: the shipped schedule issues the depth
	// tap between the eye ray's `mul` and its `div`, which is what decides
	// the operand order of the product below.
	float3	eye_ray;
	eye_ray.xy					= s_eye_ray_corner.xy*( 1 - tc*2 );

	float	depth				= gbuffer_read_frame_depth( tc );

	eye_ray.xy					/= s_eye_ray_corner.z;
	eye_ray.z					= 1;

	float3	surface_position	= eye_ray*depth;

	float3	light_direction		= mul( m_V, float4( light_position, 1.f)) - surface_position;
	float	square_distance		= squared_length( light_direction );

	float	attenuation			= square( max( abs( 1.f - saturate( square_distance/square( light_range))), 0.001f));

	if (0.0001f < attenuation)
	{
		float3	surface_normal	= gbuffer_read_frame_normal( tc );

		uint	fresnel_bits	= (uint)(t_diffuse.SampleLevel( s_diffuse, tc, 0).w*255.f);
		float	f0				= (float)(fresnel_bits & 127)*(1.f/127.f);

		uint	smoothness_bits	= (uint)(t_normal.SampleLevel( s_accumulator, tc, 0).z*1023.f);
		float	smoothness		= (float)(smoothness_bits & 127);

		light_direction			/= sqrt( square_distance );
		float3	view_direction	= normalize( -surface_position );

		float	roughness		= pow( 2.f/((1.f - smoothness*(1.f/127.f))*255.f + 2.f) - 0.00778f, 0.48f);

		float3	halfway_direction		= normalize( light_direction + view_direction );
		float	view_dot_halfway		= dot( view_direction, halfway_direction );
		float	view_dot_halfway_plus	= max( view_dot_halfway, 0.f );

		float	fresnel_factor	= f0 + (1.f - f0)*pow( 1.f - view_dot_halfway_plus, 5.f );

		surface_normal.z		= -surface_normal.z;

#if GLOBAL_SHADING_QUALITY == 3
		float	normal_dot_view		= dot( surface_normal, view_direction );
#endif // #if GLOBAL_SHADING_QUALITY == 3

		float	light_dot_normal	= saturate( dot( light_direction, surface_normal ));
		float	diffuse_factor		= light_dot_normal*(fresnel_factor > 0.99f ? 1.f : 1.f - fresnel_factor);

		float	cosine_theta			= dot( surface_normal, halfway_direction );
		float	square_cosine_theta		= square( cosine_theta );
		float	square_tangent_theta	= (1.f - square_cosine_theta)/square_cosine_theta;

#if GLOBAL_SHADING_QUALITY == 3
		// Cook-Torrance's geometric attenuation, and the ONLY thing
		// GLOBAL_SHADING_QUALITY changes here: at 0 the specular has no
		// shadowing/masking term at all (107 slots against 116).
		float	geometric_factor		=
			min(
				min(
					2.f*saturate( cosine_theta*normal_dot_view/view_dot_halfway ),
					2.f*saturate( cosine_theta*light_dot_normal/view_dot_halfway )
				),
				1.f
			);
#endif // #if GLOBAL_SHADING_QUALITY == 3

		float	square_roughness		= square( roughness );
		float	distribution_function	= exp( -square_tangent_theta/square_roughness );

		float	normalized_distribution_function	=
			distribution_function/(square_roughness*pi*max( square( square_cosine_theta), 0.00001f));

		normalized_distribution_function	=
			min( normalized_distribution_function, 400000000000.0f/fresnel_factor );

		float	specular_factor	=
			light_dot_normal > 0.f
			?
#if GLOBAL_SHADING_QUALITY == 3
				(fresnel_factor*light_dot_normal)*geometric_factor*normalized_distribution_function/(4.f*max( view_dot_halfway, 0.00001f))
#else // #if GLOBAL_SHADING_QUALITY == 3
				(fresnel_factor*light_dot_normal)*normalized_distribution_function/(4.f*max( view_dot_halfway, 0.00001f))
#endif // #if GLOBAL_SHADING_QUALITY == 3
			:
				0.f;

		float	diffuse_energy	= max( diffuse_factor, 0.f);
		float3	light_energy	= attenuation*convert_to_linear_space( light_color );

		result.diffuse			= float4( light_energy*diffuse_energy, 0.f);
		result.specular			= float4( light_energy*specular_factor, 0.f);
	}
	else
	{
		result.diffuse			= float4( 0.f, 0.f, 0.f, 0.f);
		result.specular			= float4( 0.f, 0.f, 0.f, 0.f);
	}

	return	result;
}
