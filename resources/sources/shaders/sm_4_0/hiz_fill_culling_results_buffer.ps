////////////////////////////////////////////////////////////////////////////
//	Reconstructed 2026-08-18 from the shipped v0.100b blob
//	(shaders/sm_4_0/hiz_fill_culling_results_buffer.ps, plain permutation) -
//	absent from the recovered source drop. Byte-identity is the acceptance
//	test: python3 -m vostok.shaders roundtrip hiz_fill_culling_results_buffer.ps
//
//	One occluder test per rasterized cell: the VS hands the bounding sphere
//	over in TEXCOORD0 (centre.xyz, radius.w), and this shader builds the
//	sphere's screen-space square, picks the hi-z mip that covers it, and
//	compares the four corner taps against the sphere's nearest view depth.
//	White = visible, black = culled.
////////////////////////////////////////////////////////////////////////////

#include "common.h"

uniform float4	rasterize_size;

Texture2D	hiz_depth_texture;

struct	v2p_hiz_culling
{
	float4	hpos	: SV_Position;
	float4	sphere	: TEXCOORD0;
};

float2	project	( float3 position )
{
	float4	projected	= mul( m_VP, float4( position, 1.f));
	return	projected.xy/projected.w*float2( 0.5f, -0.5f) + 0.5f;
}

float4 	main	( v2p_hiz_culling I ) : SV_TARGET
{
	float3	center			= I.sphere.xyz;
	float	radius			= I.sphere.w;

	float3	view_center		= mul( m_V, float4( center, 1.f));

	if ( mul( m_P, float4( view_center, 1.f)).z < 0.f)
		return	1.f;

	float3	to_eye			= eye_position - center;
	float	distance		= length( to_eye);

	float3	up				= m_V[1].xyz;
	float3	right			= cross( to_eye, up);
	right					= right*rsqrt( dot( right, right));

	float	extent			= distance*tan( asin( radius/distance));

	float3	top				= up*extent + center;
	float3	corner0			= top - right*extent;
	float3	corner1			= top + right*extent;

	float3	bottom			= -up*extent + center;
	float3	corner2			= bottom - right*extent;
	float3	corner3			= bottom + right*extent;

	float2	uv0				= project( corner0);
	float2	uv1				= project( corner1);
	float2	uv2				= project( corner2);
	float2	uv3				= project( corner3);

	float	size			= length( uv0 - uv1)*max( rasterize_size.x, rasterize_size.y);
	float	nearest			= view_center.z - view_center.z*rsqrt( dot( view_center, view_center))*radius;
	float	mip				= min( max( ceil( log2( size)), 0.f), 8.f);

	float	depth0			= hiz_depth_texture.SampleLevel( s_base, uv0, mip).x;
	float	depth1			= hiz_depth_texture.SampleLevel( s_base, uv1, mip).x;
	float	depth2			= hiz_depth_texture.SampleLevel( s_base, uv2, mip).x;
	float	depth3			= hiz_depth_texture.SampleLevel( s_base, uv3, mip).x;

	float	depth			= max( max( depth0, depth1), max( depth2, depth3));

	return	depth + 20.f < nearest ? 0.f : 1.f;
}
