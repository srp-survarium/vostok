////////////////////////////////////////////////////////////////////////////
//	Reconstructed 2026-08-17 from the shipped v0.100b blob
//	(shaders/sm_4_0/color_wireframe.ps, plain permutation) - the file was
//	absent from the recovered source drop. Same shape as color.ps: the
//	blob multiplies the vertex color by (1, 1, 1, 0.5) - a half-alpha
//	wireframe tint.
////////////////////////////////////////////////////////////////////////////

#include "common.h"

float4 main( v2p_TL0uv vin) : SV_TARGET
{
	return vin.Color*float4( 1.f, 1.f, 1.f, 0.5f );
}
