	float4	homogeneous_position_copy	: TEXCOORD4;
	float3	view_position		: TEXCOORD5;
	float3	position			: TEXCOORD6;
	float2	tc					: TEXCOORD7;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);
	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(input.view_position, 1.0f);
	parameters.tc 						= input.tc;
	parameters.detail_tc 				= input.tc;
	parameters.color 					= input.color;
	parameters.tangent_to_viewspace 	= float3x3( input.tbn_x, input.tbn_y, input.tbn_z);

	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE==12

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
};

material_parameters get_material_parameters(vertex_output_struct input)
{
	material_parameters 		parameters;
	clear_material_parameters	(parameters);
	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE==13

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float2	tc					: TEXCOORD1;
	float3	tbn_x				: TEXCOORD2;
	float3	tbn_y				: TEXCOORD3;
	float3	tbn_z				: TEXCOORD4;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);
	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(mul(m_V, float4( input.position, 1.f)), 1.0f);
	parameters.tc 						= input.tc;
	parameters.detail_tc 				= input.tc;
	parameters.tangent_to_viewspace 	= float3x3( input.tbn_x, input.tbn_y, input.tbn_z);

	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE==14

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float2	tc					: TEXCOORD1;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);
	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(mul(m_V, float4( input.position, 1.f)), 1.0f);
	parameters.tc 						= input.tc;
	parameters.detail_tc 				= input.tc;

	return parameters;
}

#else // NULL_VERTEX_INPUT_TYPE

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
};

material_parameters get_material_parameters(vertex_output_struct input)
{
	material_parameters parameters;
	clear_material_parameters(parameters);
	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(mul(m_V, float4( input.position, 1.f)), 1.0f);
	parameters.tc						= input.position.xz;

	return parameters;
}

#endif

#include "psf_normal.h"
#include "gamma_correction.h"
#include "gbuffer.h"

float4x4	view_to_shadow;

struct ps_output
{
	float4	result				: SV_Target0;
	float4	result_parameters	: SV_Target1;
};

ps_output main(in vertex_output_struct input)
{
	material_parameters parameters = get_material_parameters(input);
	fill_material_parameters(parameters);

	float  pixel_depth		= parameters.world_view_position.z;

	float3 normal			= normalize(mul(m_V2W, float4(mul(parameters.tangent_to_viewspace, parameters.normal), 0.f)));
	float3 view_direction	= normalize(eye_position - parameters.world_position);
	float3 reflection		= view_direction + normal * (2.f * dot( view_direction, -normal));

	float4 result			= 1.f / rsqrt( saturate( pixel_depth * near_far_invn_invf.w * 10.f));
	float  ray_step			= result.w * 0.3f + 0.1f;

	reflection				= normalize(reflection);

	float3 position			= parameters.world_position;
	float3 ray				= 0.f;
	float  hit				= 0.f;
	float2 result_tc		= 0.f;

	[loop]
	for (int i = 0; i < 128; ++i)
	{
		position			-= ray_step * reflection;
		ray					+= ray_step * reflection;

		float  ray_depth	= mul(m_V, float4(position, 1.f)).z;
		float4 projected	= mul(m_VP, float4(position, 1.f));

		float2 tc			= (projected.xy * float2(1.f, -1.f) + projected.w) * 0.5f / projected.w;
		result_tc			= tc;

		float frame_depth	= t_position.SampleLevel( s_position, tc, 0).x;

		if (frame_depth < ray_depth && abs(frame_depth - ray_depth) < 0.4f)
		{
			hit				= 1.f;
			break;
		}

		hit					= 0.f;
	}

	ps_output output;
	output.result				= result;
	output.result_parameters.xy	= result_tc;
	output.result_parameters.z	= hit;
	output.result_parameters.w	= length(ray);
	return output;
}
