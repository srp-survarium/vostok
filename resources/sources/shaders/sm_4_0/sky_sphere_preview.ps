#include "common.h"

Texture2D	t_sky_sphere;

struct v2p_sky_sphere_preview
{
	float4	hpos		: SV_Position;
	float3	direction	: TEXCOORD0;
};

float4 main( v2p_sky_sphere_preview I ) : SV_TARGET
{
	float4	color	= t_sky_sphere.Sample( s_base, I.direction.xz*float2( 1.0f, 2.0f));
	color.w			= 1.0f;

	float	mask	= ( 0.5f >= I.direction.z) ? 1.0f : 0.0f;

	return	color*mask;
}
