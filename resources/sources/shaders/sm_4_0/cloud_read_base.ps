#include "common.h"

Texture2D	t_base_noise;

struct v2p_quad
{
	float4	hpos	: SV_POSITION;
	float2	tc		: TEXCOORD0;
};

float4 main( v2p_quad I ) : SV_TARGET
{
	return	float4( t_base_noise.Sample( s_accumulator, I.tc ).xyz, 1 );
}
