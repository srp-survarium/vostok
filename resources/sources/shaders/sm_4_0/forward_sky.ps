////////////////////////////////////////////////////////////////////////////
//	Reconstructed 2026-08-18 from the fifteen shipped v0.100b blobs - absent
//	from the recovered source drop.  Byte-identity is the acceptance test:
//	python3 -m vostok.shaders roundtrip forward_sky.ps
//
//	The pixel half of effect_fstage_sky_materials, pairing with the already
//	proven forward_sky.vs.  A sky dome sampled three times from the same uv
//	at explicit mip levels 2, 1 and 0 and summed - a hand-rolled blur that
//	softens the banding in a low-resolution sky texture - then averaged,
//	tinted by sky_color, and faded to white by a fog ramp read off the
//	*texture coordinate*, not off depth: fog rises as tc.y falls, so the
//	horizon washes out and the zenith does not.  The alpha carries the same
//	average with the fog taken back out of it.
//
//	==== the fifteen permutations =========================================
//
//	One per CONFIG_VERTEX_INPUT_TYPE, exactly as forward_sky.vs ships them,
//	and the body is the same code every time: the whole difference is where
//	the texture coordinate comes from.  The dispatch is forward_base.ps's,
//	unchanged - same per-type structs, same get_material_parameters, same
//	per-type loose uniforms ahead of gbuffer.h's near_far_invn_invf in
//	$Globals (up_view_vector.. for 7/8 at offset 0, patch_parameters for 11)
//	- which is what fixes sky_color at 80 and 32 in those two and at 16
//	everywhere else.  Types 10 (decal) and 12 (post process) never set
//	parameters.tc, so they compile to a constant sample at (0,0) and a fog
//	of saturate(1/range); type 0 (null) takes tc from the world position's
//	xz.  fill_material_parameters is NOT called - it reads m_P, and no
//	shipped blob here binds static_globals.
//
//	The ship dependency table names vertex_input.h and
//	null_mesh_vertex_input.h, so at ship these structs lived in that header.
//	They are local here for the reason forward_base.ps gives: the recovered
//	vertex_input.h numbers CONFIG_VERTEX_INPUT_TYPE differently than the
//	engine's enum_vertex_input_type, which is what the blobs follow.
//
//	==== constants ========================================================
//
//	The listing prints the averaging factor as l(0.333333); out of the DXBC
//	it is 0x3eaaaaab, float(1/3) exactly, so it is a division by three and
//	not a rounded literal.
////////////////////////////////////////////////////////////////////////////

/*	$DEFINES$:
		GLOBAL_USE_VEGETATION_TRAMPLE,
		CONFIG_USE_SUBUV,
		CONFIG_VERTEX_INPUT_TYPE,
		CONFIG_USE_BOUND_NORMALS,
		CONFIG_USE_UP_DIRECTIONAL_NORMALS,
		CONFIG_LOD_INDEX,
		CONFIG_WIND_MOTION,
*/

#include "common.h"
#include "material.h"

#if CONFIG_VERTEX_INPUT_TYPE==1 || CONFIG_VERTEX_INPUT_TYPE==2

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float3	tbn_x				: TEXCOORD1;
	float3	tbn_y				: TEXCOORD2;
	float3	tbn_z				: TEXCOORD3;
	float3	view_position		: TEXCOORD4;
	float2	tc					: TEXCOORD5;
#if CONFIG_VERTEX_INPUT_TYPE==2
	float3	color				: TEXCOORD6;
	float	occlusion			: TEXCOORD7;
#endif // #if CONFIG_VERTEX_INPUT_TYPE==2
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);
	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(input.view_position, 1.0f);
	parameters.tc 						= input.tc;
	parameters.detail_tc 				= input.tc;
	parameters.normal 					= normalize(input.tbn_z);
	parameters.tangent_to_viewspace 	= float3x3( input.tbn_x, input.tbn_y, input.tbn_z);
#if CONFIG_VERTEX_INPUT_TYPE==2
	parameters.color 					= float4(input.color, 1.0f);
#endif // #if CONFIG_VERTEX_INPUT_TYPE==2

	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE>=3 && CONFIG_VERTEX_INPUT_TYPE<=6

struct vertex_output_struct
{
	float3	tbn_x				: TEXCOORD0;
	float3	tbn_y				: TEXCOORD1;
	float3	tbn_z				: TEXCOORD2;
	float4  homogeneous_position: SV_Position;
	float3	view_position		: TEXCOORD3;
	float3	prev_position		: TEXCOORD4;
	float3	position			: TEXCOORD5;
	float2	tc					: TEXCOORD6;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);
	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(input.view_position, 1.0f);
	parameters.tc 						= input.tc;
	parameters.detail_tc 				= input.tc;
	parameters.tangent_to_viewspace 	= float3x3( input.tbn_x, input.tbn_y, input.tbn_z);

	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE==7 || CONFIG_VERTEX_INPUT_TYPE==8

float3   up_view_vector;
float3   right_view_vector;

float	 use_align_by_dir;
float3   view_location;

float	 use_fixed_axis;
float3   rotation_fixed_axis;

float locked_no_ratate_axis_index;

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float3	normal				: NORMAL;
	float4	color				: COLOR;
	float2	tc					: TEXCOORD1;
	float3  tangent				: TEXCOORD2;
	float3  binormal			: TEXCOORD3;
#if CONFIG_USE_SUBUV
	float4	tc1					: TEXCOORD4;
#endif // #if CONFIG_USE_SUBUV
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);
	parameters.world_position			= input.position;
	parameters.tc 						= input.tc;
#if CONFIG_USE_SUBUV
	parameters.sub_uv					= input.tc1;
#endif // #if CONFIG_USE_SUBUV
	parameters.detail_tc 				= input.tc;
	parameters.color 					= input.color;

	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE==9

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float4	color				: TEXCOORD1;
	float2	tc					: TEXCOORD2;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);
	parameters.world_position			= input.position;
	parameters.tc 						= input.tc;
	parameters.detail_tc 				= input.tc;
	parameters.color 					= input.color;

	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE==10

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters parameters;
	clear_material_parameters(parameters);

	parameters.world_position			= input.position;

	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE==11

float4 patch_parameters;

struct vertex_output_struct
{
	float3	tbn_x				: TEXCOORD0;
	float3	tbn_y				: TEXCOORD1;
	float3	tbn_z				: TEXCOORD2;
	float4	color				: TEXCOORD3;
	float4  homogeneous_position: SV_Position;
	float4	patch_color			: TEXCOORD4;
	float3	view_position		: TEXCOORD5;
	float3	position			: TEXCOORD6;
	float2	tc					: TEXCOORD7;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);
	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(input.view_position, 1.0f);
	parameters.tc 						= input.tc;
	parameters.detail_tc 				= input.tc;
	parameters.color 					= input.color;
	parameters.tangent_to_viewspace 	= float3x3( input.tbn_x, input.tbn_y, input.tbn_z);

	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE==12

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
};

material_parameters get_material_parameters(vertex_output_struct input)
{
	material_parameters 		parameters;
	clear_material_parameters	(parameters);
	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE==13

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float2	tc					: TEXCOORD1;
	float3	tbn_x				: TEXCOORD2;
	float3	tbn_y				: TEXCOORD3;
	float3	tbn_z				: TEXCOORD4;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);
	parameters.world_position			= input.position;
	parameters.tc 						= input.tc;
	parameters.detail_tc 				= input.tc;
	parameters.tangent_to_viewspace 	= float3x3( input.tbn_x, input.tbn_y, input.tbn_z);

	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE==14

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float2	tc					: TEXCOORD1;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);
	parameters.world_position			= input.position;
	parameters.tc 						= input.tc;
	parameters.detail_tc 				= input.tc;

	return parameters;
}

#else // NULL_VERTEX_INPUT_TYPE

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
};

material_parameters get_material_parameters(vertex_output_struct input)
{
	material_parameters parameters;
	clear_material_parameters(parameters);
	parameters.world_position			= input.position;
	parameters.tc						= input.position.xz;

	return parameters;
}

#endif

#include "gbuffer.h"
#include "gamma_correction.h"

float4	sky_color;
float4	fog_power_and_range;
float4	inscatter_parameters;

float4 	main			(in vertex_output_struct input): SV_TARGET
{
	material_parameters parameters	= get_material_parameters(input);

	float	fog			=
		min(
			pow( 1.f - saturate(( 1.f - parameters.tc.y)/fog_power_and_range.y), fog_power_and_range.x),
			1.f
		);

	float4	sky			=
		t_base.SampleLevel( s_linear, parameters.tc, 2.f) +
		t_base.SampleLevel( s_linear, parameters.tc, 1.f) +
		t_base.SampleLevel( s_linear, parameters.tc, 0.f);

	float	alpha		= lerp( sky.w/3.f, 0.f, fog);
	float3	color		= sky.xyz*sky_color.xyz;

	return	float4( lerp( color/3.f, 1.f, 1.f - alpha), alpha);
}
