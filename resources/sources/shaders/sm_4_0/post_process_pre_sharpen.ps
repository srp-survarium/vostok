////////////////////////////////////////////////////////////////////////////
//	Reconstructed 2026-08-17 from the shipped v0.100b blob - absent from the
//	recovered source drop. Byte-identity: python3 -m vostok.shaders roundtrip
////////////////////////////////////////////////////////////////////////////

#include "common.h"

Texture2D	t_frame_color;

struct v2p_post_process_sharpen
{
	float4	hpos	: SV_POSITION;
	float2	tc		: TEXCOORD0;
};

float4 sharpen_sample( float2 tc)
{
	return	t_frame_color.Sample( s_accumulator, tc);
}

float4 main( v2p_post_process_sharpen I ) : SV_TARGET
{
	float2	offset			= screen_res.zw*0.15f;

	float4	right			= sharpen_sample( I.tc + float2(  offset.x,       0.f));
	float4	left_top		= sharpen_sample( I.tc + float2( -offset.x,  offset.y));
	float4	right_bottom	= sharpen_sample( I.tc + float2(  offset.x, -offset.y));
	float4	left			= sharpen_sample( I.tc + float2( -offset.x,       0.f));
	float4	top				= sharpen_sample( I.tc + float2(       0.f,  offset.y));
	float4	right_top		= sharpen_sample( I.tc + float2(  offset.x,  offset.y));
	float4	left_bottom		= sharpen_sample( I.tc + float2( -offset.x, -offset.y));
	float4	bottom			= sharpen_sample( I.tc + float2(       0.f, -offset.y));

	float4	gradient_x		= ( right*2.f + right_bottom + right_top) -
							  ( left*2.f + left_bottom + left_top);
	float4	gradient_y		= ( top*2.f + left_top + right_top) -
							  ( bottom*2.f + left_bottom + right_bottom);

	float	edge			= sqrt( dot( gradient_x, gradient_x) + dot( gradient_y, gradient_y));

	float4	edges			= left + bottom + right + top;
	float4	corners			= right_bottom + left_bottom + left_top + right_top;
	float4	center			= sharpen_sample( I.tc);
	float4	blurred			= ( corners + edges*2.f + center*4.f)*0.083125f;

	return	edge > 1.f ? center*1.33f : center*2.3999f - blurred;
}
