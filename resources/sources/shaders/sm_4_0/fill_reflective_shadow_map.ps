/*	$DEFINES$:
		CONFIG_VERTEX_INPUT_TYPE,
		CONFIG_TDIFFUSE,
		CONFIG_USE_SUBUV,
*/

#include "common_cbuffers.h"
#include "common_samplers.h"
#include "gamma_correction.h"

////////////////////////////////////////////////////////////////////////////
//	vertex input types, ship numbering.  Each struct reproduces a shipped
//	input signature exactly - semantic spelling, index and mask - and the
//	three accessors below are the per-family table above.

#if CONFIG_VERTEX_INPUT_TYPE == 1 || CONFIG_VERTEX_INPUT_TYPE == 2

struct vertex_output_struct
{
	float4	homogeneous_position: SV_Position;
	float3	tbn_x				: TEXCOORD0;
	float3	tbn_y				: TEXCOORD1;
	float3	tbn_z				: TEXCOORD2;
	float3	position			: TEXCOORD3;
	float3	view_position		: TEXCOORD4;
	float2	tc					: TEXCOORD5;
#if CONFIG_VERTEX_INPUT_TYPE == 2
	float3	color				: TEXCOORD6;
	float	occlusion			: TEXCOORD7;
#endif // #if CONFIG_VERTEX_INPUT_TYPE == 2
};
#define material_position(input)	(input).position
#define material_normal(input)		float3((input).tbn_x.z, (input).tbn_y.z, (input).tbn_z.z)
#define material_tc(input)			(input).tc

#elif CONFIG_VERTEX_INPUT_TYPE >= 3 && CONFIG_VERTEX_INPUT_TYPE <= 6

struct vertex_output_struct
{
	float3	tbn_x				: TEXCOORD0;
	float3	tbn_y				: TEXCOORD1;
	float3	tbn_z				: TEXCOORD2;
	float4	homogeneous_position: SV_Position;
	float3	view_position		: TEXCOORD3;
	float3	prev_position		: TEXCOORD4;
	float3	position			: TEXCOORD5;
	float2	tc					: TEXCOORD6;
};
#define material_position(input)	(input).position
#define material_normal(input)		float3((input).tbn_x.z, (input).tbn_y.z, (input).tbn_z.z)
#define material_tc(input)			(input).tc

#elif CONFIG_VERTEX_INPUT_TYPE == 7 || CONFIG_VERTEX_INPUT_TYPE == 8

// particle_vertex_input.h's loose globals lead $Globals in these two.
float3	up_view_vector;
float3	right_view_vector;

float	use_align_by_dir;
float3	view_location;

float	use_fixed_axis;
float3	rotation_fixed_axis;

float	locked_no_ratate_axis_index;

struct vertex_output_struct
{
	float4	homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float3	normal				: NORMAL;
	float4	color				: COLOR;
	float2	tc					: TEXCOORD1;
	float3	tangent				: TEXCOORD2;
	float3	binormal			: TEXCOORD3;
#if CONFIG_USE_SUBUV
	float4	tc1					: TEXCOORD4;
#endif // #if CONFIG_USE_SUBUV
};
#define material_position(input)	(input).position
#define material_normal(input)		mul((float3x3)m_V, (input).normal)
#define material_tc(input)			(input).tc

#elif CONFIG_VERTEX_INPUT_TYPE == 9

struct vertex_output_struct
{
	float4	homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float4	color				: TEXCOORD1;
	float2	tc					: TEXCOORD2;
};
#define material_position(input)	(input).position
#define material_normal(input)		float3(0.f, 0.f, 1.f)
#define material_tc(input)			(input).tc

#elif CONFIG_VERTEX_INPUT_TYPE == 10

struct vertex_output_struct
{
	float4	homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
};
#define material_position(input)	(input).position
#define material_normal(input)		float3(0.f, 0.f, 1.f)
#define material_tc(input)			float2(0.f, 0.f)

#elif CONFIG_VERTEX_INPUT_TYPE == 11

// grassmesh_vertex_input.h's one loose global.
float4	patch_parameters;

struct vertex_output_struct
{
	float3	tbn_x				: TEXCOORD0;
	float3	tbn_y				: TEXCOORD1;
	float3	tbn_z				: TEXCOORD2;
	float4	color				: TEXCOORD3;
	float4	homogeneous_position: SV_Position;
	float4	params				: TEXCOORD4;
	float3	view_position		: TEXCOORD5;
	float3	position			: TEXCOORD6;
	float2	tc					: TEXCOORD7;
};
#define material_position(input)	(input).position
#define material_normal(input)		normalize(float3((input).tbn_x.z, (input).tbn_y.z, (input).tbn_z.z))
#define material_tc(input)			(input).tc

#elif CONFIG_VERTEX_INPUT_TYPE == 12

struct vertex_output_struct
{
	float4	homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
};
#define material_position(input)	float3(0.f, 0.f, 0.f)
#define material_normal(input)		float3(0.f, 0.f, 1.f)
#define material_tc(input)			float2(0.f, 0.f)

#elif CONFIG_VERTEX_INPUT_TYPE == 13

struct vertex_output_struct
{
	float4	homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float2	tc					: TEXCOORD1;
	float3	tbn_x				: TEXCOORD2;
	float3	tbn_y				: TEXCOORD3;
	float3	tbn_z				: TEXCOORD4;
};
#define material_position(input)	(input).position
#define material_normal(input)		float3(0.f, 0.f, 1.f)
#define material_tc(input)			(input).tc

#elif CONFIG_VERTEX_INPUT_TYPE == 14

struct vertex_output_struct
{
	float4	homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float2	tc					: TEXCOORD1;
};
#define material_position(input)	(input).position
#define material_normal(input)		float3(0.f, 0.f, 1.f)
#define material_tc(input)			(input).tc

#else // NULL_VERTEX_INPUT_TYPE

struct vertex_output_struct
{
	float4	homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
};
#define material_position(input)	(input).position
#define material_normal(input)		float3(0.f, 0.f, 1.f)
#define material_tc(input)			(input).position.xz

#endif // #if CONFIG_VERTEX_INPUT_TYPE

////////////////////////////////////////////////////////////////////////////

float4x4  light_local_to_world;

float3 light_color;
float light_intensity;

float3 diffuse_color_parameter;

void main(in vertex_output_struct input,
		  out float4 out_rsm_albedo 	: SV_Target0,
		  out float4 out_rsm_normal 	: SV_Target1,
		  out float4 out_rsm_position 	: SV_Target2)
{
	float2 uv						= 	material_tc(input);

	float3 diffuse_color			= 	convert_to_linear_space(diffuse_color_parameter);

	if (CONFIG_TDIFFUSE)
		diffuse_color				*= 	t_base.Sample(s_base, uv).rgb;

	float3 normal					= 	normalize(mul(m_V2W, float4(material_normal(input), 0.f)).xyz);

	out_rsm_albedo					= 	float4(diffuse_color * convert_to_linear_space(light_color) * light_intensity, 0.0f);
	out_rsm_normal					=	float4(normal, 0.0f);
	out_rsm_position				= 	float4(material_position(input), 0.0f);
}
