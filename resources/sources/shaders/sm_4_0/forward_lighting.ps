////////////////////////////////////////////////////////////////////////////
//	cascaded sun shadow
////////////////////////////////////////////////////////////////////////////

//	0.6/1280, the texel step sample_hw_pcf uses; the cascades share one atlas,
//	so a cascade's own step is half of it.
static const float cascade_shadow_texel = 0.00046875f;

//	One cascade of the four-quadrant atlas.  tap_count and kernel_scale are
//	compile-time at every call site, so the loop unrolls and the /tap_count
//	folds; the four calls below give the shipped 16/8/1/1 tap counts.
float sample_cascade( float3 shadow_tc, float2 cascade_offset, float2 rotation_seed, int tap_count, float kernel_scale )
{
	//	The halving and the depth bias have to sit in one float3 statement:
	//	fxc reassociates each tap's constant offset back into the halving mad,
	//	which kills the shared .xy value and leaves the .z lane as the
	//	mad-by-1.0 the blobs show.  Splitting them emits a bare add instead.
	float3 tc		= shadow_tc*float3( 0.5f, 0.5f, 1.f );
	tc.xy			+= cascade_offset;

#if GLOBAL_USE_POISSON_DISC_SHADOW_FILTER
	//	A world-stable per-pixel rotation: hash the coarsest cascade's own
	//	projection of this point.  fmod(x, 0.25f) is the sign-preserving frac
	//	the blobs spell as ge/frc/movc, and the two bases are exact - their
	//	log2 in the blob rounds to 9.213 and 7.12345 and to nothing shorter.
	float2 seed		= fmod( rotation_seed, 0.25f ) + 3.f;
	float angle		= frac( pow( 9.213f, seed.x )*pow( 7.12345f, seed.y ) ) - 0.5f;
	//	Transposed, and multiplied from the left, so the dp2s take the disc
	//	constant first the way the blobs do.  sin(-angle) is a second sincos
	//	at ship, not a negate.
	float2x2 rotation	= float2x2( cos(angle), sin(-angle), sin(angle), cos(angle) );

	float result	= 0.f;
	[unroll]
	for ( int i = 0; i < tap_count; ++i )
		result		+= t_cascaded_shadow_map.SampleCmpLevelZero( s_shmap, tc.xy + ((mul( poisson_disk[i], rotation )*kernel_scale + 1.f)*(cascade_shadow_texel*0.5f)), tc.z - 0.00001f ).x;

	return			result/tap_count;
#else
	float s0		= t_cascaded_shadow_map.SampleCmpLevelZero( s_shmap, tc.xy + (float2( -1.f, -1.f )*cascade_shadow_texel), tc.z - 0.00001f ).x;
	float s1		= t_cascaded_shadow_map.SampleCmpLevelZero( s_shmap, tc.xy + (float2( +1.f, -1.f )*cascade_shadow_texel), tc.z - 0.00001f ).x;
	float s2		= t_cascaded_shadow_map.SampleCmpLevelZero( s_shmap, tc.xy + (float2( -1.f, +1.f )*cascade_shadow_texel), tc.z - 0.00001f ).x;
	float s3		= t_cascaded_shadow_map.SampleCmpLevelZero( s_shmap, tc.xy + (float2( +1.f, +1.f )*cascade_shadow_texel), tc.z - 0.00001f ).x;

	return			(s0 + s1 + s2 + s3)/4.f;
#endif
}

bool inside_cascade( float3 tc )
{
	return	tc.x >= 0.002f && tc.x <= 0.998f && tc.y >= 0.002f && tc.y <= 0.998f && tc.z >= 0.f && tc.z <= 1.f;
}

float get_cascaded_shadow_factor( float3 position )
{
	float4 shadow_position	= float4( position, 1.f );
	float4 tc0		= mul( m_shadow0, shadow_position );
	float4 tc1		= mul( m_shadow1, shadow_position );
	float4 tc2		= mul( m_shadow2, shadow_position );
	float4 tc3		= mul( m_shadow3, shadow_position );

	float2 rotation_seed	= tc3.xy;

	float3 t0		= tc0.xyz/tc0.w;
	float3 t1		= tc1.xyz/tc1.w;
	float3 t2		= tc2.xyz/tc2.w;
	float3 t3		= tc3.xyz/tc3.w;

	//	Nearest cascade first, and each one is cheaper than the last: 16 taps
	//	over a 2.5-texel disc, then 8 over 1.25, then a single tap.  The last
	//	cascade's kernel is 0, which kills the rotation entirely - its blob has
	//	no sincos at all.  Written as returns in an else-if chain: fxc's
	//	returned-flag select is what the blobs' `mov r3.z, l(-1)` is.
	if ( inside_cascade( t0 ) )
		return		sample_cascade( t0, float2( 0.f, 0.f ), rotation_seed, 16, 2.5f );
	else if ( inside_cascade( t1 ) )
		return		sample_cascade( t1, float2( 0.5f, 0.f ), rotation_seed, 8, 1.25f );
	else if ( inside_cascade( t2 ) )
		return		sample_cascade( t2, float2( 0.f, 0.5f ), rotation_seed, 1, 0.625f );
	else if ( inside_cascade( t3 ) )
		return		sample_cascade( t3, float2( 0.5f, 0.5f ), rotation_seed, 1, 0.f );

	return			position.z > 0.75f ? 1.f : 0.f;
}

////////////////////////////////////////////////////////////////////////////
//	the forward BRDF: isotropic Beckmann, Schlick fresnel
////////////////////////////////////////////////////////////////////////////

#define FORWARD_RETAINED_RANGE_CLAMPS \
	( \
		( GLOBAL_SHADING_QUALITY == 0 && !GLOBAL_USE_POISSON_DISC_SHADOW_FILTER && !CONFIG_TNORMAL && !CONFIG_USE_SOFT_EDGES && CONFIG_VERTEX_INPUT_TYPE >= 1 && CONFIG_VERTEX_INPUT_TYPE <= 2 ) || \
		( GLOBAL_SHADING_QUALITY == 0 &&  GLOBAL_USE_POISSON_DISC_SHADOW_FILTER &&  CONFIG_TNORMAL && CONFIG_VERTEX_INPUT_TYPE >= 3 && CONFIG_VERTEX_INPUT_TYPE <= 6 ) || \
		( GLOBAL_SHADING_QUALITY >= 3 && !GLOBAL_USE_POISSON_DISC_SHADOW_FILTER &&  CONFIG_TNORMAL && CONFIG_TTRANSPARENCY && CONFIG_USE_SOFT_EDGES && CONFIG_VERTEX_INPUT_TYPE == 11 ) \
	)

#if FORWARD_RETAINED_RANGE_CLAMPS
float forward_distribution_clamp( float value, float upper_bound )
{
	precise float result = clamp( value, 0.f, upper_bound );
	return result;
}

float forward_attenuation_saturate( float value )
{
	precise float result = saturate( value );
	return result;
}
#endif

light_factors forward_brdf	(
		float3 light_direction,
#if FORWARD_RETAINED_RANGE_CLAMPS
		float3 view_offset,
#else
		float3 view_direction,
#endif
		float3 surface_normal,
		float2 surface_roughness,
		float fresnel_at_0_degree
	)
{
	light_factors result;

	float f0					= fresnel_at_0_degree;
#if FORWARD_RETAINED_RANGE_CLAMPS
	float inverse_view_length	= rsqrt( dot( view_offset, view_offset ) );
	float3 view_direction		= view_offset*inverse_view_length;
#endif
	//	The caller hands us 1 - smoothness and we undo it: the blobs really do
	//	compute 1-(1-z), because that is not z in floating point and fxc will
	//	not fold it.  From there it is the Beckmann slope of a Phong exponent,
	//	m = pow(2/(n+2) - 0.00778, 0.48).
#if FORWARD_RETAINED_RANGE_CLAMPS
	float specular_power		= mad( 1.f - surface_roughness.x, 255.f, 2.f );
	float roughness				= pow( 2.f/specular_power - 0.00778f, 0.48f );
	float3 halfway_direction	= normalize( mad( view_offset, inverse_view_length, light_direction ) );
#else
	float specular_power		= 255.f*(1.f - surface_roughness.x);
	float roughness				= pow( 2.f/(specular_power + 2.f) - 0.00778f, 0.48f );
	float3 halfway_direction	= normalize( light_direction + view_direction );
#endif

	float view_dot_halfway		= dot( view_direction, halfway_direction );
	float view_dot_halfway_plus	= max( view_dot_halfway, 0.f );
#if FORWARD_RETAINED_RANGE_CLAMPS
	float fresnel_factor		= mad( 1.f - f0, pow( 1.f - view_dot_halfway_plus, 5.f ), f0 );
#else
	float fresnel_factor		= f0 + (1.f - f0)*pow( 1.f - view_dot_halfway_plus, 5.f );
#endif

	float view_dot_normal		= dot( surface_normal, view_direction );
	float light_dot_normal		= saturate( dot( light_direction, surface_normal ) );

	result.diffuse				= light_dot_normal*(fresnel_factor > 0.99f ? 1.f : 1.f - fresnel_factor);

	float cosine_theta			= dot( surface_normal, halfway_direction );
	float square_cosine_theta	= square( cosine_theta );
#if FORWARD_RETAINED_RANGE_CLAMPS
	float square_sine_theta		= mad( -cosine_theta, cosine_theta, 1.f );
#else
	float square_sine_theta		= 1.f - square_cosine_theta;
#endif
	float square_tangent_theta	= square_sine_theta/square_cosine_theta;

#if GLOBAL_SHADING_QUALITY >= 3
	//	Cook-Torrance's geometric term.  The view half is named first and the
	//	min takes it first; the other order costs two operand swaps.
	float view_attenuation		= 2.f*saturate( cosine_theta*view_dot_normal/view_dot_halfway );
	float light_attenuation		= 2.f*saturate( cosine_theta*light_dot_normal/view_dot_halfway );
	float geometric_attenuation	= min( min( view_attenuation, light_attenuation ), 1.f );
#else
	float geometric_attenuation	= 1.f;
#endif

	// Keep the overflow guard inside the normalized distribution.
	float distribution_function	= exp( -square_tangent_theta/square( roughness ) );
#if FORWARD_RETAINED_RANGE_CLAMPS
	float distribution_quotient =
		distribution_function/
			(
				square( roughness )*pi*max( square( square_cosine_theta ), 0.00001f )
		);
	float normalized_distribution_function =
		forward_distribution_clamp( distribution_quotient, 400000000000.f/fresnel_factor );
#else
	float normalized_distribution_function	=
		min(
			distribution_function/
			(
				square( roughness )*pi*max( square( square_cosine_theta ), 0.00001f )
			),
			400000000000.f/fresnel_factor
		);
#endif

	result.specular				=
		light_dot_normal > 0.f
		?
			light_dot_normal*fresnel_factor*geometric_attenuation*
			normalized_distribution_function/
			(4.f*max( view_dot_halfway, 0.00001f ))
		:
			0.f;

	result.diffuse				= max( result.diffuse, 0.f );

	return						result;
}

light_factors forward_point_light	(
		float3 surface_position,
		float3 surface_normal,
		float3 light_position,
		float2 surface_roughness,
		float fresnel_at_0_degree
	)
{
	light_factors result;

	float3 light_direction		= light_position - surface_position;
	//	dot() spelled out, not squared_length(): the helper is literally
	//	`return dot(value, value)`, but routing the square through a call
	//	loses fxc's "this is non-negative" fact about it, and the saturate in
	//	the attenuation below then lowers to div_sat instead of the div/min
	//	pair the blobs hold.  Same value, different eight bytes.
	float square_distance		= dot( light_direction, light_direction );
	float distance				= sqrt( square_distance );
	light_direction				/= distance;

#if FORWARD_RETAINED_RANGE_CLAMPS
	float3 view_offset			= -surface_position;
	result						= forward_brdf( light_direction, view_offset, surface_normal, surface_roughness, fresnel_at_0_degree );
#else
	float3 view_direction		= normalize( -surface_position );
	result						= forward_brdf( light_direction, view_direction, surface_normal, surface_roughness, fresnel_at_0_degree );
#endif

#if FORWARD_RETAINED_RANGE_CLAMPS
	float radial_attenuation = forward_attenuation_saturate( square_distance/square(light_range) );
	float attenuation			= pow(
		max( abs(1.f - radial_attenuation), 0.001f ),
		light_attenuation_power
	);
#else
	float attenuation			= pow(
		max( abs(1.f - saturate( square_distance/square(light_range) )), 0.001f ),
		light_attenuation_power
	);
#endif

	result.diffuse				*= attenuation;
	result.specular				*= attenuation;

	return						result;
}

light_factors forward_spot_light	(
		float3 surface_position,
		float3 surface_normal,
		float3 light_position,
		float3 spot_direction,
		float2 surface_roughness,
		float fresnel_at_0_degree
	)
{
	light_factors result		= forward_point_light( surface_position, surface_normal, light_position, surface_roughness, fresnel_at_0_degree );

	float current_angle_cosine	= dot( normalize(surface_position - light_position), spot_direction );

	float spot_scale_factor		=
		current_angle_cosine >= light_spot_umbra_half_angle_cosine ?
			1.f :
			pow(
					max( current_angle_cosine - light_spot_penumbra_half_angle_cosine, 0.f )
					*
					ABS_TO_REMOVE_WARNING( light_spot_inversed_umbra_half_angle_cosine_minus_penumbra_half_angle_cosine ),
				light_spot_falloff
			);

	result.diffuse				*= spot_scale_factor;
	result.specular				*= spot_scale_factor;

	return						result;
}

light_factors forward_parallel_light	(
		float3 surface_position,
		float3 surface_normal,
		float2 surface_roughness,
		float fresnel_at_0_degree
	)
{
#if FORWARD_RETAINED_RANGE_CLAMPS
	float3 view_offset			= eye_position_view_space - surface_position;
	return						forward_brdf( -light_direction, view_offset, surface_normal, surface_roughness, fresnel_at_0_degree );
#else
	float3 view_direction		= normalize( eye_position_view_space - surface_position );
	return						forward_brdf( -light_direction, view_direction, surface_normal, surface_roughness, fresnel_at_0_degree );
#endif
}

// Float intermediates preserve fxc scheduling.
#if FORWARD_RETAINED_RANGE_CLAMPS
light_accumulator forward_light_accumulator( float3 light_color, float2 light_factors )
{
	light_accumulator result;
	float3 linear_light_color = convert_to_linear_space( light_color )*light_intensity;
	float2 nonnegative_light_factors = max( light_factors, 0.f );

	result.diffuse		= float4( ( linear_light_color * nonnegative_light_factors.x * light_diffuse_influence_factor ) / LIGHT_ACCUMULATOR_MAGNIFY_FACTOR, 0.f );
	result.specular		= float4( ( linear_light_color * nonnegative_light_factors.y * light_specular_influence_factor) / LIGHT_ACCUMULATOR_MAGNIFY_FACTOR, 0.f );

	result.diffuse		= PACK_LIGHTING_COLOR( result.diffuse );
	result.specular		= PACK_LIGHTING_COLOR( result.specular );

	return	result;
}
#else
light_accumulator forward_light_accumulator( float3 light_color, light_factors light_factors )
{
	light_accumulator result;

	result.diffuse		= float4( ( convert_to_linear_space(light_color) * light_intensity * max(light_factors.diffuse,  0.f) * light_diffuse_influence_factor ) / LIGHT_ACCUMULATOR_MAGNIFY_FACTOR, 0.f );
	result.specular		= float4( ( convert_to_linear_space(light_color) * light_intensity * max(light_factors.specular, 0.f) * light_specular_influence_factor) / LIGHT_ACCUMULATOR_MAGNIFY_FACTOR, 0.f );

	result.diffuse		= PACK_LIGHTING_COLOR( result.diffuse );
	result.specular		= PACK_LIGHTING_COLOR( result.specular );

	return	result;
}
#endif

//	The same Schlick term the BRDF computes, recomputed in main against the
//	light's own position - only the alpha uses it, and only at 1e-6.  The max
//	is named before f0 so the (1-f0) lands between it and the (1-vdh).
float get_fresnel_factor( float3 surface_position, float3 light_position, float fresnel_at_0_degree )
{
	float3 view_direction		= normalize( -surface_position );
	float3 to_light				= normalize( light_position - surface_position );
	float3 halfway_direction	= normalize( to_light + view_direction );
	float view_dot_halfway_plus	= max( dot( view_direction, halfway_direction ), 0.f );
	float f0					= fresnel_at_0_degree;
	return	f0 + (1.f - f0)*pow( 1.f - view_dot_halfway_plus, 5.f );
}

// This pass samples tangent-space normals through s_anisotropic.
float3 forward_tnormal( Texture2D _t_normal, float3x3 tangent_trans, float2 tc, float3 multiplier)
{
#if FORWARD_RETAINED_RANGE_CLAMPS
	float4 unpacked_normal;
	unpacked_normal.xy = mad( _t_normal.Sample( s_anisotropic, tc).wy, 2.f, -1.f );
	unpacked_normal.z  = sqrt( max( 1.0f - dot(unpacked_normal.xy, unpacked_normal.xy), 0.f));
	unpacked_normal.w  = -unpacked_normal.y;
	float3 reordered_normal = unpacked_normal.xzw;
	float inverse_normal_length = rsqrt( dot( reordered_normal, reordered_normal ) );
	float3 normal = reordered_normal.xzy*inverse_normal_length;
#else
	float3 normal;
	normal.xy = _t_normal.Sample( s_anisotropic, tc).wy * 2.f - 1.f;
	normal.z  = sqrt( max( 1.0f - dot(normal.xy, normal.xy), 0.f));
	normal.y  = -normal.y;
	normal 	  = normalize(normal);
#endif
	normal 	  = mul( tangent_trans, normal * multiplier);
	return normalize( normal);
}

float4 	main			(in vertex_output_struct input): SV_TARGET0
{
	material_parameters parameters = get_material_parameters(input);
	fill_material_parameters(parameters);

	float3 		position 		= 	parameters.world_view_position.xyz;
	float2 		tc				= 	parameters.tc;
	float3x3	tangent_trans	= 	parameters.tangent_to_viewspace;

	float4	diffuse_color		= 	float4( convert_to_linear_space(solid_color_specular.xyz), 1.f);
	if( CONFIG_TDIFFUSE)
		diffuse_color			*= 	t_base.Sample	( s_base, tc);

	if( CONFIG_ALPHA_TEST)
		psf_alpha_test			( diffuse_color.a);

	if( CONFIG_TDETAIL)
		diffuse_color.rgb		= 	psf_tdetail( t_detail, diffuse_color.rgb, tc);

	float3 normal;
	if( CONFIG_TNORMAL)
		normal					= 	forward_tnormal( t_normal, tangent_trans, tc, float3(1,1,1));
	else
		normal					= 	normalize( mul( tangent_trans, float3(0.0f,0.0f,1.0f)) );

	float 	transparency 		=	solid_transparency;
	if( CONFIG_TTRANSPARENCY)
		transparency 			*= 	t_transparency.Sample( s_linear, tc ).a;

	float3 	specular_color 		= 	convert_to_linear_space(specular_color_parameter);
	if( CONFIG_TSPECULAR_COLOR)
		specular_color 			*= 	psf_tspecular_intensity(t_specular_intensity, tc);

	float 	smoothness			= 	specular_fresnel_roughness_parameters.z;
	if( CONFIG_TROUGHNESS)
#if FORWARD_RETAINED_RANGE_CLAMPS
		smoothness				=	mad( specular_fresnel_roughness_parameters.w, t_roughness.Sample( s_base, tc ).x, smoothness );
#else
		smoothness				+=	specular_fresnel_roughness_parameters.w*t_roughness.Sample( s_base, tc ).x;
#endif

	//	Handed to the BRDF as 1 - smoothness, which the BRDF inverts again; see
	//	the note there.  The .w term is the texture's contribution range.
	float2 	roughness			=	(1.f - smoothness).xx;
	float 	fresnel_at_0_degree	=	specular_fresnel_roughness_parameters.x;

	float3 final_color 			= (0.0f).xxx;

#if FORWARD_RETAINED_RANGE_CLAMPS
	float2 light = 0.f;
#else
	light_factors light = (light_factors)0;
#endif
	float shadow = 1.f;

	//	An if/else chain, not a switch: the blobs hold if_z/ieq/if_nz, and a
	//	switch - forced or not - emits the switch opcode instead.  Only these
	//	three of the seven light types have arms at ship, and only the parallel
	//	one is shadowed.
	if ( light_type == LIGHT_TYPE_POINT)
	{
#if FORWARD_RETAINED_RANGE_CLAMPS
		light_factors factors = forward_point_light( position, normal, light_position, roughness, fresnel_at_0_degree);
		light = float2( factors.diffuse, factors.specular );
#else
		light = forward_point_light( position, normal, light_position, roughness, fresnel_at_0_degree);
#endif
	}
	else if ( light_type == LIGHT_TYPE_SPOT)
	{
#if FORWARD_RETAINED_RANGE_CLAMPS
		light_factors factors = forward_spot_light( position, normal, light_position, light_direction, roughness, fresnel_at_0_degree);
		light = float2( factors.diffuse, factors.specular );
#else
		light = forward_spot_light( position, normal, light_position, light_direction, roughness, fresnel_at_0_degree);
#endif
	}
	else if ( light_type == LIGHT_TYPE_PARALLEL)
	{
#if FORWARD_RETAINED_RANGE_CLAMPS
		light_factors factors = forward_parallel_light( position, normal, roughness, fresnel_at_0_degree);
		light = float2( factors.diffuse, factors.specular );
#else
		light = forward_parallel_light( position, normal, roughness, fresnel_at_0_degree);
#endif
		//	12/768 of a texel along the normal; shadow_map_size is unreferenced
		//	in every blob, so the offset is a literal.
		shadow = get_cascaded_shadow_factor( position + normal*0.015625f );
	}
	light_accumulator accumulator = forward_light_accumulator( light_color.rgb, light );

	//	The shadow multiplies the two material colours, after the packing - the
	//	packing is non-linear, so this is not the same as shadowing the light.
	//	Shadow-first in both lines: the other spelling costs an operand swap.
	final_color += shadow*diffuse_color.rgb*accumulator.diffuse.rgb;
	final_color += shadow*specular_color*accumulator.specular.rgb;

	float fresnel				= get_fresnel_factor( position, light_position, fresnel_at_0_degree );

	float soft_edge				= 1.f;
	if ( CONFIG_USE_SOFT_EDGES)
	{
		float pixel_depth		= parameters.world_view_position.z;
		float frame_depth		= gbuffer_read_frame_depth( input.homogeneous_position.xy*screen_res.zw );
		soft_edge				= saturate( (frame_depth - pixel_depth)*4.f );
	}

	return float4( final_color, soft_edge*saturate( parameters.color.a*transparency - fresnel*0.000001f ) );
}
