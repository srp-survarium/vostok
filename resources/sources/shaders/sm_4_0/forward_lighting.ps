#define LIGHT_TYPE_POINT 		0
#define LIGHT_TYPE_SPOT 		1
#define LIGHT_TYPE_OBB 			2
#define LIGHT_TYPE_CAPSULE 		3
#define LIGHT_TYPE_PARALLEL 	4
#define LIGHT_TYPE_SPHERE 		5
