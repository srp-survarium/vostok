////////////////////////////////////////////////////////////////////////////
//	Reconstructed	: 17.08.2026
//	Ground truth	: the 600 shipped permutations of
//					  shaders/sm_4_0/forward_lighting.ps, disassembled with
//					  fxc /dumpbin /Fc.  The file that arrived with the drop was
//					  a deeply drifted revision - it named dead defines
//					  (CONFIG_TSPECULAR_POWER), routed lighting through header
//					  functions the blobs do not contain, and handled seven
//					  light types where ship handles three.  It was read as an
//					  aid; every line below is answerable to a listing.
//	Acceptance		: python3 -m vostok.shaders roundtrip forward_lighting.ps
////////////////////////////////////////////////////////////////////////////
//
//	The forward (alpha-blended) lighting pass: one light, one draw, added into
//	the frame.  Ship's axes and what each does:
//
//	  CONFIG_VERTEX_INPUT_TYPE   0..14, all fifteen ship
//	  GLOBAL_SHADING_QUALITY     0 or 3 - 3 adds the Smith geometric term
//	  GLOBAL_USE_POISSON_DISC_SHADOW_FILTER
//	                             0 = four-tap PCF per cascade,
//	                             1 = a rotated Poisson disc, 16/8/1/1 taps
//	  CONFIG_TDIFFUSE, CONFIG_TNORMAL, CONFIG_TROUGHNESS,
//	  CONFIG_TTRANSPARENCY, CONFIG_USE_SOFT_EDGES   ten combinations ship
//	  CONFIG_USE_SUBUV           1 exactly when the input type is 8
//
//	Ten shapes in here look arbitrary and are not; each is load-bearing for
//	byte-identity and commented where it sits:
//
//	  * light_type is a runtime int, and only 0 (point), 1 (spot) and 4
//	    (parallel) have arms - the obb/capsule/sphere/plane-spot cases the
//	    drifted source carried are gone.  It compiles as an if/else chain, not
//	    a switch: the blobs hold if_z/ieq, not the switch opcode;
//	  * only the parallel light is shadowed, by the cascade atlas, and the
//	    shadow is applied to the two material colours, after the accumulator
//	    packing, never to the light factors;
//	  * the BRDF is an isotropic Beckmann with a Schlick fresnel, and the
//	    roughness is 1 - specular_fresnel_roughness_parameters.z fed back
//	    through 255*(1 - r) - the double negation survives because 1-(1-z) is
//	    not z in floating point and fxc will not fold it;
//	  * the specular is clamped as min(ndf, 4e11/fresnel), inside the ndf
//	    expression, not around the finished specular;
//	  * the diffuse's max(...,0) is a statement of its own after the specular
//	    is assigned - the blobs schedule it there;
//	  * the shadow-map tap builds tc*float3(.5,.5,1) once and lets fxc
//	    reassociate the constant offsets back into per-tap mads; the z lane
//	    then survives as the mad-by-1.0 the blobs show;
//	  * the Poisson rotation angle is a hash of the *fourth* cascade's
//	    projection: frac(pow(9.213,e.x)*pow(7.12345,e.y)) - 0.5 over
//	    e = fmod(tc3.xy, 0.25) + 3;
//	  * the alpha keeps a fresnel term at -1e-6 - too small to see, large
//	    enough that the whole fresnel chain is emitted;
//	  * CONFIG_VERTEX_INPUT_TYPE 1/2 puts the tangent basis at TEXCOORD0..2 and
//	    the world position at TEXCOORD3 - the opposite of forward_base.ps's
//	    labelling, which its blobs cannot tell apart because it reads neither;
//	  * every scalar-times-vector product in the final combine is written
//	    shadow-first; the other order costs one operand swap per blob.
//
//	Unverified: CONFIG_ALPHA_TEST, CONFIG_TDETAIL, CONFIG_TSPECULAR_COLOR,
//	CONFIG_PARALLAX and CONFIG_TFRESNEL ship only as 0, so their arms are
//	carried from the drifted source and no blob constrains them.
//
//	PARKED - 563 of the 600 recompile byte-identically; 37 do not, and every
//	one of them is the same compiler fact seen from a different side.  fxc
//	decides, per compile, whether a value is provably non-negative, and that
//	one decision moves three things at once: whether a max(x, 0) survives or
//	is folded away, whether the attenuation's saturate lowers to div_sat or to
//	div+min, and whether the vectoriser pairs two x*x products into a single
//	instruction.  The shipped blobs disagree with *each other* the same way -
//	input type 0 folds the distribution's lower clamp away, input type 1 keeps
//	it, out of one source - so the residue is fxc's own heuristic reacting to
//	register lifetimes, not a shape this file still has wrong.  Where they sit:
//
//	  * input types 1 and 2, CONFIG_TNORMAL = 0                  (4 blobs)
//	  * input types 3..6, the Poisson filter, CONFIG_TNORMAL = 1 (28 blobs)
//	  * input type 11 at GLOBAL_SHADING_QUALITY = 3              (3 blobs)
//	  * input types 10 and 13 at GLOBAL_SHADING_QUALITY = 3      (2 blobs)
//
//	Tried, and did not move them: clamp() / min(max()) / max(min()) around the
//	distribution and around the finished specular - clamp(., 0, .) fixes the
//	last two families and breaks eight elsewhere, a net loss of six, so the
//	plain min() is what is written; the diffuse's max early, late, and both;
//	square() inlined as x*x at each of its sites; squared_length() against
//	dot() against length()-then-square() for the light distance (dot() is what
//	the eight blobs of input type 13 wanted, and is what is written); the
//	attenuation with and without its abs(); the distribution behind a helper
//	function of its own; naming the accumulator's two max() results, and
//	packing them as a float2.
//
////////////////////////////////////////////////////////////////////////////

/*	$DEFINES$:	the twenty-one names shaders/masks records for this stage;
	nine of them take more than one value across the 600 shipped blobs.

		GLOBAL_SHADING_QUALITY,
		GLOBAL_USE_VEGETATION_TRAMPLE,
		GLOBAL_USE_POISSON_DISC_SHADOW_FILTER,
		GLOBAL_ALLOW_STEEPPARALLAX,

		CONFIG_VERTEX_INPUT_TYPE,
		CONFIG_TDIFFUSE,
		CONFIG_TNORMAL,
		CONFIG_ALPHA_TEST,
		CONFIG_PARALLAX,
		CONFIG_TSPECULAR_COLOR,
		CONFIG_TFRESNEL,
		CONFIG_TROUGHNESS,
		CONFIG_TDETAIL,
		CONFIG_USE_SUBUV,
		CONFIG_TTRANSPARENCY,
		CONFIG_SHADOWED_LIGHT,
		CONFIG_USE_BOUND_NORMALS,
		CONFIG_USE_UP_DIRECTIONAL_NORMALS,
		CONFIG_LOD_INDEX,
		CONFIG_USE_SOFT_EDGES,
		CONFIG_WIND_MOTION,
*/

//	HEADER FINDING - common_samplers.h.  At ship the sampler between s_linear
//	and s_base is named s_anisotropic; the recovered header names it s_border,
//	which nothing in the tree ever samples through.  Every CONFIG_TNORMAL
//	permutation binds s_linear = s0, s_anisotropic = s1, s_base = s2, and
//	sampler slots follow declaration order, so the name has to appear *there*.
//	This reconstruction may not edit shared headers, so it renames the slot
//	through the preprocessor.  Declaring `sampler s_anisotropic : register(s1)`
//	here instead produces the same slot but sets D3D_SIF_USERPACKED (0x1) in
//	the RDEF binding record, which the shipped blobs do not have - that one
//	flag word is the whole difference.  Delete these two lines once
//	common_samplers.h carries s_anisotropic itself.

#include "common.h"

//	HEADER FINDING - shadow.h.  The shipped dependency table lists shadow.h
//	right after common.h, and $Globals opens with m_shadow0..3 at offsets
//	0/64/128/192.  The recovered shadow.h declares cascade_shadow_map_size
//	before them and has no t_cascaded_shadow_map at all, so including it puts a
//	float in slot 0 and loses the texture; ship's revision must declare the
//	four matrices first and the cascade atlas beside them.  Until shadow.h
//	carries that, the four matrices and the atlas live here.  s_shmap is not
//	one of them: it comes from spot_shadow.h, via point_light.h, which is why
//	it is the last sampler declared and the last slot bound.
float4x4	m_shadow0;
float4x4	m_shadow1;
float4x4	m_shadow2;
float4x4	m_shadow3;

Texture2D	t_cascaded_shadow_map;

#include "psf_alpha_test.h"
#include "psf_detail.h"
#include "psf_normal.h"
#include "psf_parallax.h"
#include "psf_translucent.h"
#include "psf_tspecular_intensity.h"
#include "psf_tspecular_power.h"
#include "psf_tdiffuse_power.h"
#include "psf_emissive.h"
#include "psf_make_tangent_transform.h"
#include "psf_fresnel.h"

float4x4  light_local_to_world;

#include "light_ps_helper.h"
#include "point_light.h"
#include "parallel_light.h"
#include "plane_spot_light.h"
#include "obb_light.h"
#include "capsule_light.h"
#include "sphere_light.h"

#include "gamma_correction.h"

#include "gbuffer.h"
