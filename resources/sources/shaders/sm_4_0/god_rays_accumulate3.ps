#include "common.h"

uniform float4x4	sphere_to_sky_matrix;
uniform float		slice_transparency;
uniform float3		clouds_grid_size;
uniform float3		clouds_offset;
uniform float		layer_height;
uniform float		interp_alpha;
uniform float		cloud_base;
uniform float3		to_sun_direction_parameter;

Texture3D	t_clouds_0;
Texture3D	t_clouds_1;

struct vertex_output_struct
{
	float4 hposition			: SV_Position;
	float3 world_position		: TEXCOORD0;
	float3 object_position		: TEXCOORD1;
	float2 uv					: TEXCOORD2;
	float  interpolated_fog		: TEXCOORD3;
};

float4 main( in vertex_output_struct input ) : SV_Target
{
	float3	position		=	input.world_position + clouds_offset;
	float3	sun_position	=	to_sun_direction_parameter*100000.0f + eye_position;

	sun_position			+=	clouds_offset;

	float3	to_sun			=	normalize( sun_position - position);

	float	top				=	cloud_base*1.5f;
	float	distance_to_top	=	top - min( max( position.y, 0.0f), top);

	position.xz				+=	distance_to_top*to_sun.xz;

	float	depth			=	mul( m_V, float4( input.world_position, 1.0f)).z;
	float	visibility		=	1.0f - saturate( depth/50000.0f);

	float4	projected		=	mul( sphere_to_sky_matrix, float4( position, 1.0f));

	if (projected.y > 1.0f || projected.y < 0.0f)
		discard;

	float	density			=	lerp( t_clouds_0.Sample( s_base, projected.xyz).x, t_clouds_1.Sample( s_base, projected.xyz).x, interp_alpha);

	float	vertical		=	max( 1.0f - abs( position.y/top*2.0f - 1.0f), 0.0f);
	float	weight			=	visibility*vertical*0.25f;

	float	transparency	=	1.0f - density;
	float	cubed			=	transparency*(transparency*transparency);

	return	float4( 1.0f, 1.0f, 1.0f, saturate( weight*cubed));
}
