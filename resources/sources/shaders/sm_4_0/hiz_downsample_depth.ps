#include "common.h"

Texture2D	hiz_depth_texture;

float4 main( float4 hpos : SV_POSITION, float2 tc : TEXCOORD0 ) : SV_TARGET
{
	uint3	coord	= uint3( uint2( hpos.xy )*2, 0 );

	float	depth	= max(
		max( hiz_depth_texture.Load( coord, int2( 0, 0 ) ).x, hiz_depth_texture.Load( coord, int2( 1, 0 ) ).x ),
		max( hiz_depth_texture.Load( coord, int2( 0, 1 ) ).x, hiz_depth_texture.Load( coord, int2( 1, 1 ) ).x )
	);
	return	depth;
}
