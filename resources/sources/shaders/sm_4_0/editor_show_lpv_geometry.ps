#include "common.h"
#include "gamma_correction.h"

struct v2p_lpv_geometry
{
	float4	hpos		: SV_Position;
	float3	normal		: TEXCOORD0;
	float3	flux		: TEXCOORD1;
	float3	color		: TEXCOORD2;
};

float4 main( v2p_lpv_geometry I ) : SV_Target
{
	return	float4( convert_from_linear_space( I.color), 0.0f);
}
