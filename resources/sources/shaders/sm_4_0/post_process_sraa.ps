#include "common.h"
#include "gamma_correction.h"

Texture2D	t_frame_color;

struct v2p_quad
{
	float4	hpos	: SV_POSITION;
	float2	tc		: TEXCOORD0;
};

float4 main( v2p_quad I ) : SV_TARGET
{
	float4	color	= t_frame_color.SampleLevel( s_accumulator, I.tc, 0);

	return	float4( convert_from_linear_space( color.xyz), 0.0f);
}
