////////////////////////////////////////////////////////////////////////////
//	Reconstructed 2026-08-18 from the shipped v0.100b blob; the pre-ship
//	revision in old/ is one generation back - it returned a single combined
//	target, where ship writes the blurred frame to target 0 and the bloom to
//	target 1, and scales the bloom by bloom_parameters.x AND the
//	bloom_parameters1 tint. Byte-identity: python3 -m vostok.shaders roundtrip
////////////////////////////////////////////////////////////////////////////

#include "common.h"
#include "gbuffer.h"
#include "dof_functions.h"
#include "luminance.h"

Texture2D 	t_frame_color;
Texture2D 	t_frame_luminance;

#define NUM_SAMPLES 8

uniform float4 kernel_offsets[NUM_SAMPLES];
uniform float4 bloom_parameters;
uniform float4 bloom_parameters1;
uniform float4 frame_luminance_parameter;

static const float bloom_scale  = bloom_parameters.x;

float get_min_frame_luminance( )
{
	return t_frame_luminance.Sample(s_accumulator, float2(0.5f, 0.5f)).g;
}

float get_max_frame_luminance( )
{
	return max( t_frame_luminance.Sample(s_accumulator, float2(0.5f, 0.5f)).b, 1.0f);
}

float get_average_frame_luminance( )
{
	return clamp( t_frame_luminance.Sample(s_accumulator, float2(0.5f, 0.5f)).r, 0.1f, 4.0f);
}

struct ps_output
{
	float4	frame	: SV_Target0;
	float4	bloom	: SV_Target1;
};

ps_output main( v2p_TL vin)
{
	ps_output	output;

	float3	colors[NUM_SAMPLES];

	// The centre tap seeds the average; the loop adds the eight kernel taps,
	// and ship still divides by NUM_SAMPLES - nine taps over eight.
	float4	out_frame_color_and_depth	= float4( t_frame_color.Sample(s_material1, vin.Tex0).rgb, gbuffer_read_frame_depth(vin.Tex0));

	[unroll] for(int i = 0; i < NUM_SAMPLES; i++)
	{
		float2 uv					= vin.Tex0 + kernel_offsets[i].xy;

		colors[i]					= t_frame_color.Sample(s_material1, uv).rgb;
		out_frame_color_and_depth	+= float4( colors[i], gbuffer_read_frame_depth(uv));
	}

	out_frame_color_and_depth		= out_frame_color_and_depth/NUM_SAMPLES;

	float	blurriness				= get_blurriness( out_frame_color_and_depth.a);

	output.frame.w					= blurriness;
	output.frame.xyz				= max( blurriness*out_frame_color_and_depth.rgb, 0.0f);

	float	min_frame_luminance		= get_min_frame_luminance();
	float	difference				= get_max_frame_luminance() - min_frame_luminance;
	float	average_luminance_pct	= ( get_average_frame_luminance() - min_frame_luminance)/difference;

	float3	out_bloom_color			= 0;

	[unroll] for(int j = 0; j < NUM_SAMPLES; j++)
	{
		float	luminance_pct		= ( get_luminance( colors[j]) - min_frame_luminance)/difference;
		float	bright_power		= max( luminance_pct - average_luminance_pct, 0.0f);

		out_bloom_color				+= bright_power*colors[j];
	}

	out_bloom_color					= out_bloom_color*bloom_scale*bloom_parameters1.xyz/NUM_SAMPLES;

	output.bloom.xyz				= max( out_bloom_color, 0.0f);
	output.bloom.w					= 0.0f;

	return	output;
}
