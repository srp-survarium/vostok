#include "common.h"
#include "gbuffer.h"
#include "gamma_correction.h"

Texture2D	t_decals_blend_result;

struct v2p_decal_write
{
	float4	hpos	: SV_POSITION;
	float2	tc		: TEXCOORD0;
};

float4 main( v2p_decal_write I ) : SV_TARGET
{
	return	t_decals_blend_result.SampleLevel( s_accumulator, I.tc, 0 );
}
