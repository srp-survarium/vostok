#include "common.h"

Texture2D	t_accum_diffuse;
Texture2D	t_accum_specular;

struct v2p_quad
{
	float4	hpos	: SV_POSITION;
	float2	tc		: TEXCOORD0;
};

struct ps_output
{
	float4	diffuse		: SV_Target0;
	float4	specular	: SV_Target1;
};

ps_output main( v2p_quad I )
{
	ps_output	output;
	output.diffuse	= t_accum_diffuse.Sample( s_accumulator, I.tc);
	output.specular	= t_accum_specular.Sample( s_accumulator, I.tc);
	return	output;
}
