/*
	$DEFINES$:
		GLOBAL_USE_LOOP_UNROLLING,
*/

#include "common.h"

#define NUM_SAMPLES CONFIG_POST_PROCESS_BLUR_KERNEL

uniform float4 offsets_weights[NUM_SAMPLES];

float4 main( v2p_TL vin) : SV_TARGET
{
    float4 final_color = 0;
    
	[unroll] for(int i=0; i<NUM_SAMPLES; i++)
		final_color += t_base.SampleLevel(s_material1, vin.Tex0 + float2( 0.0f, offsets_weights[i].z ), 0) * offsets_weights[i].w;
    
	return final_color;
}
