float3	right_view_vector;

float	use_align_by_dir;
float3	view_location;

float	use_fixed_axis;
float3	rotation_fixed_axis;

float	locked_no_ratate_axis_index;

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float3	normal				: NORMAL;
	float4	color				: COLOR;
	float2	tc					: TEXCOORD1;
	float3  tangent				: TEXCOORD2;
	float3  binormal			: TEXCOORD3;
#if CONFIG_USE_SUBUV
	float4	tc1					: TEXCOORD4;
#endif // #if CONFIG_USE_SUBUV
};

#elif CONFIG_VERTEX_INPUT_TYPE == 9

// particle_beamtrail_vertex_input.h
struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float4	color				: TEXCOORD1;
	float2	tc					: TEXCOORD2;
};

#elif CONFIG_VERTEX_INPUT_TYPE == 1 || CONFIG_VERTEX_INPUT_TYPE == 2

// static_mesh_vertex_input.h
struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	tbn_x				: TEXCOORD0;
	float3	tbn_y				: TEXCOORD1;
	float3	tbn_z				: TEXCOORD2;
	float3	position			: TEXCOORD3;
	float3	view_position		: TEXCOORD4;
	float2	tc					: TEXCOORD5;
#if CONFIG_VERTEX_INPUT_TYPE == 2
	float3	color				: TEXCOORD6;
	float	occlusion			: TEXCOORD7;
#endif // #if CONFIG_VERTEX_INPUT_TYPE == 2
};

#elif CONFIG_VERTEX_INPUT_TYPE >= 3 && CONFIG_VERTEX_INPUT_TYPE <= 6

// skeleton_{4,3,2,1}_bones_mesh_vertex_input.h (one shared output)
struct vertex_output_struct
{
	float3	tbn_x				: TEXCOORD0;
	float3	tbn_y				: TEXCOORD1;
	float3	tbn_z				: TEXCOORD2;
	float4  homogeneous_position: SV_Position;
	float3	view_position		: TEXCOORD3;
	float3	position			: TEXCOORD4;
	float3	prev_position		: TEXCOORD5;
	float2	tc					: TEXCOORD6;
};

#elif CONFIG_VERTEX_INPUT_TYPE == 11

// grassmesh_vertex_input.h
float4 patch_parameters;

struct vertex_output_struct
{
	float3	tbn_x				: TEXCOORD0;
	float3	tbn_y				: TEXCOORD1;
	float3	tbn_z				: TEXCOORD2;
	float4	color				: TEXCOORD3;
	float4  homogeneous_position: SV_Position;
	float4	params				: TEXCOORD4;
	float3	view_position		: TEXCOORD5;
	float3	position			: TEXCOORD6;
	float2	tc					: TEXCOORD7;
};

#elif CONFIG_VERTEX_INPUT_TYPE == 13

// wires_vertex_input.h
struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float2	tc					: TEXCOORD1;
	float3	tbn_x				: TEXCOORD2;
	float3	tbn_y				: TEXCOORD3;
	float3	tbn_z				: TEXCOORD4;
};

#elif CONFIG_VERTEX_INPUT_TYPE == 14

// user_vertex_input.h
struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float2	tc					: TEXCOORD1;
};

#else // NULL_VERTEX_INPUT_TYPE (0), decal (10), postprocess (12)

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
};

#endif

////////////////////////////////////////////////////////////////////////////

float4 constant_diffuse;
float3 constant_normal_multiplier;

//#if CONFIG_DECAL_MATERIAL
	float4x4 world_to_decal;
//#endif // #if CONFIG_DECAL_MATERIAL

uniform float3 s_eye_ray_corner;

float4x4 decal_tangent_to_view_space_matrix;

Texture2D t_normal_map;

// values: -1.0f, 1.0f
float blend_with_geometry_normals;

float4 decal_angle_parameters;
static const float decal_alpha_angle = decal_angle_parameters.x;
static const float decal_clip_angle = decal_angle_parameters.y;

TextureCube t_cubemap;

float fresnel_multiplier;
float smoothness_interpolation;
float diffuse_alpha;

// Keep this decode local: it samples through s_anisotropic and uses max(...,0),
// while psf_normal.h uses s_normal and saturate.
float3 read_normal_map( Texture2D _t_normal, sampler _sampler, float2 tc)
{
	float3 normal;
	normal.xy	= _t_normal.Sample( _sampler, tc).wy * 2.f - 1.f;
	normal.z	= sqrt( max( 1.0f - dot(normal.xy, normal.xy), 0.0f));
	normal.y	= -normal.y;
	return normalize( normal);
}

void main(in vertex_output_struct input,
		  out float4 out_diffuse_target		: SV_Target0,
		  out float4 out_normals_target		: SV_Target1,
		  out float4 out_material_target	: SV_Target2
  )
{
	float2 screen_uv					= input.homogeneous_position.xy / screen_res.xy;

	float3 eye_ray;
	eye_ray.xy							= s_eye_ray_corner.xy * (1.0f - screen_uv.xy * 2.0f);
	eye_ray.z							= s_eye_ray_corner.z;

	float3 scene_position				= gbuffer_read_frame_depth(screen_uv)*float3(eye_ray.xy / eye_ray.z, 1.0f);

	float3 view_scene_normal			= gbuffer_read_frame_normal(screen_uv);
	view_scene_normal.z					= -view_scene_normal.z;

	float3 world_scene_normal_real		= mul(
		m_V2W,
		float4(view_scene_normal, 0.0f)
	).xyz;

	float3 world_scene_normal			= -decal_tangent_to_view_space_matrix[2].xyz;

	//	Spelt [branch], not BRANCH.  GLOBAL_USE_BRANCHING is not one of the 82
	//	registry defines, so it never reaches the compile and the macro is
	//	empty; the bare `if` is then flattened into a movc and the blob loses
	//	32 bytes against ship, which keeps if_nz/else/endif here.  Same reason
	//	UNROLL is spelt [unroll] wherever ship actually unrolls.
	[branch] if (blend_with_geometry_normals > 0.0f)
		world_scene_normal				= world_scene_normal_real;

	const float3 decal_tangent			= decal_tangent_to_view_space_matrix[0].xyz;
	const float3 decal_normal			= decal_tangent_to_view_space_matrix[2].xyz;
	const float3 binormal				= -cross(decal_tangent, world_scene_normal);
	const float3 tangent				= cross(binormal, world_scene_normal);

	float3x3 tangent_to_viewspace		= mul(
		(float3x3)m_V,
		transpose(
			float3x3(
				tangent,
				binormal,
				world_scene_normal
			)
		)
	);

	float3 world_scene_position			= mul(m_V2W, float4(scene_position, 1.0f)).xyz;
	float4 decal_projected_position 	= mul(world_to_decal, float4(world_scene_position, 1.0f));

	//	Clip if out of decal box.  It has to be clip(), not `if (...) discard;`:
	//	the two produce the same discard_nz, but the `if` form lets fxc treat
	//	the discard as an early-out and pull its whole dependency chain - the
	//	world transform and the projection - above the tangent basis, which
	//	then costs a fifth temporary.  Ship schedules the basis first.
	clip((decal_projected_position.x < -1.0f 	||
		decal_projected_position.y < -1.0f 	||
		decal_projected_position.x >  1.0f 	||
		decal_projected_position.y >  1.0f 	||
		decal_projected_position.z >= 1.0f 	||
		decal_projected_position.z <  0.5f) ? -1.0f : 1.0f);

	//	The clip-to-uv map is spelt with the bias inside the numerator - not as
	//	`.xy/.w*0.5f + 0.5f` - and that is not cosmetic: the stretch below
	//	normalises the same `float2(1,-1)*.xy/.w`, and the plain spelling lets
	//	fxc share one divide between the two.  Ship divides twice.
	float2 tc							=
		(float2(1.0f, -1.0f) * decal_projected_position.xy + decal_projected_position.w) * 0.5f / decal_projected_position.w;

	float scattered_alpha				= saturate(dot(world_scene_normal_real, -decal_normal) - decal_alpha_angle);
	scattered_alpha						*=dot(world_scene_normal_real, -decal_normal) > decal_clip_angle ? 1.0f : 0.0f;

	// The decal smears along its own projection as the receiving surface tips
	// away from the projector: a unit step in the projected direction, scaled
	// by the cube of how far past the box's half-depth the surface sits.
	float stretch						= saturate(decal_projected_position.z - 0.5f);
	stretch								= pow(stretch, 3.0f);

	tc									= saturate(
		normalize(float2(1.0f, -1.0f) * decal_projected_position.xy / decal_projected_position.w)*stretch + tc
	);

	float4 		diffuse_color			= t_base.Sample(s_linear, tc) * constant_diffuse;

	float3	 	normal;

	if (CONFIG_TNORMAL)
		normal 							= normalize(
			mul(
				tangent_to_viewspace,
				read_normal_map(t_normal_map, s_anisotropic, tc)*constant_normal_multiplier
			)
		);
	else
		normal							= normalize(mul(tangent_to_viewspace, float3(0.0f,0.0f,1.0f)) );

	out_diffuse_target 					= float4(
		convert_from_linear_space(diffuse_color.rgb),
		diffuse_color.a*diffuse_alpha
	);

	out_normals_target					= float4(scattered_alpha*normal*0.5f + 0.5f, scattered_alpha*diffuse_color.a);

	out_material_target					= float4(
		diffuse_color.a*saturate(1.0f - smoothness_interpolation*2.0f),
		diffuse_color.a*saturate(smoothness_interpolation*2.0f - 1.0f),
		1.0f,
		1.0f
	);
}
