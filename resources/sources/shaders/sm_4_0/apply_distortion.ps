#include "common.h"

Texture2D t_distortion;

// The shipped blob has no distortion mask and no dispersion arm: it reads the
// accumulated distortion once (through s_material1, not s_accumulator), adds
// it to the screen uv, and re-samples the scene. The `.z` channel the two
// distortion writers emit is never read back here.
// Input signature is the apply_distortion.vs output: SV_POSITION + TEXCOORD0,
// with no COLOR - so this is not v2p_TL.
struct	v2p_distortion
{
	float4 	HPos	: SV_POSITION;	// Clip-space position 	(for rasterization)
	float2 	Tex0	: TEXCOORD0;
};

float4 main( v2p_distortion vin) : SV_TARGET
{
	float2 screen_uv				= vin.Tex0;
	float4 packed_distortion 		= t_distortion.Sample(s_material1, screen_uv);

	float2 tc_offset 				= unpack_distortion(packed_distortion);

	return t_base.Sample(s_accumulator, tc_offset + screen_uv);
}
