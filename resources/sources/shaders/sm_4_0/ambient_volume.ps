/*	$DEFINES$:
		GLOBAL_SHADING_QUALITY,
		CONFIG_SHADOWED_LIGHT,
*/

// gbuffer.h
uniform float4		near_far_invn_invf;

// colored_light.h
uniform float3		light_color;
uniform float		light_intensity;

// light_ps_helper.h
uniform float		light_diffuse_influence_factor;
uniform float		light_specular_influence_factor;

// brdf.h
uniform int			lighting_model;

// spot_shadow.h
uniform float4x4	view_to_light_matrix;
uniform float		shadow_z_bias;
uniform float		shadow_transparency;
uniform float		shadow_map_size;

// point_light.h
uniform float		is_shadower;

// this shader's own
uniform float		ambient_volume_multiplier;

// light.h
struct pixel_shader_input {
	float4 	position			:	SV_POSITION;	// in homogenous clip space
	float4 	texture_coordinates	:	TEXCOORD0;
}; // struct pixel_shader_input

float4 main( pixel_shader_input input ) : SV_Target
{
	return	ambient_volume_multiplier;
}
