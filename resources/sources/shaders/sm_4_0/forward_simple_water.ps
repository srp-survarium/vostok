#include "psf_normal.h"
#include "gamma_correction.h"
#include "gbuffer.h"

float4x4	view_to_shadow;
float		rain_offset;
float4		packed_water_parameters_0;	// rgb - water fog colour, w - wave fog density
float		use_rain;

//	s_shmap comes from common_samplers.h, which ship declares it in.

Texture3D	t_puddle_rings;
Texture2D	t_rain_shadow_map;
TextureCube	t_reflection;
Texture2D	t_frame_color;
Texture2D	t_normal_map;
Texture2D	t_local_reflections_result;
Texture2D	t_local_reflections_result_params;
Texture2D	t_water_waves;

//	One tap of the wave normal map: the .yw pair, not psf_normal.h's .wy.
float2 sample_water_waves( float2 tc )
{
	return	t_normal_map.Sample( s_base, tc ).yw*2.f - 1.f;
}

//	One octave of puddle rings: the .wz pair, biased three levels up the chain.
float2 sample_puddle_rings( float3 tc )
{
	return	(t_puddle_rings.SampleBias( s_base, tc, -3.f ).wz - 0.5f)*0.5f;
}

float4 	main			(in vertex_output_struct input): SV_TARGET0
{
	material_parameters parameters = get_material_parameters(input);
	fill_material_parameters(parameters);

	float2 screen_tc		= input.homogeneous_position.xy*screen_res.zw;

	float4 wave_time		= scene_time*float4( 0.005f, 0.005f, -0.0025f, 0.00375f );
	float2 wave_tc			= parameters.world_position.xz*0.01f;

	float2 waves			=
		(
			sample_water_waves( wave_tc + wave_time.y )*0.333f +
			sample_water_waves( wave_tc - wave_time.xy )*0.333f +
			sample_water_waves( wave_tc - wave_time.zw )*0.333f
		)*0.2f;

	float3 normal			= normalize( mul( m_V2W, float4( mul( parameters.tangent_to_viewspace, float3( waves, 1.f ) ), 0.f ) ) );

	if ( use_rain > 0.5f )
	{
		float3 geometry_normal	= mul( parameters.tangent_to_viewspace, float3( 0.f, 0.f, 1.f ) );
		float4 shadow_position	= mul( view_to_shadow, float4( parameters.world_view_position.xyz + geometry_normal*0.015625f, 1.f ) );
		float3 shadow_tc		= shadow_position.xyz/shadow_position.w;
		float  rain_shadow		= t_rain_shadow_map.SampleCmpLevelZero( s_shmap, shadow_tc.xy, shadow_tc.z ).x;

		float3 rings_tc			= float3( parameters.world_position.xz*1.15f + rain_offset, scene_time*2.f );
		float2 rings			=
			sample_puddle_rings( rings_tc ) +
			sample_puddle_rings( float3( rings_tc.xy*2.f, rings_tc.z ) );

		float3 rain_normal		= float3( rings.x, 1.f, rings.y )*rain_shadow;

		normal					= normalize( normal + rain_normal*float3( 1.5f, 1.f, 1.5f ) );
	}

	float3 view_direction	= normalize( eye_position - parameters.world_position );
	float  view_dot_normal	= dot( view_direction, normal );
	float3 reflection		= reflect( view_direction, normal );

	float  pixel_depth		= parameters.world_view_position.z;
	float  frame_depth		= t_position.SampleLevel( s_position, screen_tc, 0 ).x;
	float  depth_fade		= saturate( (frame_depth - pixel_depth)*0.001f );

	float  fresnel			= saturate( pow( 1.f - view_dot_normal, 5.f )*0.98f + 0.02f );

	float3 cube_reflection	= t_reflection.Sample( s_rtlinear, -reflection ).rgb;

	float2 fade				= min( (1.f/rsqrt( depth_fade ))*float2( 40.f, 20.f ), 1.f );
	float  distortion		= dot( fade.xx, fade.xx );
	float  fog				= exp2( fade.y*packed_water_parameters_0.w*-15.f + 2.f );

	float2 refraction_tc	= saturate( input.homogeneous_position.xy*screen_res.zw + distortion*normal.xz/pixel_depth );
	float3 refraction_color	= t_frame_color.Sample( s_accumulator, refraction_tc ).rgb;

	float4 ray_length;

	[unroll]
	for ( int y = -1; y <= 0; ++y )
	{
		[unroll]
		for ( int x = -1; x <= 0; ++x )
			ray_length[(y + 1)*2 + x + 1] = t_local_reflections_result_params.Sample( s_base, screen_res.zw*float2( x*4.f, y*4.f ) + screen_tc ).w;
	}

	float2 screen_ddx		= ddx( screen_tc );
	float2 screen_ddy		= ddy( screen_tc );

	float3 reflection_direction	= normalize( reflection );

	float3 local_color		= 0.f;
	float  local_weight		= 0.f;

	[unroll]
	for ( int i = 0; i < 4; ++i )
	{
		float4 projected	= mul( m_VP, float4( parameters.world_position - ray_length[i]*reflection_direction, 1.f ) );
		float2 tc			= (projected.xy*float2( 1.f, -1.f ) + projected.w)*0.5f/projected.w;

		local_color			+= t_frame_color.SampleGrad( s_accumulator, tc, screen_ddx, screen_ddy ).rgb;

		[branch]
		if ( all( tc >= 0.f ) && all( tc <= 1.f ) )
		{
			float weight	= saturate( dot( reflection, view_direction ) );

			if ( tc.y <= 0.25f )
				weight		= saturate( tc.y*4.f )*weight;

			if ( tc.x <= 0.25f )
				weight		*= saturate( tc.x*4.f );

			if ( tc.x >= 0.25f )
				weight		*= saturate( (1.f - tc.x)*4.f );

			local_weight	= weight*2.f;
		}
	}

	float3 refraction		= lerp( packed_water_parameters_0.xyz, refraction_color, min( fog, 1.f ) );
	float3 reflection_color	= lerp( cube_reflection, local_color*0.25f, min( local_weight, 1.f ) );

	return	float4( lerp( refraction, lerp( refraction, reflection_color, max( 1.f - fog, 0.f ) ), fresnel ), 1.f );
}
