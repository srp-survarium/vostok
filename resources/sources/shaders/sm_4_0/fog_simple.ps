#include "common.h"
#include "gbuffer.h"

struct v2p_fog
{
	float4	hpos	: SV_POSITION;
	float2	tc		: TEXCOORD0;
};

float4 main( v2p_fog I ) : SV_TARGET
{
	float	depth	= t_position.SampleLevel( s_position, I.tc, 0).x;

	float	fog		= 1.0f - min( exp( -( depth - near_fog_distance)/far_fog_color_and_distance.w), 1.0f);

	return	float4( far_fog_color_and_distance.xyz, fog*fog_alpha);
}
