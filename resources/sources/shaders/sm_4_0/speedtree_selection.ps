#include "common.h"

uniform float4 selection_color;

struct v2p_speedtree_selection
{
	float4	hpos		: SV_Position;
	float3	position	: TEXCOORD0;
};

float4 main( v2p_speedtree_selection I ) : SV_TARGET
{
	return	float4( selection_color.xyz, 0.3f);
}
