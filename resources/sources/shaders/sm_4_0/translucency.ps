#include "common.h"
#include "gbuffer.h"

float4x4	m_shadow0;
float4x4	m_shadow1;
float4x4	m_shadow2;
float4x4	m_shadow3;
float3		s_eye_ray_corner;

Texture2D	t_sun_translucensy_help_data;

bool inside_cascade( float3 tc )
{
	return	tc.x >= -0.01f && tc.x <= 1.01f && tc.y >= -0.01f && tc.y <= 1.01f && tc.z >= -0.01f && tc.z <= 1.01f;
}

float3 project_shadow( float4x4 shadow_matrix, float4 position )
{
	float4 tc		= mul( shadow_matrix, position );
	return			tc.xyz/tc.w;
}

struct v2p_translucency
{
	float4	hpos	: SV_POSITION;
	float2	tc		: TEXCOORD0;
};

float4 main( v2p_translucency I ) : SV_Target
{
	float3	eye_ray;
	eye_ray.xy				= s_eye_ray_corner.xy*( 1 - I.tc*2 )/s_eye_ray_corner.z;
	eye_ray.z				= 1;

	float4	position		= float4( gbuffer_read_frame_depth( I.tc )*eye_ray, 1.f );

	float3	t0				= project_shadow( m_shadow0, position );
	float3	t1				= project_shadow( m_shadow1, position );
	float3	t2				= project_shadow( m_shadow2, position );
	float3	t3				= project_shadow( m_shadow3, position );

	bool	inside0			= inside_cascade( t0 );
	bool	inside1			= inside_cascade( t1 );
	bool	inside2			= inside_cascade( t2 );
	bool	inside3			= t3.x >= -0.01f && t3.x <= 1.01f && t3.y >= -0.01f && t3.y <= 1.01f;

	int		outside0		= inside0 ? 0 : 1;
	int		outside1		= inside1 ? 0 : 1;
	int		outside2		= inside2 ? 0 : 1;

	float	shadow_depth	=
		inside0*t0.z +
		inside1*outside0*t1.z +
		inside2*outside0*outside1*t2.z +
		inside3*outside0*outside1*outside2*t3.z;

	float	depth_delta		= shadow_depth - t_sun_translucensy_help_data.SampleLevel( s_accumulator, I.tc, 0 ).y;

	float4	packed			= t_normal.SampleLevel( s_accumulator, I.tc, 0 );
	uint	low				= ((uint)(packed.z*1023.f)) >> 7;
	uint	high			= ((uint)(packed.w*3.f)) << 3;
	float	translucency	= pow( min( float( low | high )*(1.f/31.f), 1.f ), 2.2f );

	uint	translucent		= ((uint)(t_diffuse.SampleLevel( s_diffuse, I.tc, 0 ).w*255.f)) >> 7;
	translucency			= translucent ? translucency : 0.f;

	float	attenuation		= pow( 1.f - saturate( depth_delta/(translucency*0.035f) ), 10.f );

	float3	normal			= gbuffer_read_frame_normal( I.tc );
	normal.z				= -normal.z;

	float	back_light		= dot( normal, sun_direction );

	float3	result			= translucency*0.1f
							+ ((sun_color*back_light)*attenuation)*translucency*1.5f
							+ (translucency*back_light*0.1f)*sun_color;

	float3	view_direction	= normalize( position.xyz );
	float	forward			= saturate( dot( -view_direction, sun_direction ) );

	result					+= (sun_color*(forward*(forward*forward)))*(translucency*attenuation*2.f);

	return					1.f/rsqrt( saturate( float4( result, 0.f )*0.125f ) );
}
