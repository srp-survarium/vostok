/*
	$DEFINES$:
		GLOBAL_USE_LOOP_UNROLLING,
*/

#include "common.h"
#include "gbuffer.h"

Texture2D t_wireframe_buffer;

//	The shipped ISGN is two elements - SV_POSITION and TEXCOORD0 - so this pass
//	does not take the shared v2p_post_process (which carries an eye_ray at
//	TEXCOORD1 and spells the system value SV_Position; post_process0.vs proves
//	that shape byte-for-byte). fxc never trims unused interpolants, so the
//	missing TEXCOORD1 is proof of a local struct, not of dead-code removal.
struct v2p_apply_wireframe
{
	float4	homogeneous_position	: SV_POSITION;
	float2	uv						: TEXCOORD0;
};


float4 main(v2p_apply_wireframe input) : SV_TARGET
{
	float2 uv = input.uv;
	float4 wireframe_color_and_depth = t_wireframe_buffer.Sample(s_position, uv);
	
	float frame_depth = gbuffer_read_frame_depth(uv);

	static const int num_offsets = 8;
	static const float2 offsets[num_offsets] = 
	{
		float2( 1.0f,  1.0f),
		float2( 1.0f,  0.0f),
		float2( 1.0f, -1.0f),
		float2( 0.0f,  1.0f),
		float2( 0.0f, -1.0f), 
		float2(-1.0f,  1.0f),
		float2(-1.0f,  0.0f),
		float2(-1.0f, -1.0f)
	};
	
	float depth_difference  = 1.0f;
	float depth_alpha 		= frame_depth / 500.0f;
	
	if (frame_depth!=0.0f)
	{
		UNROLL
		for (int i=0; i<num_offsets; i++)
		{
			float sample_depth = gbuffer_read_frame_depth(uv + offsets[i] * screen_res.zw);

			if (sample_depth!=0.0f)
			{
				depth_difference -= 5.5f * (frame_depth - sample_depth);// * abs(1.0f - 5*depth_alpha);
			}
		}
	}
	return saturate(depth_difference) * float4(wireframe_color_and_depth.rgb, frame_depth);
}













