#if GLOBAL_POST_PROCESS_QUALITY != 0
	// hardcoded vignette effect
	if ( image_grain_parameters.w > 0.1h )
	{
		half 	atten		=	saturate( 1.0h * pow( saturate( 1.0h - ( length( abs( uv * 2.0h - 1.0h ) ) ) / 1.4h ), image_grain_parameters.w ) );
		
		half2 	in_tex 		= 	uv - 0.5h;
		half 	vignette  	= 	1.0h - dot( in_tex, in_tex );
		half 	radius 		= 	1.0h + image_grain_parameters.w;
		half 	darkness 	= 	0.0h;
		half 	s 			=  saturate( pow( vignette, radius ) + darkness );

		frame_color			=	s * frame_color;
	}
