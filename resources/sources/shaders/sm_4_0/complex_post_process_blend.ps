	return 1.000001h * saturate((gbuffer_read_roughness(uv) - 1.0h - 0.0h) / 300.0h + 0.0h) * 2.00001h * up_attenuation * fresnel * blurred_color;
}
*/

half4 main( v2p_TL vin) : SV_TARGET
{
	half2 uv							= 	vin.Tex0;
	
	half3 bloom_color					= 	max(t_blurred_frame_bloom_only_color2.Sample(s_linear, uv).rgb, 0);

	half frame_depth 					= 	gbuffer_read_frame_depth(uv);
	
	half3 frame_color 					= 	0;
	frame_color							=	IN_HDR_COLOR(t_frame_color.SampleLevel(s_material1, uv, 0));

	half3 dof_c							=	0;
	half inv_blurriness					=	0;
	
#if GLOBAL_POST_PROCESS_QUALITY != 0	
#if !CONFIG_USE_BOKEH_DOF
	inv_blurriness 						= 	saturate(1.0h - get_blurriness(frame_depth));
	half4 frame_color_and_depth 		= 	half4(frame_color, frame_depth);
	half4 blurred_color_and_depth  		= 	t_blurred_frame_color.Sample(s_linear, uv);
	//blurred_color_and_depth.rgb     	*= 	dof_height_lights.rgb;
	dof_c								=	frame_color_and_depth.rgb * inv_blurriness + 
											(1.0h - inv_blurriness) * blurred_color_and_depth.rgb / saturate(inv_blurriness + blurred_color_and_depth.a);
	dof_c								=	blurred_color_and_depth.rgb;// * (1.0h - inv_blurriness);
	
#	if USE_RADIANCE_DOF
	half radiance_alpha					= saturate( pow( 2.0h * length( abs( uv - 0.5h ) ), 1.0h ) );
	half falloff						= (1.0h - radiance_alpha) * pow(t_sphere_falloff.Sample(s_linear, uv), 2.0h);
	
	half3 blurred_color					= frame_color_and_depth.rgb * inv_blurriness + blurred_color_and_depth.rgb / saturate(inv_blurriness + blurred_color_and_depth.a);
	frame_color 						= lerp(frame_color, blurred_color, falloff);
#	else // #if USE_RADIANCE_DOF

	frame_color 						= (frame_color_and_depth.rgb * inv_blurriness + blurred_color_and_depth.rgb) / (inv_blurriness + blurred_color_and_depth.a);
	frame_color 						= lerp(frame_color, frame_color_and_depth.rgb, inv_blurriness);
	//frame_color 						+= blurred_color_and_depth.rgb * saturate(1.0h - blurred_color_and_depth.a);
	
	//half3 bloom_color					= max(t_blurred_frame_bloom_only_color.Sample(s_linear, uv).rgb, 0);
	
#	endif // #if USE_RADIANCE_DOF

#else // #if !CONFIG_USE_BOKEH_DOF
	static const int radius 			= min(bokeh_dof_radius, 24.0h);
	half  current_radius 				= saturate(get_blurriness(frame_depth)) * radius + 0.5h;
	half3 avg_blurred_color 			= half3(0.0h, 0.0h, 0.0h);
	half  total_attenuation			= 0.0h;
	
	LOOP for(int y = -radius; y <= radius; y++)
	{
		LOOP for(int x = -radius; x <= radius; x++)
		{
			half image_template		= 1.0h;
			
#if CONFIG_USE_BOKEH_IMAGE		
			image_template				= t_bokeh_image.Sample(s_linear, 0.5h * half2(x, y) / radius + 0.5h).r;
#endif // CONFIG_USE_BOKEH_IMAGE
			
			half2 sample_uv 			= uv + bokeh_dof_density * half2(x, y) * screen_res.zw;
			
			half3 sample_frame_color	= IN_HDR_COLOR(t_frame_color.SampleLevel(s_material1, sample_uv, 0).rgb);
			half  sample_depth			= gbuffer_read_frame_depth(sample_uv);
			half  sample_radius 		= saturate(get_blurriness(sample_depth)) * radius + 0.5h;
			
			sample_radius 				= lerp(
				sample_radius, 
				current_radius, 
				sample_depth > frame_depth && current_radius < sample_radius
				);
			
			half to_current_center 	= length( half2(x, y) );
			half attenuation 			= image_template * saturate( sample_radius - to_current_center ) / pow(sample_radius, 2);
			
			total_attenuation			+= attenuation;
			avg_blurred_color 			+= attenuation * sample_frame_color.rgb;
		}
	}
	
	frame_color							= avg_blurred_color.rgb / total_attenuation;
	
	//half inv_blurriness 				= saturate(1.0h - get_blurriness(frame_depth));
	//half4 blurred_color_and_depth  	= t_blurred_frame_color.Sample(s_base, uv);
	//frame_color 						= frame_color * inv_blurriness + blurred_color_and_depth.rgb / saturate(inv_blurriness + blurred_color_and_depth.a);
	
#endif // #if !CONFIG_USE_BOKEH_DOF
#endif // #if GLOBAL_POST_PROCESS_QUALITY != 0

	frame_color							+= bloom_color;
	
	//return half4						(get_luminance(frame_color)>0.2h, 0, 0, 1);
	
	
	//frame_color							= 1.000001h * frame_color + 0.00001h * (5.0h * pow(frame_color, 0.5h) + 1.25h) * 3.000001h * get_image_space_lighting(uv);
	
#if GLOBAL_POST_PROCESS_QUALITY != 0
	frame_color							= desaturate_low_diapason(t_lighting_buffer, uv, frame_color);

#if GLOBAL_USE_GOD_RAYS	
	frame_color							+=	UNPACK_LIGHTING_COLOR( t_light_scattering_result.Sample(s_linear, uv).rgb );
#endif // #if GLOBAL_USE_GOD_RAYS

#endif // #if GLOBAL_POST_PROCESS_QUALITY != 0

	frame_color							+=	t_lens_flares.SampleLevel( s_linear, uv, 0 ).rgb;

	// tone mapping
	frame_color							= tone_mapped_color( frame_color );

	
	
#if GLOBAL_POST_PROCESS_QUALITY != 0
	
#if CONFIG_USE_IMAGE_GRAIN
	frame_color							= grained_color( frame_color, uv );
#endif // #if CONFIG_USE_IMAGE_GRAIN

	// color grading
	frame_color							= graded_color( frame_color );
#else // #if GLOBAL_POST_PROCESS_QUALITY != 0

	//frame_color							= convert_from_linear_space( frame_color, gamma_correction_factor );

#endif // #if GLOBAL_POST_PROCESS_QUALITY != 0	

	
	//if (uv.x <= 0.5h && uv.y <= 0.5h)
	//{
	//	frame_color							*=0.0001h;
	//	frame_color							+= t_skin_scattering_blurred_4.Sample(s_base, uv * 2.0h).rgb;
	//	//frame_color							+= t_skin_scattering.Sample(s_accumulator, uv * 3.0h).rgb;
	//}
	
	// gamma correction: conversion from linear space to pc gamma space
	// in other shader (mlaa or copy_image)
