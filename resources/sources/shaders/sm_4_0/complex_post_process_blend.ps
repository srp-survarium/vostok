float4 	filmic_tonemap_packed_parameters_0;
float4 	filmic_tonemap_packed_parameters_1;

static const float shoulder_strength	= filmic_tonemap_packed_parameters_0.x;//0.22h;
static const float linear_strength		= filmic_tonemap_packed_parameters_0.y;//0.30f;
static const float linear_angle			= filmic_tonemap_packed_parameters_0.z;//0.10f;
static const float toe_strength			= filmic_tonemap_packed_parameters_0.w;//0.20f;
static const float toe_numerator		= filmic_tonemap_packed_parameters_1.x;//0.01h;
static const float toe_denominator		= filmic_tonemap_packed_parameters_1.y;//0.30f;
static const float liner_white			= filmic_tonemap_packed_parameters_1.z;//11.2h;

static const float frame_dark_desaturation_limit			= filmic_tonemap_packed_parameters_1.w;

// Function used by the Uncharted 2D tone mapping curve
half3 filmic_func(half3 x)
{
    const half A = shoulder_strength;
    const half B = linear_strength;
    const half C = linear_angle;
    const half D = toe_strength;
    const half E = toe_numerator;
    const half F = toe_denominator;
	
    return ((x*(A*x+C*B)+D*E)/(x*(A*x+B)+D*F)) - E/F;
}

half3 tone_mapped_filmic_alu( half3 frame_color )
{


	const half A = shoulder_strength*0.01;
    const half B = linear_strength;
    const half C = linear_angle;
    const half D = toe_strength;
    const half E = toe_numerator;
    const half F = toe_denominator;


	//frame_color = max(0, frame_color - 0.0015h);
    //frame_color = (frame_color * (6.2h * frame_color + 0.2h)) / (frame_color * (5.9h * frame_color + 1.5h)+ 0.04h);
	
	frame_color = max(0, frame_color - A);
    frame_color = (frame_color * (B * frame_color + C)) / (frame_color * (D * frame_color + E)+ F);
	
    // result has 1/2.2 baked in
    return pow(frame_color, 2.2h);
}

half tone_mapped_filmic_alu2( half U )
{
	const half A = shoulder_strength*0.01;
    const half B = linear_strength;
    const half C = linear_angle;
    const half D = toe_strength;
    const half E = toe_numerator;
    const half F = toe_denominator;

	U = max(0, U - A);
    U = (U * (B * U + C)) / (U * (D * U + E)+ F);
	U = U;
    // result has 1/2.2 baked in
    return pow(U, 1.0h);
}

half3 tone_mapped_filmic_u2( half3 frame_color )
{
	return filmic_func( frame_color ) / filmic_func( liner_white );
}

// Exponential mapping
half3 tone_mapped_exponential( half3 frame_color )
{
	const half white_level				= 5.0h;
	const half luminance_saturation	= 1.0h;
	const half pixel_luminance 		= get_luminance( frame_color );    
    const half tone_mapped_luminance 	= 1.0h - exp(-pixel_luminance / white_level);
	
	return tone_mapped_luminance * pow(frame_color / pixel_luminance, luminance_saturation);
}

// Determines the color based on exposure settings.
half3 calc_exposed_color(half3 color, half avg_luminance, half threshold, out half exposure)
{    
    exposure 				= 0.0h;
	avg_luminance 			= max(avg_luminance, 0.001h);
	
#if 1
	half key_value 		= 0.25h;
#else // #if 0
	half key_value 		= 1.03h - (2.0h / (2.0h + log10(avg_luminance + 1.0h)));
#endif // #if 0
	
	half linearExposure 	= (key_value / avg_luminance);
	exposure 				= 0.2*log2(max(linearExposure, 0.0001h));
    exposure 				-= threshold;
	
    return exp2(exposure) * color;
}

half3 tone_mapped_color			( half3 frame_color )
{
#if 0
	return tone_mapped_reinhard_modified( frame_color );
#else
	half 		exposure				= 1.0h;
	const half pixel_luminance 			= get_luminance(frame_color);
	const half average_frame_luminance  = clamp( get_average_frame_luminance(), 0.09h, 0.4h );
	const half threshold				= 0.0h;
	
	frame_color	= calc_exposed_color	( frame_color, average_frame_luminance, threshold, exposure);
	
#	if 0
		return tone_mapped_filmic_u2( frame_color );
		//return tone_mapped_exponential( frame_color );
#	else
		return tone_mapped_filmic_alu( frame_color );
#	endif // #if 0
	
#endif // #if 0
}

half3 graded_color					( half3 frame_color )
{
#define USE_COLOR_GRADING_LUT 		1

#if USE_COLOR_GRADING_LUT
	frame_color						=
		convert_to_linear_space(
			color_lookup_table(
				convert_from_linear_space(
					frame_color,
					1.0h + 0*gamma_correction_factor
				)
			)
		);
#else // #if USE_COLOR_GRADING_LUT
	// TODO: do convert_to_linear_space(frame_fade.rgb) and convert_to_linear_space(frame_shadows) in c++
	frame_color 					= pow( ABS_TO_REMOVE_WARNING(max(frame_color - convert_to_linear_space(frame_shadows), 0.0h) * frame_height_lights_and_desaturation.xyz), frame_mid_tones);
	frame_color 					= lerp(frame_color, get_luminance(frame_color), frame_height_lights_and_desaturation.a);
	//frame_color 				 	= lerp(frame_color, convert_to_linear_space(frame_fade.rgb), frame_fade.a);
#endif // #if USE_COLOR_GRADING_LUT
	
	return							frame_color;
}

#define USE_RADIANCE_DOF 0

bool in_rect(half2 p, half left, half top, half right, half buttom, inout half2 in_rect_p)
{
	bool res 				=	p.x > left && p.x < right && p.y > top && p.y < buttom;
	
	if (res)
	{
		const half size_x 		= 	right - left;
		const half size_y 		= 	buttom - top;
		in_rect_p 				= 	half2(p.x - left, p.y - top) / half2(size_x, size_y);		
	}
	
	return res;
}

half3 desaturate_low_diapason(in Texture2D in_lighting_buffer, half2 uv, half3 frame_color)
{
	half des 					= 	0.0h;
	half lum					=	dot(half3(0.3h, 0.7h, 0.2h), frame_color);//IN_HDR_COLOR(in_lighting_buffer.SampleLevel(s_accumulator, uv, 0).xyz));
	
	const half alpha			=	pow(1.0h - saturate(lum / frame_dark_desaturation_limit), 2.0h);
	
	if (lum < frame_dark_desaturation_limit)
	{
		return 	desaturate(frame_color, alpha);
	}
	
	return 	frame_color;
}

half3 pseudo_random_texture ( half2 uv )
{
	return pow(t_grain_noise.SampleLevel( s_nofilter, screen_res.xy * uv / 64.0h, 0 ).rgb, 1.0h);
}

half3 	grained_color( half3 in_frame_color, half2 uv )
{
	const half image_grain_scale 	= 	image_grain_parameters.z;
	
	half3 grain_amount 			= 	pow(in_frame_color, 0.6) * image_grain_scale;
	
	// 1/256 to fight 8 bit quantization artifacts, image grain itself should only affect the darks
	in_frame_color 					= 	saturate(
		in_frame_color + 
		(pseudo_random_texture(uv + image_grain_parameters.xy * 2 - 1) - 0.0h) * (grain_amount + 0.0h / 256.0h)
	);
	
	return in_frame_color;
}
