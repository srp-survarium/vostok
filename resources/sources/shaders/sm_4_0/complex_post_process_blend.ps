half3 color_lookup_table(half3 color)
{
	return t_color_grading_lut.SampleLevel(s_material1, color.rgb * 15.0h / 16.0h + 0.5h / 16.0h, 0).rgb;
}

// TODO: remove texture reading, one constants
#define USE_LUMINANCE_FROM_HISTOGRAM	0

half get_min_frame_luminance		( )
{
#if USE_LUMINANCE_FROM_HISTOGRAM
	return							frame_luminance_parameter.y;
#else // #if USE_LUMINANCE_FROM_HISTOGRAM
	half sum_of_logarithms			= t_frame_luminance.Sample(s_accumulator, half2(0.5h, 0.5h)).g;
	return							sum_of_logarithms;
#endif // #if USE_LUMINANCE_FROM_HISTOGRAM
}

half get_max_frame_luminance		( )
{
#if USE_LUMINANCE_FROM_HISTOGRAM
	half sum_of_logarithms			= frame_luminance_parameter.z;
#else // #if USE_LUMINANCE_FROM_HISTOGRAM
	half sum_of_logarithms			= t_frame_luminance.Sample(s_accumulator, half2(0.5h, 0.5h)).b;
#endif // #if USE_LUMINANCE_FROM_HISTOGRAM
	return							max( sum_of_logarithms, 1.0h );
}

half get_average_frame_luminance	( )
{
	half sum_of_logarithms			= t_frame_luminance.Sample(s_accumulator, half2(0.5h, 0.5h)).r;
#if USE_LUMINANCE_FROM_HISTOGRAM
	return							frame_luminance_parameter.x;//clamp( frame_luminance_parameter.x, 0.1h, 1.0h );
#else // #if USE_LUMINANCE_FROM_HISTOGRAM
	return							sum_of_logarithms;//clamp( sum_of_logarithms, 0.1h, 4.0h );
#endif // #if USE_LUMINANCE_FROM_HISTOGRAM
}

half get_frame_middle_gray_luminance( )
{
#if USE_LUMINANCE_FROM_HISTOGRAM
	return							frame_luminance_parameter.w;
#else // #if USE_LUMINANCE_FROM_HISTOGRAM
	return							0.5h;
#endif // #if USE_LUMINANCE_FROM_HISTOGRAM
}

half3 tone_mapped_reinhard_modified( half3 frame_color )
{
	// tone mapping
	half min_frame_luminance		= get_min_frame_luminance( );
	half max_frame_luminance		= get_max_frame_luminance( );
	half average_frame_luminance	= get_average_frame_luminance( );
	half luminance					= max( get_luminance( frame_color ), min_frame_luminance );
	half middle_gray				= get_frame_middle_gray_luminance();
	half scaled_luminance			= middle_gray * max( luminance - min_frame_luminance, 0.f ) / average_frame_luminance;
	half tone_mapper				= scaled_luminance*(1.f + scaled_luminance/( square(max_frame_luminance)) ) / (1.f + scaled_luminance);
	
	//half4 log_luv_pixel_color		= log_luv_encode( frame_color/luminance );
	//log_luv_set_lightness			( log_luv_pixel_color, tone_mapper );
	//frame_color						= log_luv_decode( log_luv_pixel_color );
	frame_color						*= tone_mapper/luminance;
	
	return 							saturate( frame_color );
}


