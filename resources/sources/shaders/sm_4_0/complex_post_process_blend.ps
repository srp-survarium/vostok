////////////////////////////////////////////////////////////////////////////
//	Reconstruction note (2026-08-17): rewritten from the 12 shipped blobs'
//	disassembly. The tree revision this replaces was an older generation of
//	the same shader: it ended on `GLOBAL_TEST_FLOAT * frame_color`, a define
//	no shipped permutation sets (the file could not be compiled at all), and
//	it knew nothing of GLOBAL_POST_PROCESS_QUALITY, CONFIG_USE_IMAGE_GRAIN or
//	GLOBAL_USE_GOD_RAYS, which the shipped permutation strings do name. What
//	ship does instead, read off the blobs:
//
//	* the Reinhard tone mapper is gone; ship runs a filmic ALU curve whose
//	  five coefficients are packed into filmic_tonemap_packed_parameters_0/1
//	  and whose exposure is pow(0.25f/clamp(avg_luminance,0.09f,0.4f),0.2f);
//	* the frame is bloom + scene + lens flares, with the DOF blend, the
//	  low-luminance desaturation, the grain, the colour-grading LUT and the
//	  vignette all gated on GLOBAL_POST_PROCESS_QUALITY - at quality 0 the
//	  shader neither reads the depth buffer nor grades, and all six of its
//	  permutations compile to the same 26-instruction blob;
//	* the DOF blend divides the *whole* weighted sum, and dof_height_lights
//	  no longer tints the blurred sample (it is [unused] in every blob);
//	* GLOBAL_USE_GOD_RAYS is 0 in all twelve shipped permutations, so the
//	  scattered_color path the old revision carried is unconstrained by any
//	  blob and is not reproduced here; god_rays_parameters0/1 are declared
//	  because $Globals lists them at offsets 208 and 224.
//
//	The $Globals order is load-bearing and matches the shipped RDEF exactly:
//	near_far_invn_invf(0) from gbuffer.h, the three dof_functions.h uniforms
//	(16/32/48), light_ps_helper.h's four (64/76/80/84), then this file's own
//	from 96 on. Include order follows the blob dependency table: common.h,
//	gbuffer.h, gamma_correction.h, dof_functions.h, light_ps_helper.h,
//	log_luv_color_space.h, luminance.h, debug.h.
//
//	HEADER FINDING - dof_functions.h has drifted, and this file cannot reach
//	byte-identity on its six GLOBAL_POST_PROCESS_QUALITY=3 permutations until
//	it is corrected. get_blurriness currently reads
//
//		min( (in_depth-focus_distance) >= 0.0f ? blur_amount_far : blur_amount_near,
//		     pow( saturate(abs(in_depth-focus_distance) / focus_region), focus_power ) )
//
//	and ship needs
//
//		min( (in_depth-focus_distance) < 0.0f ? blur_amount_near : blur_amount_far,
//		     saturate(abs(in_depth-focus_distance) / focus_region) )
//
//	- no pow, and the ternary written on `<` so fxc emits `lt`+`movc x,y`
//	rather than `ge`+`movc y,x`. Two shipped names prove it independently:
//	this one's perm
//	_3_________0________________________00________________0___________________________
//	("add r0.x, r0.x, -cb0[2].x / lt r0.y, r0.x, l(0) / div_sat r0.x, |r0.x|,
//	cb0[2].y / movc r0.y, r0.y, cb0[3].x, cb0[3].y / min r0.x, r0.x, r0.y" -
//	focus_power is never read), and gather_bloom.ps, whose only shipped blob
//	spells the same five instructions. With that one header edit all twelve
//	permutations here compile byte-identically; without it, six do.

/*$DEFINES$:
	GLOBAL_POST_PROCESS_QUALITY,
	GLOBAL_USE_GOD_RAYS,
	CONFIG_USE_BOKEH_DOF,
	CONFIG_USE_BOKEH_IMAGE,
	CONFIG_USE_IMAGE_GRAIN,
*/


#include "common.h"
#include "gbuffer.h"
#include "gamma_correction.h"
#include "dof_functions.h"
#include "light_ps_helper.h"
#include "log_luv_color_space.h"
#include "luminance.h"
#include "debug.h"

float4		frame_height_lights_and_desaturation;
float3		frame_mid_tones;
float3		frame_shadows;
float4  	frame_fade;
float		gamma_correction_factor;


Texture2D 	t_grain_noise;
Texture2D 	t_blurred_frame_color;
Texture2D 	t_blurred_frame_bloom_only_color2;
Texture2D 	t_frame_color;
Texture2D 	t_frame_luminance;
Texture2D 	t_frame_luminance_previous;
Texture2D 	t_frame_luminance_histogram;

Texture2D 	t_light_scattering;
Texture2D 	t_sphere_falloff;
Texture2D 	t_bokeh_image;
Texture2D 	t_lens_flares;

Texture3D	t_color_grading_lut;


Texture2D 	t_lpv_rsm_albedo;


float4 		bokeh_dof_parameters;
static const float bokeh_dof_radius  = bokeh_dof_parameters.x;
static const float bokeh_dof_density = bokeh_dof_parameters.y;

float3 sun_direction_parameter;
static const float3 sun_position 	= -sun_direction_parameter * 500.0f;

float4 god_rays_parameters0;
float4 god_rays_parameters1;

// x - average frame luminance
// y - min frame luminance
// z - max frame luminance
// w - middle gray
float4 frame_luminance_parameter;

// xy - noise scroll, z - amount, w - vignette power
float4 image_grain_parameters;

// 0: x - black point (x0.01), y - shoulder A, z - shoulder C, w - toe A
// 1: x - toe B, y - toe C, w - desaturation luminance threshold
float4 filmic_tonemap_packed_parameters_0;
float4 filmic_tonemap_packed_parameters_1;

float3 color_lookup_table(float3 color)
{
	return t_color_grading_lut.SampleLevel(s_material1, color.rgb * 15.0f / 16.0f + 0.5f / 16.0f, 0).rgb;
}

float get_frame_exposure( )
{
	float average_frame_luminance	= t_frame_luminance.Sample(s_accumulator, float2(0.5f, 0.5f)).r;
	return							pow( 0.25f / clamp( average_frame_luminance, 0.09f, 0.4f ), 0.2f );
}

float3 tone_mapped_color( float3 frame_color )
{
	float3 color					= max( get_frame_exposure( ) * frame_color - filmic_tonemap_packed_parameters_0.x * 0.01f, 0.0f );

	return							(color * (filmic_tonemap_packed_parameters_0.y * color + filmic_tonemap_packed_parameters_0.z)) /
									(color * (filmic_tonemap_packed_parameters_0.w * color + filmic_tonemap_packed_parameters_1.x) + filmic_tonemap_packed_parameters_1.y);
}

float3 desaturated_color( float3 frame_color )
{
	float luminance					= dot( float3(0.3f, 0.7f, 0.2f), frame_color );
	float desaturation				= 1.0f - saturate( luminance / filmic_tonemap_packed_parameters_1.w );
	float amount					= desaturation * desaturation;
	float gray						= get_luminance( frame_color );
	float3 desaturated				= lerp( frame_color, gray, amount );

	return							luminance >= filmic_tonemap_packed_parameters_1.w ? frame_color : desaturated;
}

float3 grained_color( float3 frame_color, float2 uv )
{
	float3 linear_color				= pow( frame_color, gamma_value );
	float3 grain_amount				= pow( frame_color, 1.32f ) * image_grain_parameters.z;
	float2 grain_uv					= (image_grain_parameters.xy * 2.0f + uv - 1.0f) * screen_res.xy / 64.0f;

	return							convert_from_linear_space( saturate( t_grain_noise.SampleLevel( s_nofilter, grain_uv, 0).rgb * grain_amount + linear_color ) );
}

float3 vignetted_color( float3 frame_color, float2 uv )
{
	if ( image_grain_parameters.w > 0.1f )
	{
		float2 to_center			= uv - 0.5f;
		frame_color					= pow( 1.0f - dot( to_center, to_center ), image_grain_parameters.w + 1.0f ) * frame_color;
	}

	return							frame_color;
}

float4 main( v2p_TL vin) : SV_TARGET
{
	float2 uv							= vin.Tex0;

#if GLOBAL_POST_PROCESS_QUALITY
	float3 bloom_color					= max(t_blurred_frame_bloom_only_color2.Sample(s_linear, uv).rgb, 0.0f);

	float frame_depth 					= gbuffer_read_frame_depth(uv);
	float3 frame_color 					= t_frame_color.SampleLevel(s_material1, uv, 0).rgb;

#	if !CONFIG_USE_BOKEH_DOF
	float inv_blurriness 				= saturate(1.0f - get_blurriness(frame_depth));
	float4 blurred_color_and_depth  	= t_blurred_frame_color.Sample(s_linear, uv);

	float3 blurred_color				= (frame_color * inv_blurriness + blurred_color_and_depth.rgb) / (inv_blurriness + blurred_color_and_depth.a);
	frame_color 						= lerp(blurred_color, frame_color, inv_blurriness);
	frame_color							+= bloom_color;

#	else // #if !CONFIG_USE_BOKEH_DOF
	static const int radius 			= min(bokeh_dof_radius, 24.0f);
	float  current_radius 				= saturate(get_blurriness(frame_depth)) * radius + 0.5f;
	float3 avg_blurred_color 			= float3(0.0f, 0.0f, 0.0f);
	float  total_attenuation			= 0.0f;

	LOOP for(int y = -radius; y <= radius; y++)
	{
		LOOP for(int x = -radius; x <= radius; x++)
		{
			float image_template		= 1.0f;

#if CONFIG_USE_BOKEH_IMAGE
			image_template				= t_bokeh_image.Sample(s_linear, 0.5f * float2(x, y) / radius + 0.5f).r;
#endif // CONFIG_USE_BOKEH_IMAGE

			float2 sample_uv 			= uv + bokeh_dof_density * float2(x, y) * screen_res.zw;

			float3 sample_frame_color	= t_frame_color.SampleLevel(s_material1, sample_uv, 0).rgb;
			float  sample_depth			= gbuffer_read_frame_depth(sample_uv);
			float  sample_radius 		= saturate(get_blurriness(sample_depth)) * radius + 0.5f;

			sample_radius 				= lerp(
				sample_radius,
				current_radius,
				sample_depth > frame_depth && current_radius < sample_radius
				);

			float to_current_center 	= length( float2(x, y) );
			float attenuation 			= image_template * saturate( sample_radius - to_current_center ) / pow(sample_radius, 2);

			total_attenuation			+= attenuation;
			avg_blurred_color 			+= attenuation * sample_frame_color.rgb;
		}
	}

	frame_color							= avg_blurred_color.rgb / total_attenuation;
	frame_color							+= bloom_color;

#	endif // #if !CONFIG_USE_BOKEH_DOF

	frame_color							= desaturated_color( frame_color );
#else // #if GLOBAL_POST_PROCESS_QUALITY
	float3 frame_color 					= max(t_blurred_frame_bloom_only_color2.Sample(s_linear, uv).rgb, 0.0f);
	frame_color							+= t_frame_color.SampleLevel(s_material1, uv, 0).rgb;
#endif // #if GLOBAL_POST_PROCESS_QUALITY

	frame_color							+= t_lens_flares.SampleLevel(s_linear, uv, 0).rgb;

	// tone mapping
	frame_color							= tone_mapped_color( frame_color );

#if GLOBAL_POST_PROCESS_QUALITY
#	if CONFIG_USE_IMAGE_GRAIN
	frame_color							= grained_color( frame_color, uv );
#	endif // #if CONFIG_USE_IMAGE_GRAIN

	// color grading
	frame_color							= convert_to_linear_space( color_lookup_table( frame_color ) );

	frame_color							= vignetted_color( frame_color, uv );
#else // #if GLOBAL_POST_PROCESS_QUALITY
	frame_color							= pow( frame_color, gamma_value );
#endif // #if GLOBAL_POST_PROCESS_QUALITY

	return								float4( frame_color, 0.0f );
}
