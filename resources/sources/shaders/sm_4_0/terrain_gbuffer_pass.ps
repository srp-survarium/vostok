/*	$DEFINES$:
		CONFIG_VERTEX_INPUT_TYPE,
		CONFIG_NUM_USED_TERRAIN_LAYERS,
		CONFIG_TERRAIN_BLEND_MODE,
		CONFIG_USED_TERRAIN_HEIGHT_MASK,
		CONFIG_TDETAIL,
		CONFIG_TNORMAL,
		CONFIG_PARALLAX,
		CONFIG_TSPECULAR_COLOR,
*/

#include "common.h"
#include "material.h"
#include "gbuffer.h"
#include "gamma_correction.h"
#include "psf_normal.h"

// Terrain steep parallax uses raw height, 12..5 samples, and a 200 m fade.
// Keep the following globals in this order.

float						constant_parallax_scale;

#if CONFIG_PARALLAX
float4						min_t_height_map;
float4						max_t_height_map;
#endif // #if CONFIG_PARALLAX

float get_terrain_parallax_height( Texture2D in_t_height_map, float2 tc, float2 tc_ddx, float2 tc_ddy)
{
	return in_t_height_map.SampleGrad( s_base, tc, tc_ddx, tc_ddy).x;
}

float2 psf_parallax_terrain( Texture2D in_t_height_map, float4 world_view_position, float2 tc, float3x3 tangent_trans)
{
	static const float	parallax_start_fade	= 8.0f;
	static const float	parallax_stop_fade	= 200.0f;

	const float3	position	= world_view_position.xyz;

	//	The march samples under divergent flow control, so its gradients are
	//	taken here, from the entry tc, and carried in.
	const float2	tc_ddx	= ddx(tc);
	const float2	tc_ddy	= ddy(tc);

	float2	out_tc		= tc;

	//	The fade-out test reads the float4 and the fade below reads the float3
	//	copy.  Written the other way - both off position.z - fxc carries the
	//	branch fact into the fade's saturate and drops its lower clamp, which
	//	costs the static-mesh parallax permutations their mul_sat.  The two
	//	reads coalesce afterwards, so the blob sees one interpolant fetch.
	if ( world_view_position.z < parallax_stop_fade)
	{
		const float	max_samples		= 12.f;
		const float	min_samples		= 5.f;
		const float	parallax_offset	= -0.013f;

		float3	eye					= mul( transpose(tangent_trans), -position);
		eye							= normalize(eye);

		//	Fewer steps the more grazing the view.
		float	steps				= lerp( max_samples, min_samples, eye.z);
		float	step_size			= 1.f / steps;
		float2	delta				= eye.xy * (parallax_offset * 1.2f);
		float2	tc_offset_per_step	= step_size * delta;

		float2	current_tc			= out_tc;
		float	current_height		= 0.f;
		float	current_bound		= 1.f;

		//	[loop]: the blobs keep a real loop with sample_d, gradients hoisted
		//	from the entry tc.  Left to itself fxc tries to unroll and gives up
		//	at 1024 iterations.
		LOOP
		for ( ; current_height < current_bound; current_bound -= step_size)
		{
			current_tc		+= tc_offset_per_step;
			current_height	= get_terrain_parallax_height( in_t_height_map, current_tc, tc_ddx, tc_ddy);
		}

		//	Step back one and interpolate between the two bracketing samples.
		current_tc			-= tc_offset_per_step;
		float	prev_height	= get_terrain_parallax_height( in_t_height_map, current_tc, tc_ddx, tc_ddy);

		float	delta2		= ((current_bound + step_size) - prev_height);
		float	delta1		= (current_bound - current_height);
		float	amount		= (current_bound * delta2 - (current_bound + step_size) * delta1) / (delta2 - delta1);
		float	fade		= smoothstep( parallax_stop_fade, parallax_start_fade, position.z);

		out_tc				+= delta * ((1.f - amount) * fade);
	}

	return out_tc;
}

// Local terrain packing uses a Lambert normal encode and split material field;
// gbuffer.h's store helpers use a different layout.

//	Target 0: a Lambert azimuthal equal-area normal in xy, and a twelve-bit
//	field split across a ten-bit z and a two-bit w - low seven bits gloss, top
//	five a specular parameter.  gbuffer.h's read side (enc*4-2,
//	g = sqrt(1-f/4), z = 1-f/2) is the exact inverse of the xy encode.
//
//	The gloss is derived here rather than at the call site on purpose: the
//	blobs schedule its chain after the normal encode, which only happens if it
//	is written after it.
float4 terrain_store_rt_normal( float3 normal, float linear_albedo_green, float specular_parameter)
{
	float2	enc				= normal.xy / sqrt( -normal.z * 8.f + 8.f) + 0.5f;

	//	Terrain gloss: off the albedo's green channel, in linear space.  Bright
	//	ground is rough, dark ground is glossy.
	float	gloss			= 1.f - pow( linear_albedo_green * 1.5f, 1.9f);

	uint	gloss_bits		= (uint)(gloss * 127.f) & 127;
	uint	parameter_bits	= (uint)(ABS_TO_REMOVE_WARNING(specular_parameter) * 31.f) & 31;

	return float4( enc,
				   (float)(((parameter_bits << 7) & 1023) + gloss_bits) * (1.f/1023.f),
				   (float)(parameter_bits >> 3) * (1.f/3.f));
}

//	Target 1: albedo, and a seven-bit specular intensity in an eight-bit
//	channel - the same quantisation gbuffer_pass.ps records.
float4 terrain_store_rt_color( float3 diffuse, float specular_intensity)
{
	uint	intensity_bits	= (uint)(saturate(specular_intensity) * 127.f);

	return float4( ABS_TO_REMOVE_WARNING(diffuse), (float)intensity_bits * (1.f/255.f));
}

////////////////////////////////////////////////////////////////////////////
//	Resources.  Declaration order is slot order: mask, the four diffuse
//	layers, the four normal layers, the detail pair, the four height maps.
////////////////////////////////////////////////////////////////////////////

Texture2D					texture_mask;

Texture2D					texture_diffuse_0;
Texture2D					texture_diffuse_1;
Texture2D					texture_diffuse_2;
Texture2D					texture_diffuse_3;

#if CONFIG_TNORMAL
Texture2D					texture_normal_0;
Texture2D					texture_normal_1;
Texture2D					texture_normal_2;
Texture2D					texture_normal_3;
#endif // #if CONFIG_TNORMAL

#if CONFIG_TDETAIL
Texture2D					texture_detail_0;
Texture2D					texture_detail_1;
#endif // #if CONFIG_TDETAIL

#if CONFIG_PARALLAX
Texture2D					texture_height_0;
Texture2D					texture_height_1;
Texture2D					texture_height_2;
Texture2D					texture_height_3;
#endif // #if CONFIG_PARALLAX

uniform float4				constant_tiles;			//	one tile rate per layer
uniform float4				constant_detail_tiles;	//	xy: the detail pair

////////////////////////////////////////////////////////////////////////////
//	Local pixel inputs; unused semantics still occupy signature slots.
//
//	  type                    TEXCOORD0..5
//	  NULL (0)                world position
//	  STATIC (1)              tbn_x, tbn_y, tbn_z, world pos, view pos, tc
//	  GRASSBILLBOARD (10)     world position
//	  SPEEDTREE_FROND (12)    world position
//	  SPEEDTREE_LEAFMESH (13) world position, tc, tbn_x, tbn_y, tbn_z
//	  SPEEDTREE_LEAFCARD (14) world position, tc
////////////////////////////////////////////////////////////////////////////

#if CONFIG_VERTEX_INPUT_TYPE == STATIC_VERTEX_INPUT_TYPE
#	define TERRAIN_PS_TANGENTS			1
#	define TERRAIN_PS_TC				1
#	define TERRAIN_PS_VIEW_POSITION		1
#elif CONFIG_VERTEX_INPUT_TYPE == SPEEDTREE_LEAFMESH_VERTEX_INPUT_TYPE
#	define TERRAIN_PS_TANGENTS			1
#	define TERRAIN_PS_TC				1
#elif CONFIG_VERTEX_INPUT_TYPE == SPEEDTREE_LEAFCARD_VERTEX_INPUT_TYPE
#	define TERRAIN_PS_TC				1
#endif

#ifndef TERRAIN_PS_TANGENTS
#	define TERRAIN_PS_TANGENTS			0
#endif
#ifndef TERRAIN_PS_TC
#	define TERRAIN_PS_TC				0
#endif
#ifndef TERRAIN_PS_VIEW_POSITION
#	define TERRAIN_PS_VIEW_POSITION		0
#endif

#if CONFIG_VERTEX_INPUT_TYPE == STATIC_VERTEX_INPUT_TYPE
struct p_terrain
{
	float4	homogeneous_position	: SV_Position;
	float3	tbn_x					: TEXCOORD0;
	float3	tbn_y					: TEXCOORD1;
	float3	tbn_z					: TEXCOORD2;
	float3	position				: TEXCOORD3;	//	world space, unread here
	float3	view_position			: TEXCOORD4;
	float2	tc						: TEXCOORD5;
};
#elif CONFIG_VERTEX_INPUT_TYPE == SPEEDTREE_LEAFMESH_VERTEX_INPUT_TYPE
struct p_terrain
{
	float4	homogeneous_position	: SV_Position;
	float3	position				: TEXCOORD0;
	float2	tc						: TEXCOORD1;
	float3	tbn_x					: TEXCOORD2;
	float3	tbn_y					: TEXCOORD3;
	float3	tbn_z					: TEXCOORD4;
};
#elif CONFIG_VERTEX_INPUT_TYPE == SPEEDTREE_LEAFCARD_VERTEX_INPUT_TYPE
struct p_terrain
{
	float4	homogeneous_position	: SV_Position;
	float3	position				: TEXCOORD0;
	float2	tc						: TEXCOORD1;
};
#else	//	NULL, GRASSBILLBOARD, SPEEDTREE_FROND
struct p_terrain
{
	float4	homogeneous_position	: SV_Position;
	float3	position				: TEXCOORD0;
};
#endif

struct f_terrain
{
	float4	normal_material			: SV_Target0;
	float4	color_specular			: SV_Target1;
	float4	specular_color			: SV_Target2;
};

void fill_terrain_material_parameters( in p_terrain input, out material_parameters parameters)
{
	clear_material_parameters(parameters);

	parameters.world_position		= input.position;

	//	Only the static mesh interpolates a view-space position; the rest carry
	//	world space and are transformed here.  The frond path assigns nothing
	//	and keeps the cleared zero - so its parallax march runs from the eye
	//	itself: the fade-out branch folds to always-taken and the tangent-space
	//	eye vector is 0/0.  The blobs prove it (no cbuffer bound at all for that
	//	permutation, and NaN offsets through the march), so it is a bug in the
	//	shipped source, faithfully kept.
#if TERRAIN_PS_VIEW_POSITION
	parameters.world_view_position	= float4( input.view_position, 1.f);
#elif CONFIG_VERTEX_INPUT_TYPE != SPEEDTREE_FROND_VERTEX_INPUT_TYPE
	parameters.world_view_position	= float4( mul( m_V, float4( input.position, 1.f)), 1.f);
#endif

	//	The terrain mesh itself comes through the null vertex input and carries
	//	no texture coordinates: its splat is indexed by world xz, which is why
	//	a terrain material has a tile rate and not a uv set.  The grass and
	//	frond paths have neither, and keep the cleared zero - every one of their
	//	permutations samples the whole splat at the origin.
#if TERRAIN_PS_TC
	parameters.tc					= input.tc;
#elif CONFIG_VERTEX_INPUT_TYPE == NULL_VERTEX_INPUT_TYPE
	parameters.tc					= input.position.xz;
#endif

#if TERRAIN_PS_TANGENTS
	parameters.tangent_to_viewspace	= float3x3( input.tbn_x, input.tbn_y, input.tbn_z);
#endif
}

//	psf_normal.h's psf_tnormal, sampled through s_anisotropic: every normal
//	sample in the blobs uses it, and only s_anisotropic and s_base are bound.
//	(The tree's psf_normal.h samples s_normal, which would take a third slot.)
float3 terrain_tnormal( Texture2D in_t_normal, float3x3 tangent_trans, float2 tc)
{
	float3	normal;
	normal.xy	= in_t_normal.Sample( s_anisotropic, tc).wy * 2.f - 1.f;
	normal.z	= sqrt( saturate( 1.0f - dot( normal.xy, normal.xy)));
	normal.y	= -normal.y;
	normal		= normalize(normal);

	return normalize( mul( tangent_trans, normal));
}

//	The detail layer over the splat result: blend layer first, base second, in
//	the order a compositing operator takes them.
float3 apply_terrain_detail( float3 detail, float3 base)
{
#if CONFIG_TERRAIN_BLEND_MODE == 0
	//	Average: half the splat, half the detail.  Both halves are explicit
	//	because the blobs multiply each side separately.
	return detail * 0.5f + base * 0.5f;
#else
	//	Hard light, the detail layer driving the branch: it multiplies where it
	//	is dark and screens where it is light, so mid grey leaves the splat
	//	alone.
	return detail < 0.5f ? base * detail * 2.f : 1.f - (1.f - detail) * 2.f * (1.f - base);
#endif
}

void main( in p_terrain input, out f_terrain output)
{
	material_parameters	parameters;
	fill_terrain_material_parameters( input, parameters);

	const float2	tc				= parameters.tc;
	const float3x3	tangent_trans	= parameters.tangent_to_viewspace;

	//	One tile rate per layer.  The mask is the only thing sampled at the
	//	unscaled tc: it is a per-terrain map, the layers are tiling materials.
	float2	tc0	= tc * constant_tiles.x;
	float2	tc1	= tc * constant_tiles.y;
	float2	tc2	= tc * constant_tiles.z;
	float2	tc3	= tc * constant_tiles.w;

#if CONFIG_PARALLAX
	//	CONFIG_USED_TERRAIN_HEIGHT_MASK names the layers past the first that
	//	brought a height map of their own; layer 0's is implied by
	//	CONFIG_PARALLAX.  Only 0 and 7 ship.
	tc0 = psf_parallax_terrain( texture_height_0, parameters.world_view_position, tc0, tangent_trans);
#	if CONFIG_USED_TERRAIN_HEIGHT_MASK & 1
	tc1 = psf_parallax_terrain( texture_height_1, parameters.world_view_position, tc1, tangent_trans);
#	endif
#	if CONFIG_USED_TERRAIN_HEIGHT_MASK & 2
	tc2 = psf_parallax_terrain( texture_height_2, parameters.world_view_position, tc2, tangent_trans);
#	endif
#	if CONFIG_USED_TERRAIN_HEIGHT_MASK & 4
	tc3 = psf_parallax_terrain( texture_height_3, parameters.world_view_position, tc3, tangent_trans);
#	endif
#endif // #if CONFIG_PARALLAX

	//	Layer weights: the mask's four channels, renormalised to sum to one.  A
	//	mask that already sums to one passes through unchanged; one that does
	//	not is rescaled rather than clipped, so no channel is privileged.
	float4	mask	= texture_mask.Sample( s_anisotropic, tc);
	mask			/= mask.x + mask.y + mask.z + mask.w;

	const float4	c0	= texture_diffuse_0.Sample( s_anisotropic, tc0);
	const float4	c1	= texture_diffuse_1.Sample( s_anisotropic, tc1);
	const float4	c2	= texture_diffuse_2.Sample( s_anisotropic, tc2);
	const float4	c3	= texture_diffuse_3.Sample( s_anisotropic, tc3);

#if CONFIG_TDETAIL
	//	The second detail layer is bound but weighted out of existence: the
	//	blobs keep the sample and multiply it by 1e-5, which reads as a slot
	//	held open rather than a layer.  Note the sampler - detail_1 is the one
	//	resource on s_base rather than s_anisotropic.
	float3	detail	= texture_detail_0.Sample( s_anisotropic, tc * constant_detail_tiles.x).rgb
					+ texture_detail_1.Sample( s_base, tc * constant_detail_tiles.y).rgb * 0.00001f;
#endif // #if CONFIG_TDETAIL

	//	Weight first in every product: the blobs record mad(weight, colour, acc)
	//	throughout, and colour-first flips the operand order.
	float3	color	= mask.x * c0.rgb + mask.y * c1.rgb + mask.z * c2.rgb + mask.w * c3.rgb;

#if CONFIG_TDETAIL
	color			= apply_terrain_detail( detail, color);
#endif // #if CONFIG_TDETAIL

	//	Target 1 is stored here, ahead of the normal work, and the albedo's
	//	linear green named after it.  Naming that green before the store makes
	//	fxc propagate the .y swizzle back through the whole blend chain, and the
	//	blobs keep three-lane arithmetic with the scalar in the spare lane.
	//	0.04 is the dielectric specular intensity, and quantises to 5/255 - the
	//	constant every one of the thirty listings writes to target 1's alpha.
	output.color_specular	= terrain_store_rt_color( color, 0.04f);

	const float	linear_green	= convert_to_linear_space(color).y;

	//	Normals: each layer's map is taken to view space on its own and the four
	//	are then weighted by the same mask, which is not the same thing as
	//	blending in tangent space and transforming once - but it is what shipped.
	//	Without CONFIG_TNORMAL there is no map at all and the geometric normal
	//	is the tangent frame's third column.
	float3	normal	= parameters.normal;

#if CONFIG_TNORMAL
	normal			= mask.x * terrain_tnormal( texture_normal_0, tangent_trans, tc0)
					+ mask.y * terrain_tnormal( texture_normal_1, tangent_trans, tc1)
					+ mask.z * terrain_tnormal( texture_normal_2, tangent_trans, tc2)
					+ mask.w * terrain_tnormal( texture_normal_3, tangent_trans, tc3);
#else
	normal			= mul( tangent_trans, normal);
#endif // #if CONFIG_TNORMAL

	normal			= normalize(normal);

	// CONFIG_TSPECULAR_COLOR is disabled for this stage.
#if CONFIG_TSPECULAR_COLOR
	const float3	specular_color		= color;
#else
	const float3	specular_color		= float3( 1.f, 1.f, 1.f);
#endif // #if CONFIG_TSPECULAR_COLOR

	//	1.0 is the specular parameter the five-bit field carries - it saturates
	//	to 31, which is what puts 896 in target 0's z and 1.0 in its w.
	output.normal_material	= terrain_store_rt_normal( normal, linear_green, 1.f);
	output.specular_color	= float4( specular_color, 1.f);
}
