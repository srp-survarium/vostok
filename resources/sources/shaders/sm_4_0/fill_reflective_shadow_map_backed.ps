/*	$DEFINES$:
		CONFIG_VERTEX_INPUT_TYPE,
		CONFIG_USE_SUBUV,
*/

#if CONFIG_VERTEX_INPUT_TYPE == 0		// null mesh

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
};
#define material_position(input)	(input).position
#define material_normal(input)		float3(0.f, 0.f, 1.f)
#define material_color(input)		float3(1.f, 1.f, 1.f)

#elif CONFIG_VERTEX_INPUT_TYPE == 1 || CONFIG_VERTEX_INPUT_TYPE == 2	// static mesh, lpv

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float3	normal				: TEXCOORD1;
	float3	color				: TEXCOORD2;
};
#define material_position(input)	(input).position
#define material_normal(input)		(input).normal
#define material_color(input)		(input).color

#elif CONFIG_VERTEX_INPUT_TYPE >= 3 && CONFIG_VERTEX_INPUT_TYPE <= 6	// skeleton mesh, 4/3/2/1 bones

struct vertex_output_struct
{
	float3	tbn_x				: TEXCOORD0;
	float3	tbn_y				: TEXCOORD1;
	float3	tbn_z				: TEXCOORD2;
	float4  homogeneous_position: SV_Position;
	float3	view_position		: TEXCOORD3;
	float3	prev_position		: TEXCOORD4;
	float3	position			: TEXCOORD5;
	float2	tc					: TEXCOORD6;
};
#define material_position(input)	(input).position
#define material_normal(input)		float3((input).tbn_x.z, (input).tbn_y.z, (input).tbn_z.z)
#define material_color(input)		float3(1.f, 1.f, 1.f)

#elif CONFIG_VERTEX_INPUT_TYPE == 7 || CONFIG_VERTEX_INPUT_TYPE == 8	// particle / particle subuv

// particle_vertex_input.h's loose globals lead $Globals in these two.
float3	up_view_vector;
float3	right_view_vector;

float	use_align_by_dir;
float3	view_location;

float	use_fixed_axis;
float3	rotation_fixed_axis;

float	locked_no_ratate_axis_index;

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float3	normal				: NORMAL;
	float4	color				: COLOR;
	float2	tc					: TEXCOORD1;
	float3  tangent				: TEXCOORD2;
	float3  binormal			: TEXCOORD3;
#if CONFIG_USE_SUBUV
	float4	tc1					: TEXCOORD4;
#endif // #if CONFIG_USE_SUBUV
};
#define material_position(input)	(input).position
#define material_normal(input)		mul((float3x3)m_V, (input).normal)
#define material_color(input)		float3(1.f, 1.f, 1.f)

#elif CONFIG_VERTEX_INPUT_TYPE == 9		// particle beamtrail

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float4	color				: TEXCOORD1;
	float2	tc					: TEXCOORD2;
};
#define material_position(input)	(input).position
#define material_normal(input)		float3(0.f, 0.f, 1.f)
#define material_color(input)		float3(1.f, 1.f, 1.f)

#elif CONFIG_VERTEX_INPUT_TYPE == 10	// decal

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
};
#define material_position(input)	(input).position
#define material_normal(input)		float3(0.f, 0.f, 1.f)
#define material_color(input)		float3(1.f, 1.f, 1.f)

#elif CONFIG_VERTEX_INPUT_TYPE == 11	// grass mesh

// grassmesh_vertex_input.h's one loose global, ahead of near_far_invn_invf.
float4	patch_parameters;

struct vertex_output_struct
{
	float3	tbn_x				: TEXCOORD0;
	float3	tbn_y				: TEXCOORD1;
	float3	tbn_z				: TEXCOORD2;
	float4	color				: TEXCOORD3;
	float4  homogeneous_position: SV_Position;
	float4	params				: TEXCOORD4;
	float3	view_position		: TEXCOORD5;
	float3	position			: TEXCOORD6;
	float2	tc					: TEXCOORD7;
};
#define material_position(input)	(input).position
#define material_normal(input)		float3((input).tbn_x.z, (input).tbn_y.z, (input).tbn_z.z)
#define material_color(input)		float3(1.f, 1.f, 1.f)

#elif CONFIG_VERTEX_INPUT_TYPE == 12	// post process

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
};
#define material_position(input)	float3(0.f, 0.f, 0.f)
#define material_normal(input)		float3(0.f, 0.f, 1.f)
#define material_color(input)		float3(1.f, 1.f, 1.f)

#elif CONFIG_VERTEX_INPUT_TYPE == 13	// wires

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float2	tc					: TEXCOORD1;
	float3	tbn_x				: TEXCOORD2;
	float3	tbn_y				: TEXCOORD3;
	float3	tbn_z				: TEXCOORD4;
};
#define material_position(input)	(input).position
#define material_normal(input)		float3(0.f, 0.f, 1.f)
#define material_color(input)		float3(1.f, 1.f, 1.f)

#else	// CONFIG_VERTEX_INPUT_TYPE == 14	// user

struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float2	tc					: TEXCOORD1;
};
#define material_position(input)	(input).position
#define material_normal(input)		float3(0.f, 0.f, 1.f)
#define material_color(input)		float3(1.f, 1.f, 1.f)

#endif // #if CONFIG_VERTEX_INPUT_TYPE

// gbuffer.h, then colored_light.h, then light_ps_helper.h's own two - the
// offsets in $Globals are the proof of this order, and all of them but
// light_color and light_intensity are dead here.
uniform float4	near_far_invn_invf;

uniform float3	light_color;
uniform float	light_intensity;

uniform float	light_diffuse_influence_factor;
uniform float	light_specular_influence_factor;

// Ship static_globals layout (byte-proven repo-wide); only the particle
// families reference it, and fxc drops an entirely unreferenced cbuffer.
cbuffer	static_globals
{
	uniform float4x4	m_P;
	uniform float4x4	m_VP;
	uniform float3x4	m_V;
	uniform float3x4	m_V2W;
	uniform float4		fog_params;
	uniform float3		eye_position;
	uniform float3		eye_position_view_space;
	uniform float3		eye_direction;
	uniform float		scene_time;
	uniform float4		screen_res;
}

static const float	gamma_value	= 2.2f;

float3 convert_to_linear_space( in float3 color )
{
	return	pow( abs(color), gamma_value );
}

void	main(in vertex_output_struct input,
			 out float4 out_light_render_target		: SV_Target0,
			 out float4 out_normal_render_target	: SV_Target1,
			 out float4 out_position_render_target	: SV_Target2)
{
	out_light_render_target		= float4( convert_to_linear_space( light_color) * material_color(input) * light_intensity, 0.f);
	out_normal_render_target	= float4( normalize( material_normal(input)), 0.f);
	out_position_render_target	= float4( material_position(input), 0.f);
}
