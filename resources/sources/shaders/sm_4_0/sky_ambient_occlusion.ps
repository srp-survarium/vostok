/*	$DEFINES$:
		GLOBAL_SHADING_QUALITY,
		CONFIG_SHADOWED_LIGHT,
*/

#include "common.h"
#include "gbuffer.h"

// colored_light.h
uniform float3		light_color;
uniform float		light_intensity;

// light_ps_helper.h
uniform float		light_diffuse_influence_factor;
uniform float		light_specular_influence_factor;

// brdf.h
uniform int			lighting_model;

// spot_shadow.h
uniform float4x4	view_to_light_matrix;
uniform float		shadow_z_bias;
uniform float		shadow_transparency;
uniform float		shadow_map_size;

// point_light.h
uniform float		is_shadower;

// this shader's own
uniform float3		s_eye_ray_corner;
uniform float4x4	world_to_ao_map;

Texture2D			t_sao_map_texture;

// ssao_accumulation.ps carries the same table under the same name.
static const float4 random_tangle16[16] =
{
		float4(0.355512,   -0.709318, 	-0.102371,  0.0 ),
		float4(0.534186,    0.71511, 	-0.115167,  0.0 ),
		float4(-0.87866,    0.157139, 	-0.115167,  0.0 ),
		float4(0.140679,   -0.475516, 	-0.0639818, 0.0 ),
		float4(-0.0796121,  0.158842, 	-0.677075,  0.0 ),
		float4(-0.0759516, -0.101676, 	-0.483625,  0.0 ),
		float4(0.12493,    -0.0223423,	-0.483625,  0.0 ),
		float4(-0.0720074,  0.243395, 	-0.967251,  0.0 ),
		float4(-0.207641,   0.414286, 	 0.187755,  0.0 ),
		float4(-0.277332,  -0.371262, 	 0.187755,  0.0 ),
		float4(0.63864,    -0.114214, 	 0.262857,  0.0 ),
		float4(-0.184051,   0.622119, 	 0.262857,  0.0 ),
		float4(0.110007,   -0.219486, 	 0.435574,  0.0 ),
		float4(0.235085,    0.314707,    0.696918,  0.0 ),
		float4(-0.290012,   0.0518654,   0.522688,  0.0 ),
		float4(0.0975089,  -0.329594,    0.609803,  0.0 )
};

// light.h
struct pixel_shader_input {
	float4 	position			:	SV_POSITION;	// in homogenous clip space
	float4 	texture_coordinates	:	TEXCOORD0;
}; // struct pixel_shader_input

float4 main( pixel_shader_input input ) : SV_Target
{
	float2	tc				= input.position.xy*screen_res.zw;

	float3	normal			= gbuffer_read_frame_normal( tc );
	normal.z				= -normal.z;

	float3	world_normal	= mul( (float3x3)m_V2W, normal );

	float	sky_factor		= min( 1.f/rsqrt( saturate( world_normal.y + 0.5f)) + 0.5f, 1.f);

	// Statement order here is load-bearing, not style: the shipped schedule
	// issues the depth tap between the eye ray's `mul` and its `div`, and the
	// float4's z and w are one `mov` - which only happens when the ray is a
	// float4 whose zw are written together.  Folding the depth read into the
	// eye_ray expression, or writing zw as two statements, costs one slot.
	float4	eye_ray;
	eye_ray.xy				= s_eye_ray_corner.xy*( 1 - tc*2 );

	float	depth			= gbuffer_read_frame_depth( tc );

	eye_ray.xy				/= s_eye_ray_corner.z;
	eye_ray.zw				= 1;

	float4	position		= eye_ray;
	position.xyz			= eye_ray.xyz*depth;

	float3	world_position	= mul( m_V2W, position);

	float	height			= saturate( (150.f - world_position.y)/512.f );
	float3	ray_origin		= world_normal + world_position;

	float	accumulator		= 0.f;
	for (int i = 0; i < 16; i++)
	{
		float3	direction	= normalize( random_tangle16[i].xyz );

		for (int j = 1; j < 5; j++)
		{
			float3	sample_position	= (float)j*direction + ray_origin;
			float4	projected		= mul( world_to_ao_map, float4( sample_position, 1.f));
			float2	ao_tc			= projected.xy/projected.w;

			float	sample_height	=
				saturate(
					dot(
						t_sao_map_texture.SampleLevel( s_linear, ao_tc, 0).xyz,
						float3( 255.f*255.f*255.f, 255.f*255.f, 255.f)
					)/(255.f*255.f*255.f)
				);

			accumulator			   += 1.f - saturate( (height - sample_height)*100.f );
		}
	}

	float	occlusion		= accumulator/64.f;
	occlusion				= sky_factor*pow( occlusion, 5.f);

	return	1.f/rsqrt( occlusion*0.125f );
}
