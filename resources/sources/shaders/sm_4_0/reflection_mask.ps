////////////////////////////////////////////////////////////////////////////
//	Reconstructed 2026-08-18 from the shipped v0.100b blob
//	(shaders/sm_4_0/reflection_mask.ps, plain permutation) - absent from the
//	recovered source drop. Byte-identity is the acceptance test:
//	python3 -m vostok.shaders roundtrip reflection_mask.ps
//
//	Dev scratch as it shipped, reproduced rather than tidied:
//	* both arms of the final test return white, so the whole reflection
//	  computation is dead at run time - fxc keeps it because each arm ends in
//	  its own `ret`;
//	* the depth tap is a SampleBias whose *location* is ddx( tc) and whose
//	  bias is ddy( tc).x - almost certainly a SampleGrad the author mistyped,
//	  but it is what the blob's `deriv_rtx`/`deriv_rty`/`sample_b` triple says;
//	* the perspective divide is a separate statement, after the depth tap:
//	  folding it into the eye_ray line moves the `div` above the sample and
//	  flips the `mul` that follows.
//
//	PARKED one counter short of byte-identity. RDEF, ISGN, OSGN and - the
//	part that matters - the whole SHDR chunk are byte-for-byte the ship
//	blob's, all 2,300 bytes accounted for except STAT's mov counter
//	(STAT +0x4C, MovInstructionCount): ship 4, this 3. That counter is taken
//	before the final peephole, so ship's source held one more mov than this
//	one that fxc then folded away.
//
//	HOW BIG THE GAP IS, CORPUS-WIDE (measured 2026-08-18 over all 261 shipped
//	names): 188 have counter == listing mov count, 73 do not, and the excess
//	runs from +1 to +88 (post_process_fxaa.ps counts 84 movs for a listing
//	showing 2; mlaa_blending_weight_calculation.ps counts 116 for 28). So the
//	counter routinely sees movs that never reach the code, and seven shaders
//	with a +1 gap round-trip byte-identically today - color_cover.ps,
//	fill_environment_probe_face.ps, atmospheric_scattering_on_geometry_add.ps,
//	olta_blend.ps, color_doted.ps, mlaa_color_edge_detection.ps and
//	sky_sphere_preview.ps - so the shape that produces one is not exotic.
//
//	ONE SUCH SHAPE, ISOLATED: reduce sky_sphere_preview.ps to seven lines and
//	the gap survives; delete its `( 0.5f >= I.direction.z) ? 1.0f : 0.0f` mask
//	and the gap closes (counted 2 / shown 2 instead of counted 2 / shown 1).
//	A bool->float select is emitted as a mov and then rewritten to
//	`and 0x3f800000`, and the mov is counted but never appears. That is a
//	proof that the counter is reachable - but every such construct also
//	changes the code, and this shader's 1,152-byte SHDR is already exact, so
//	the extra mov must be one that folds into an existing instruction.
//
//	2026-08-18, FOURTH PASS - mined old/ and the whole tree for shaders that
//	actually produce a phantom mov, rather than guessing at shapes.
//
//	Method: compile every shader in old/ and in the tree, and record
//	(counter, movs shown in the listing, movc, and). 12 of the 48 old files
//	that still compile have a gap; 49 in the tree do.
//
//	WHAT PRODUCES A PHANTOM MOV, confirmed:
//	  * clip(). old/accum_sun_mask.ps and old/system_grid.ps are the clean
//	    cases - gap 1, no `and`, no `movc` - and system_grid is just a
//	    sample, a clip and a return. On a minimal probe clip( n.x) costs 2
//	    counted movs and clip( color.w - 0.75f) in atmosphere_sun_moon.ps
//	    costs 1, so the argument's form decides how many;
//	  * an `out float4 result : SV_TARGET` parameter assigned once per branch.
//	    gbuffer_to_screen.ps counts 36 against 21 shown - a gap of 15 across
//	    its 16-way selector - because each branch's assignment is counted and
//	    they merge into far fewer output writes;
//	  * a *computed* value written to part of a vector, which is what the
//	    distortion pair does (output.distortion.xy computed, .zw constant);
//	  * each additional live return, +1 apiece.
//
//	WHY NONE OF THEM APPLIES HERE:
//	  * ship's blob has no discard at all, and a clip whose argument fxc can
//	    prove non-negative folds away *without being counted* - measured for
//	    clip(1.f), clip(dot(n,n)), clip(dot(reflected,reflected)),
//	    clip(length(reflected)) and clip(eye_ray.z), all leaving the counter
//	    at 3 and the SHDR identical;
//	  * constant writes always merge before the count. An output struct with
//	    an SV_TARGET member, .xyz and .w assigned separately, in either arm or
//	    both, is byte-identical and counts 3;
//	  * splitting a computed vector write does reach 4 - `position.z` written
//	    on its own line, before or after the .xy write, gives counter 4 - but
//	    fxc then folds eye_ray.z*depth to depth and the blob is 12 bytes
//	    short (2288). Every split that preserves the three-component multiply
//	    (.x + .yz, .xz + .y, .yz + .x) keeps the counter at 3. Splitting
//	    world_position, view_direction or reflected the same way is
//	    code-neutral and does not count.
//
//	So the phantom is a *computed* partial write somewhere, since that is the
//	only mechanism left that is invisible in the code - but every placement
//	tried either folds an instruction away or is canonicalised. Ship's own
//	gbuffer_read_rt_position (`half2 data` where only .x is used, plus a
//	by-value eye_ray it mutates) reproduces this shader's opening exactly and
//	still counts 3.
//
//	Byproduct worth keeping: ship's dependency table for this blob shows
//	gbuffer.h including gamma_correction.h and then debug.h, neither of which
//	our copy had. Restored - byte-neutral, and ship's own 816 gbuffer.h has
//	since dropped the debug.h include.
//
//	2026-08-18, THIRD PASS - the counter is source-controllable, and the
//	count says ship had THREE return statements.
//
//	Measured on this file, SHDR unchanged unless noted:
//	  2 returns (this source)          -> counter 3
//	  3 flat returns, second branch live -> counter 4  (SHDR +52, 2352)
//	  3 returns, complementary tests     -> counter 4  (SHDR +80, 2380)
//	  3 returns, nested in the taken arm -> counter 4  (SHDR +52)
//	  4 returns (nested in else)         -> counter 5  (SHDR +56)
//	So each additional *live* return adds exactly one to the counter, and
//	ship's 4 against our 3 is one extra return. The remaining problem is
//	precise: find the third return whose branch fxc eliminates *after* the
//	statistics are taken. Every elimination tried happens before:
//	  if ( false) / if ( 1.f < 0.f) / a contradictory compound test -> folded
//	    at parse, counter stays 3, SHDR identical;
//	  a duplicate return after another return, in or out of a block ->
//	    dropped at parse, counter 3;
//	  if/else where both arms return, with a trailing return -> the trailing
//	    one is dropped, counter 3, SHDR +8;
//	  [flatten] on the second test -> counter 4 but the branch survives.
//
//	Also ruled out as the source of the extra count, each SHDR-identical
//	unless noted: a shared `float one = 1.f` feeding both the eye_ray.z and
//	the float4 w; splitting the float4's w onto its own statement; an output
//	struct with an SV_TARGET member; an `out float4` parameter; a named copy
//	of any intermediate (normal, view_direction, reflected, eye_ray); a
//	returned `float4 r = 1.f`; `[branch]`; a single-iteration [unroll] loop
//	around the test (SHDR -8); and a ternary with identical arms.
//
//	Two general facts about the counter, established on a minimal probe and
//	on the corpus, both worth reusing:
//	  * dead code, self-copies, bitcasts, helper calls (by value, by out
//	    parameter, struct-returning), static globals, one-element arrays,
//	    single-iteration loops and if(true) blocks are ALL canonicalised
//	    before the count - none of them moves it;
//	  * a gap is produced by nested returns (a probe with an if/else whose
//	    else holds a nested if, three returns total, gives counted 2 shown 1)
//	    and by a bool->float select, which is emitted as a mov and rewritten
//	    to `and 0x3f800000` - that is sky_sphere_preview.ps's +1. Neither
//	    applies here: ship's blob has no `and` and no `movc` at all.
//
//	Compiling this file against ship's own gbuffer.h (recovered from the
//	build-816 debug blobs) produces byte-identical output, counter included,
//	so the divergence is not in that header.
//
//	2026-08-18, SECOND PASS: thirteen further shapes, same result (SHDR
//	byte-identical, counter 3). The counter lives at STAT chunk dword 19,
//	i.e. chunk+0x4c, ship 4 against our 3 - confirmed by a word-level diff of
//	the two STAT chunks, which differ in that dword and nothing else.
//
//	The most informative negative: **fxc coalesces constant writes before it
//	counts.** The shipped listing's single `mov r0.zw, l(0,0,1,1)` merges the
//	eye_ray.z and the float4 w, so the obvious theory was that ship wrote two
//	constant stores that merged 2->1, which is exactly the "counted but not
//	shown" shape. It is not: adding a *third* constant write (declaring
//	eye_ray as float4 and assigning .z and .w on separate lines, then feeding
//	.w to the float4 constructor) leaves the counter at 3. Splitting the
//	float4's .w onto its own statement, assigning .w before .xyz, and building
//	eye_ray through a constructor all likewise leave it at 3.
//
//	Also ruled out, each SHDR-identical: naming the derivatives in locals;
//	writing the bias as ddy(I.tc).x rather than relying on the implicit
//	truncation; naming the depth tap as a float4 and taking .w; returning
//	float4(1,1,1,1) in one arm and the scalar broadcast in the other; and
//	naming a `float4 result = 1.f` returned from both arms.
//
//	Named negations do NOT produce a counted mov here - fxc folds them at
//	parse. `-(world_position - eye_position)`, a named `-normal` fed to a
//	written-out reflect, and `-scaled_tc` for the eye ray all changed the
//	SHDR (so they are wrong anyway) without moving the counter.
//
//	Standing: this permutation is recovered in substance. All 2,300 bytes
//	match except one statistics dword describing fxc's intermediate state,
//	and roughly sixty source spellings now reproduce the shipped SHDR exactly.
//
//	TRIED, ~45 source shapes, each compiled and checked for (SHDR identical,
//	STAT +0x4C). All left the SHDR byte-identical and the counter at 3:
//	  * output shape: `float4 result` returned from both arms (declared at the
//	    top, beside the test, and as 0-then-1 write/overwrite); an `out float4`
//	    parameter with two `return;`s; a one-member `ps_output` struct;
//	    if/else instead of fallthrough; braces; float4(1,1,1,1) and 1.f
//	    spellings; a named `float3 mask = 1.f`;
//	  * the condition: named `float`, named `bool`, `0.f >= dot(...)`,
//	    `!(dot(...) > 0.f)`;
//	  * the eye ray: `float3 eye_ray = 0` / `= float3(0,0,1)`; z written
//	    before xy; float4 eye_ray with .z and .w both written; the ship
//	    gbuffer_read_rt_position shape from the build-816 SDBG source
//	    (`eye_ray.xy = eye_ray.xy/eye_ray.z; eye_ray.z = 1;` with eye_ray.z
//	    first set to s_eye_ray_corner.z), both inline and behind a by-value
//	    `out`-parameter helper;
//	  * the position: float4 with .w set first, .w set last, .w carried from
//	    eye_ray.w, `float4(eye_ray*depth, 1.f)`, declare-then-assign;
//	  * the world position: float4 then .xyz, a named float4 argument, a
//	    declare-then-assign, `mul` into .xyz of the same float4;
//	  * negations that fold into a source modifier: `float3 to_eye =
//	    -world_position` used as `eye_position + to_eye`, and the same for the
//	    reflect;
//	  * copies and namings: `float2 tc = I.tc`, loose `hpos`/`tc` parameters
//	    instead of the struct, a named `float2 normal_tc`, named ddx/ddy
//	    locals, a `float2 data` fetch using only `.x`, a named float3x3 for
//	    (float3x3)m_V2W, the sample named before `.w`/`.xyz`, splitting
//	    normalize/reflect apart, a dead `normal.xy` store overwritten whole.
//	Also learned in passing: moving the whole body into a helper called from
//	main is NOT neutral - fxc then dead-codes the entire reflection chain to a
//	56-byte SHDR. The two `ret`s in main are what keep it alive.
////////////////////////////////////////////////////////////////////////////

#include "common.h"
#include "gbuffer.h"
#include "gamma_correction.h"

uniform float4	s_eye_ray_corner;

struct	v2p_reflection_mask
{
	float4	hpos	: SV_POSITION;
	float2	tc		: TEXCOORD0;
};

float4 	main	( v2p_reflection_mask I ) : SV_TARGET
{
	float3	eye_ray;
	eye_ray.xy				= ( 1 - I.tc*2 )*s_eye_ray_corner.xy;

	float	depth			= t_position.SampleBias( s_linear, ddx( I.tc), ddy( I.tc)).w;

	eye_ray.xy				/= s_eye_ray_corner.z;
	eye_ray.z				= 1;

	float3	position		= eye_ray*depth;

	float3	normal			= normalize( mul( (float3x3)m_V2W, t_position.SampleLevel( s_linear, I.tc + 0.001f, 0).xyz));

	float3	world_position	= mul( m_V2W, float4( position, 1.f));
	float3	view_direction	= normalize( eye_position - world_position);
	float3	reflected		= normalize( reflect( view_direction, normal));

	if ( dot( reflected, view_direction) <= 0.f)
		return	1.f;

	return	1.f;
}
