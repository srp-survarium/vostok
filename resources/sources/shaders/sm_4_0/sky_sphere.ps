#include "common.h"

uniform float4	fog_power_and_range;

Texture2D		t_sky_sphere;

struct v2p_sky_sphere
{
	float4	hpos	: SV_Position;
	float2	tc		: TEXCOORD0;
};

struct p_sky_sphere
{
	float4	color	: SV_Target0;
	float4	copy	: SV_Target1;
};

void main( in v2p_sky_sphere I, out p_sky_sphere O )
{
	float	height		= saturate(( 1.0f - I.tc.y)*2.0f - 1.0f);
	float	ramp		= min( pow( saturate( 1.0f - height/fog_power_and_range.y), fog_power_and_range.x), 1.0f);
	float	fog			= saturate( ramp*fog_alpha);

	float	lower		= 0.5f < I.tc.y;

	float4	color		= t_sky_sphere.Sample( s_base, clamp( I.tc, 0.0f, float2( 1.0f, 0.5f))*float2( 1.0f, 2.0f));
	color.w				= 1.0f;

	color				= lerp( color, 0.5f, lower);
	color.xyz			= saturate( lerp( color.xyz, far_fog_color_and_distance.xyz, fog));

	O.color				= color;
	O.copy				= color;
}
