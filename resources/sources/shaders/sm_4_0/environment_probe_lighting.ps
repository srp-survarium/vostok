////////////////////////////////////////////////////////////////////////////
//	Reconstructed	: 17.08.2026
//	Ground truth	: the 32 shipped permutations of
//					  shaders/sm_4_0/environment_probe_lighting.ps,
//					  disassembled with fxc /dumpbin /Fc.  No source for this
//					  name arrived with the drop; forward_probe_lighting.ps
//					  (300/300 byte-identical, same day) is its forward twin
//					  and shares the probe cube read, the roughness-driven mip
//					  pair and the exp( -2*d^8 ) range falloff.
//	Acceptance		: python3 -m vostok.shaders roundtrip environment_probe_lighting.ps
////////////////////////////////////////////////////////////////////////////
//
//	The deferred environment-probe pass: one probe, one draw, two accumulator
//	targets (diffuse SV_Target0, specular SV_Target1) whose w carries the
//	probe's own falloff.  Everything is read out of the g-buffer: linear depth
//	off t_position, the Lambert-azimuthal normal off t_normal, the surface's
//	gloss code out of the normal target's .z and its specular-intensity code
//	out of the diffuse target's .w - both 7-bit fields over 127.
//
//	STATE: 32 of 32 permutations byte-identical (18.08.2026).
//
//	Axis status:
//
//	  GLOBAL_SHADING_QUALITY (0, 3)      DEAD.  Every pair of blobs that
//	                                     differs only in it is byte-identical;
//	                                     the define is not read.
//	  GLOBAL_LIGHTING_QUALITY (0, 3)     the one live quality axis.  At 3 the
//	                                     single diffuse tap becomes an eight-
//	                                     direction cone gather and the closed-
//	                                     form specular becomes the full
//	                                     forward_probe_lighting Beckmann with a
//	                                     Cook-Torrance geometry term on top.
//	                                     273 slots against 144.
//	  CONFIG_ENV_PROBE_GEOMETRY_TYPE     0 sphere, 1 box.  A box probe that
//	                                     neither shadows nor clips drops the
//	                                     dynamic_transforms and
//	                                     positional_lights_constants cbuffers
//	                                     entirely and uses world_to_probe.
//	  CONFIG_ENV_PROBE_WITH_SHADOWS      1 adds t_probe_cubemap_depth, bound
//	                                     between t_probe_cubemap and
//	                                     t_ssao_accumulator, and brings the
//	                                     probe centre back for a box probe.
//	  CONFIG_ENV_PROBE_CLIP_BY_NORMAL    1 multiplies the falloff by
//	                                     saturate( dot( to_probe, n ) + 0.75 ).
//	  GLOBAL_USE_SCREENSPACE_REFLECTIONS_MASK, CONFIG_SHADOWED_LIGHT
//	                                     ship only as 0; unconstrained.
//
//	==== the four things that were wrong, and how each was found ==========
//
//	1. THE ROUNDED CONSTANTS.  fxc's own listing prints every literal with
//	   "%.6f", so `l(0.007874)` and `l(0.003333)` look settled and are not.
//	   Five of this file's constants had to come out of the DXBC as raw float
//	   bits (a word-level diff of ship against our compile, not a listing
//	   diff, is the only thing that shows them):
//	     0x3C010204  1.f/127.f         - NOT the literal 0.007874f
//	     0x3BF6E7B0  1.f/(127.f*1.045f)- NOT 0.007535f.  The 1.045 keeps
//	                                     specular_gloss off zero, which the
//	                                     1/(specular_gloss*22) below divides by
//	     0x37800080  1.f/65535.f       - NOT 0.000015f
//	     0x3B5A740E  1.f/300.f         - NOT 0.003333f
//	     0x3DE38E39  1.f/9.f           - the cone gather's average
//	   `(1.f/127.f)*v` never reproduces the second one for any v; it has to be
//	   spelled as a DIVISION, because fxc folds `A/B` and `A*(1/B)` to
//	   different float32s.  point_light_accumulator.ps already recorded the
//	   /127.f half of this.
//
//	2. THE MIP PRODUCT.  Given a named `gloss_attenuation` variable, fxc
//	   reassociates `((1-m)*4)*gloss_attenuation*8` into a single `*32` and
//	   drops one instruction.  Writing the view term INLINE into the product -
//	   `roughness_mip*pow( saturate( view_dot_normal ), 0.2f )`, roughness
//	   first, exactly forward_probe_lighting.ps's shape - stops the sinking and
//	   restores ship's separate `mul r, r, l(4.000000)`.  See the comment at
//	   the statement itself; nothing else moved it (barriers of every kind are
//	   proved away, statement placement does not matter, and `precise` blocks
//	   the fold only by poisoning half the shader).
//
//	3. THE FALLOFF ORDER.  The normal clip is applied BEFORE the depth-cube
//	   shadow, and the two products take opposite operand orders.
//
//	4. THE LIGHTING_QUALITY=3 ARM, which had never been written.
//
//	Everything else matches the shipped listings instruction for instruction:
//	the eye-ray prologue, both g-buffer reads (depth through s_position, the
//	Lambert-azimuthal normal through s_normal, the gloss code through
//	s_accumulator and the specular-intensity code through s_diffuse), the
//	Schlick fresnel, the diffuse output and its 1/rsqrt packing, the range
//	falloff, the box falloff, the depth-cube shadow, the normal clip, the
//	roughness-blended reflection direction and the whole specular tail.
//
////////////////////////////////////////////////////////////////////////////

/*	$DEFINES$:
		GLOBAL_SHADING_QUALITY,
		GLOBAL_LIGHTING_QUALITY,
		GLOBAL_USE_SCREENSPACE_REFLECTIONS_MASK,
		CONFIG_SHADOWED_LIGHT,
		CONFIG_ENV_PROBE_CLIP_BY_NORMAL,
		CONFIG_ENV_PROBE_WITH_SHADOWS,
		CONFIG_ENV_PROBE_GEOMETRY_TYPE,
*/

#include "common_functions.h"
#include "light_ps_helper.h"
#include "point_light.h"

uniform float3		s_eye_ray_corner;
uniform int			num_mips;
uniform float4		color_parameters;		// x - diffuse scale, y - specular scale
uniform float4x4	world_to_probe;

TextureCube			t_probe_cubemap;
TextureCube			t_probe_cubemap_depth;
Texture2D			t_ssao_accumulator;

//	The probe cube stores colour pre-divided by its own alpha, in gamma space.
float3 sample_probe( float3 direction, float mip_level )
{
	float4 value	= t_probe_cubemap.SampleLevel( s_base, direction, mip_level );
	return	convert_to_linear_space( value.xyz/value.w );
}

float3 sample_probe_diffuse( float3 direction, float mip_level )
{
	float4 value	= t_probe_cubemap.SampleLevel( s_material1, direction, mip_level );
	return	convert_to_linear_space( value.xyz/value.w );
}

//	light_ps_helper.h's accumulator packing, at the probe stage's scale.
float3 pack_light_accumulator( float3 value )
{
	return	1.f/rsqrt( saturate( value*0.125f ) );
}

#if GLOBAL_LIGHTING_QUALITY == 3
//	The eight cone directions of the high-quality diffuse gather.  Each entry
//	is the first row of a circulant 3x3 whose other two rows are its cyclic
//	shifts, so one float3 spells a whole rotation; the world normal is turned
//	by all eight, renormalised, and sampled at the same mip the cheap path
//	takes its single tap at.  Eight taps are averaged over NINE - that is what
//	the blobs hold, and it is a deliberate darkening, not a miscount.
static const float3	cone_directions[8] =
{
	float3(  0.99725014f, -0.029667195f,  0.06791174f  ),
	float3(  0.948293f,   -0.029853212f, -0.31598923f  ),
	float3(  0.89564174f, -0.095602594f,  0.43438f     ),
	float3(  0.8242554f,   0.55417657f,   0.11615242f  ),
	float3(  0.7863557f,  -0.6177587f,    0.004354838f ),
	float3(  0.7716971f,   0.4068773f,   -0.48880917f  ),
	float3(  0.75259656f, -0.34534776f,  -0.56065434f  ),
	float3(  0.7230467f,   0.28388765f,   0.6297708f   ),
};
#endif // #if GLOBAL_LIGHTING_QUALITY == 3

struct environment_probe_output
{
	float4	diffuse		: SV_Target0;
	float4	specular	: SV_Target1;
};

environment_probe_output main( pixel_shader_input input )
{
	float2	tc					= input.texture_coordinates.xy/input.texture_coordinates.w;

	float3	eye_ray;
	eye_ray.xy					= s_eye_ray_corner.xy*( 1 - tc*2 )/s_eye_ray_corner.z;
	eye_ray.z					= 1;

	float3	position			= eye_ray*gbuffer_read_frame_depth( tc );
	float3	world_position		= mul( m_V2W, float4( position, 1 ) );

	float3	to_eye				= eye_position - world_position;
#if !CONFIG_ENV_PROBE_GEOMETRY_TYPE || CONFIG_ENV_PROBE_WITH_SHADOWS || CONFIG_ENV_PROBE_CLIP_BY_NORMAL
	//	The probe centre is the object transform's translation column - the
	//	blobs read m_W's .w lanes, never a position uniform.  A box probe that
	//	neither shadows nor clips never needs it, and its blob drops the whole
	//	dynamic_transforms cbuffer.
	float3	probe_position		= float3( m_W[0][3], m_W[1][3], m_W[2][3] );
	float3	to_probe			= probe_position - world_position;
	float	distance_to_probe	= sqrt( dot( to_probe, to_probe ) );
#endif

	float3	view_direction		= normalize( to_eye );

	float3	normal				= gbuffer_read_frame_normal( tc );
	normal.z					= -normal.z;
	float3	world_normal		= normalize( mul( (float3x3)m_V2W, normal ) );

	float	view_dot_normal		= dot( view_direction, world_normal );
	float3	reflection			= reflect( view_direction, world_normal );

	float4	diffuse_target		= t_diffuse.SampleLevel( s_diffuse, tc, 0 );
	float4	normal_target		= t_normal.SampleLevel( s_accumulator, tc, 0 );

	float	gloss				= (float)( ( (uint)( normal_target.z*1023.f ) ) & 127 );
	float	specular_intensity	= (float)( ( (uint)( diffuse_target.w*255.f ) ) & 127 );

	float	fresnel_at_0_degree	= specular_intensity/127.f;

	float	diffuse_gloss		= 1.f - gloss/127.f;
	float	specular_gloss		= 1.f - gloss/(127.f*1.045f);
	float	roughness_mip		= (1.f - sqrt( 2.f/(gloss/127.f + 2.f) ))*4.f;

	float3	half_direction		= normalize( world_normal - reflection );
	float3	direction			= lerp( half_direction, -reflection, pow( diffuse_gloss, 0.8f ) );

#if GLOBAL_LIGHTING_QUALITY == 3
	//	The high-quality specular is forward_probe_lighting.ps's Beckmann with
	//	a Cook-Torrance geometry term added, and it takes its light direction
	//	from the roughness-blended `direction` bent back toward the normal by
	//	the surface's own smoothness.  Its Fresnel is driven by the halfway
	//	vector, not by view_dot_normal, which is why the whole fresnel block
	//	has to sit below `direction` rather than beside `reflection`.
	float3	mirror_direction	= normalize( direction );
	float3	light_direction		= lerp( mirror_direction, normalize( world_normal + mirror_direction ), gloss/127.f );
	float	light_dot_normal	= saturate( dot( light_direction, world_normal ) );

	float3	halfway_direction	= normalize( light_direction + view_direction );
	float	view_dot_halfway	= dot( view_direction, halfway_direction );
	float	normal_dot_halfway	= dot( world_normal, halfway_direction );
	float	view_dot_halfway_plus	= max( view_dot_halfway, 0.f );
	float	specular_denominator	= 4.f*max( view_dot_halfway, 0.00001f );

	float	fresnel_power		= pow( 1.f - view_dot_halfway_plus, 5.f );
#else // #if GLOBAL_LIGHTING_QUALITY == 3
	float	fresnel_power		= pow( 1.f - saturate( view_dot_normal ), 5.f );
#endif // #if GLOBAL_LIGHTING_QUALITY == 3

	float	fresnel_factor		= fresnel_at_0_degree + (1.f - specular_intensity/127.f)*fresnel_power;

	float	diffuse_fresnel		= 1.f - fresnel_factor*diffuse_gloss;

#if GLOBAL_LIGHTING_QUALITY == 3
	float3	probe_diffuse		= 0.f;
	[unroll]
	for ( int i = 0; i < 8; ++i )
	{
		float3	cone			= cone_directions[i];
		probe_diffuse			+= sample_probe_diffuse( normalize( mul( float3x3( cone, cone.zxy, cone.yzx ), world_normal ) ), (float)( num_mips - 2 ) );
	}
	probe_diffuse				= probe_diffuse*(1.f/9.f);
#else // #if GLOBAL_LIGHTING_QUALITY == 3
	float3	probe_diffuse		= sample_probe_diffuse( world_normal, (float)( num_mips - 2 ) );
#endif // #if GLOBAL_LIGHTING_QUALITY == 3

	float	occlusion			= t_ssao_accumulator.SampleLevel( s_linear, input.position.xy*screen_res.zw, 0 ).x*2.5f;

	float3	diffuse_lighting	= probe_diffuse*(occlusion*color_parameters.x);
	diffuse_lighting			= min( diffuse_lighting, 10.f );
	diffuse_lighting			= diffuse_lighting*diffuse_fresnel;

	//	The probe's own falloff, written into both targets' w.
#if CONFIG_ENV_PROBE_GEOMETRY_TYPE
	//	Box probe: the falloff is a per-axis 1 - exp( -6*sqrt( 1 - |p| ) ) in
	//	probe space, multiplied together and squared.  The sqrt is the same
	//	1.f/rsqrt() the accumulator packing uses.
	float3	probe_space			= mul( world_to_probe, float4( world_position, 1.f ) ).xyz;
	float3	box_falloff			= 1.f - exp( -6.f*(1.f/rsqrt( 1.f - abs( probe_space ) )) );
	float	attenuation			= box_falloff.x*box_falloff.y*box_falloff.z;
	attenuation					= attenuation*attenuation;
#else // #if CONFIG_ENV_PROBE_GEOMETRY_TYPE
	float	attenuation			= exp( -2.f*square( square( square( distance_to_probe/(light_range*0.95f) ) ) ) );
	attenuation					= square( square( attenuation ) );
#endif // #if CONFIG_ENV_PROBE_GEOMETRY_TYPE

	//	The clip comes FIRST and the shadow second: when both are set the blobs
	//	multiply the range falloff by the clip and only then by the shadow, and
	//	the two operand orders are each byte-forced the other way round -
	//	`clip*attenuation` but `attenuation*shadow`.
#if CONFIG_ENV_PROBE_CLIP_BY_NORMAL
	attenuation					= saturate( dot( normalize( to_probe ), world_normal ) + 0.75f )*attenuation;
#endif // #if CONFIG_ENV_PROBE_CLIP_BY_NORMAL

#if CONFIG_ENV_PROBE_WITH_SHADOWS
	//	The probe's own depth cube, packed as g*65025 + b*255 over 65535, read
	//	along the direction from the probe to this pixel.
	float4	probe_depth			= t_probe_cubemap_depth.SampleLevel( s_linear, -normalize( to_probe ), 0 );
	float	stored_distance		= dot( probe_depth.yz, float2( 65025.f, 255.f ) )/65535.f;
	float	shadow				= distance_to_probe/300.f - stored_distance < 0.0005f ? 1.f : 0.f;
	attenuation					= attenuation*shadow;
#endif // #if CONFIG_ENV_PROBE_WITH_SHADOWS

#if GLOBAL_LIGHTING_QUALITY == 3
	float	geometry			= min( min( (2.f*normal_dot_halfway*view_dot_normal)/view_dot_halfway,
										   (2.f*normal_dot_halfway*light_dot_normal)/view_dot_halfway ), 1.f );

	float	specular_power		= 255.f*diffuse_gloss;
	float	roughness			= pow( 2.f/(specular_power + 2.f) - 0.00778f, 0.48f );
	float	normalized_distribution_function	= 1.f/(square( roughness )*pi);

	float	specular			=
		light_dot_normal > 0.f
		?
			(light_dot_normal*fresnel_factor)*geometry*normalized_distribution_function/
			(
				specular_denominator*ABS_TO_REMOVE_WARNING( light_dot_normal*view_dot_normal )
			)
		:
			0.f;

	float	specular_factor		= min( fresnel_factor*saturate( specular ), 100.f );
#else // #if GLOBAL_LIGHTING_QUALITY == 3
	float	specular_factor		= fresnel_factor*min( (1.f/(specular_gloss*22.f))*fresnel_factor*5.f, 1.f );
#endif // #if GLOBAL_LIGHTING_QUALITY == 3
	if ( dot( direction, world_normal ) < 0.f )
		specular_factor			= 1.f;

	//	The view term is spelled INLINE here, and roughness first - exactly the
	//	shape forward_probe_lighting.ps carries ( `(surface_roughness*saturate(
	//	view_dot_normal ))*scale` ).  It is load-bearing.  With a NAMED
	//	`gloss_attenuation` variable instead, fxc reassociates
	//	`((1-m)*4)*gloss_attenuation*8` into one `*32` and this file comes out
	//	28 bytes - one `mul r, r, l(4.000000)` - short of every shipped blob.
	//	Swapping the two factors costs byte-identity too:
	//	`pow(...)*roughness_mip` emits `mul r1.y, r1.y, r1.w` where ship has
	//	`mul r1.y, r1.w, r1.y`.
	float	mip					= roughness_mip*pow( saturate( view_dot_normal ), 0.2f );

	float3	upper				= sample_probe( direction, trunc( mip*8.f + 1.f ) );
	float3	lower				= sample_probe( direction, trunc( mip*8.f ) );

	float3	specular_lighting	= lerp( specular_factor*lower, specular_factor*upper, frac( mip*8.f ) );
	specular_lighting			= lerp( specular_lighting, 0.f, (gloss/127.f)*((gloss/127.f)*(gloss/127.f)) );

	float	saturated_occlusion	= saturate( occlusion );
	float	specular_scale		= saturated_occlusion*square( square( saturated_occlusion ) )*color_parameters.y;
	specular_lighting			= specular_lighting*specular_scale;
	specular_lighting			= min( specular_lighting, 4.f );

	environment_probe_output	result;
	result.diffuse				= float4( pack_light_accumulator( diffuse_lighting ), attenuation );
	result.specular				= float4( pack_light_accumulator( specular_lighting ), attenuation );

	return	result;
}
