#include "common.h"
#include "gbuffer.h"

Texture2D	t_depth_render_target;

struct v2p_copy_depth
{
	float4	hpos		: SV_Position;
	float2	tc			: TEXCOORD0;
	float3	eye_ray		: TEXCOORD1;
};

float4 main( v2p_copy_depth I ) : SV_Target
{
	float	near	= near_far_invn_invf.x;
	float	far		= near_far_invn_invf.y;
	float	depth	= t_depth_render_target.SampleLevel( s_accumulator, I.tc, 0).x;

	return	( (-far)*near/( far - near))/( depth - far/( far - near));
}
