#include "common.h"

Texture2D	t_luminance;

struct v2p_quad
{
	float4	hpos	: SV_POSITION;
	float2	tc		: TEXCOORD0;
};

float4 main( v2p_quad I ) : SV_TARGET
{
	return	t_luminance.SampleLevel( s_accumulator, I.tc, 0 );
}
