////////////////////////////////////////////////////////////////////////////
//	Reconstructed 2026-08-18 from the shipped v0.100b blob - absent from the
//	recovered source drop. Byte-identity: python3 -m vostok.shaders roundtrip
//
//	The single-scattering precompute: a 256x128 offline integration whose
//	two targets are t_rayleigh_scattering and t_mie_scattering - the tables
//	atmosphere.ps, clouds.ps and atmospheric_scattering_on_geometry_add.ps
//	all read.  It is a small Bruneton, run once per weather change:
//
//	  * the pixel is a *direction*.  Its column is the polar angle from the
//	    zenith, 100 degrees over 256 texels (radians(100)/255, exact in the
//	    blob's 0x3BE0473A) - so the table runs ten degrees past the horizon;
//	    its row is the azimuth about the sun, pi over 128 (pi/127, exact in
//	    0x3CCAA525).  Only half the azimuth is stored because the sky is
//	    symmetric about the sun's meridian;
//	  * the camera stands at the north pole of a sphere of radius
//	    6356.7534 km with the *earth's centre at the origin*, and the view
//	    ray is intersected with the atmosphere shell (radius^2 41,629,640,
//	    i.e. 95.35 km of air) and marched in 20 steps;
//	  * at each step the transmittance is the exponential of the optical
//	    depth along two further rays, each marched 50 times: back to the
//	    camera, and out to the sun (re-intersecting the shell from the
//	    sample point).  1,000 inner samples per outer step, 20,000 per
//	    texel, in a 101-slot shader - which is why this runs into a texture
//	    rather than per frame;
//	  * density is a two-lane exponential of altitude, rayleigh and mie in
//	    x and y, and the extinction that turns depth into transmittance is
//	    the rayleigh emission colour scaled by 2*pi/10 (its three constants
//	    are exactly -0.6283185 times the output colour) plus a mie term of
//	    4*pi/1000, exact in 0x3C4DE32E.
//
//	==== the constants are literals here, and that is a finding ===========
//
//	Only three of the numbers have a closed form the blob confirms - pi/127,
//	radians(100)/255 and 4*pi/1000.  The rest do NOT fold from anything
//	tidy and are written as the shortest decimal that reproduces their bits:
//
//	  * the earth radius appears as TWO adjacent floats, 6356.7534
//	    (0x45C6A607, for the sphere centre and the ray intersection) and
//	    6356.7524 (0x45C6A605, for every altitude subtraction) - exactly one
//	    ULP apart, so the source really did carry two spellings a metre
//	    apart, not one constant;
//	  * 40408312 is NOT earth_radius squared: fxc folds that product to
//	    40408316.  It is its own literal;
//	  * the step weights 0.0005243768 and 0.00020975071 are 0.05 and 0.02
//	    over 95.351281, while the shell thickness implied by 41,629,640 is
//	    95.350115 - two different thicknesses, again not derivable from each
//	    other;
//	  * the density exponents are spelled through exp2, because the blob's
//	    -0.050434384 / -0.15130316 already carry log2(e) folded in and no
//	    exp(-h/H) spelling of a plausible H reproduces those bits.  Their
//	    ratio is exactly 3, and -0.15130316/log2(e) is exactly ten times the
//	    step weight's 1/95.351281, so the scale heights are one tenth and
//	    three tenths of that thickness - but the products round differently
//	    than any spelling of them does.  The one exp() left in the shader is
//	    the transmittance, whose argument is not constant, and it keeps its
//	    visible 1.442695 multiply.
//
//	==== two spellings that are load-bearing ==============================
//
//	The sun march accumulates as `sun_depth = sun_depth + exp2(...)` and the
//	view march as `view_depth += exp2(...)`; the two emit their add operands
//	in opposite orders, and swapping either breaks identity.  Likewise the
//	sun's contribution is added as `sun_term + optical_depth`, not
//	`optical_depth + sun_term` - fxc fuses the FIRST addend into the mad,
//	and the shipped mad's product is the sun term.
//
//	==== header finding ===================================================
//
//	The shipped dependency table names atmospheric_scattering_common.h after
//	common.h, and the tree has no such header, so to_sun_direction_parameter
//	and atmosphere_parameters are declared locally here - the same treatment
//	clouds.ps records.  atmospheric_scattering_on_geometry_add.ps names it
//	too (after gbuffer.h); god_rays_accumulate3.ps does not.
////////////////////////////////////////////////////////////////////////////

#include "common.h"

uniform float4	to_sun_direction_parameter;
uniform float4	atmosphere_parameters;

struct v2p_make_mie_rayleigh_texture
{
	float4	hpos	: SV_POSITION;
	float2	tc		: TEXCOORD0;
};

struct p_make_mie_rayleigh_texture
{
	float4	rayleigh	: SV_Target0;
	float4	mie			: SV_Target1;
};

void main( in v2p_make_mie_rayleigh_texture I, out p_make_mie_rayleigh_texture O )
{
	float2	angles			= ( float2( I.hpos.y, I.hpos.x) - 0.5f)*float2( 0.02473695f, 0.0068444284f);

	float3	direction		= normalize( float3(
								sin( angles.y)*cos( angles.x),
								cos( angles.y),
								sin( angles.y)*sin( angles.x)));

	float3	camera			= float3( 0.0f, 6356.7534f, 0.0f);

	float	projection		= -6356.7534f*direction.y;
	float	ray_length		= projection + sqrt( 41629640.0f - ( 40408312.0f - projection*projection));

	float2	ray_step		= ray_length*float2( 0.05f, 0.0005243768f);

	float3	position		= direction*ray_step.x*0.5f + camera;

	float3	rayleigh_extinction	= atmosphere_parameters.z*float3( -0.17599343f, -0.297612f, -0.61712825f);
	float	mie_extinction		= atmosphere_parameters.w*0.012566371f;

	float3	rayleigh_sum	= 0.0f;
	float3	mie_sum			= 0.0f;

	for (int i = 0; i < 20; i++)
	{
		float	altitude	= sqrt( dot( position, position)) - 6356.7524f;
		float2	density		= exp2( altitude*float2( -0.050434384f, -0.15130316f));

		density				= density*ray_step.y;

		float3	to_camera	= camera - position;
		float	view_length	= sqrt( dot( to_camera, to_camera));
		float3	view_ray	= to_camera/view_length;
		float2	view_step	= view_length*float2( 0.02f, 0.00020975071f);
		float3	view_sample	= view_ray*view_step.x*0.5f + position;

		float2	view_depth	= 0.0f;

		for (int j = 0; j < 50; j++)
		{
			float	h		= sqrt( dot( view_sample, view_sample)) - 6356.7524f;

			view_depth		+= exp2( h*float2( -0.050434384f, -0.15130316f));
			view_sample		= view_ray*view_step.x + view_sample;
		}

		float4	optical_depth	= float4( view_depth.xxx, view_depth.y)*view_step.y;

		float3	to_center	= -position;
		float	sun_project	= dot( to_center, to_sun_direction_parameter.xyz);
		float	sun_length	= sun_project + sqrt( 41629640.0f - ( dot( to_center, to_center) - sun_project*sun_project));
		float3	sun_ray		= sun_length*to_sun_direction_parameter.xyz;
		float	sun_travel	= sqrt( dot( sun_ray, sun_ray));

		sun_ray				= sun_ray/sun_travel;

		float2	sun_step	= sun_travel*float2( 0.02f, 0.00020975071f);
		float3	sun_sample	= sun_ray*sun_step.x*0.5f + position;

		float2	sun_depth	= 0.0f;

		for (int j = 0; j < 50; j++)
		{
			float	h		= sqrt( dot( sun_sample, sun_sample)) - 6356.7524f;

			sun_depth		= sun_depth + exp2( h*float2( -0.050434384f, -0.15130316f));
			sun_sample		= sun_ray*sun_step.x + sun_sample;
		}

		optical_depth		= float4( sun_depth.xxx, sun_depth.y)*sun_step.y + optical_depth;

		float3	transmittance	= exp( rayleigh_extinction*optical_depth.xyz - mie_extinction*optical_depth.w);

		rayleigh_sum		+= density.x*transmittance;
		mie_sum				+= density.y*transmittance;

		position			= direction*ray_step.x + position;
	}

	float3	rayleigh	= atmosphere_parameters.x*rayleigh_sum;
	float3	mie			= atmosphere_parameters.y*mie_sum;

	O.mie		= float4( mie*float3( 0.02871989f, 0.032069717f, 0.037377253f), 1.0f);
	O.rayleigh	= float4( rayleigh*float3( 0.28013024f, 0.47371158f, 0.98228836f), 1.0001f);
}
