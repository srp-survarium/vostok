#include "common.h"
#include "gbuffer.h"

struct v2p_accum_sun_mask
{
	float4	hpos		: SV_Position;
	float2	tc			: TEXCOORD0;
	float3	eye_ray		: TEXCOORD1;
};

float4 main( v2p_accum_sun_mask I ) : SV_Target
{
	// Ship writes an opaque mask unconditionally - the sun-mask test the
	// pre-ship revision performed is gone.
	return	float4( 1.0f, 1.0f, 1.0f, 1.0f);
}
