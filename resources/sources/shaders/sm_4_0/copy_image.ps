#include "common.h"
#include "gamma_correction.h"

uniform float gamma_correction_factor;

float4 main( v2p_TL vin) : SV_TARGET
{
	float4 color = t_base.Sample( s_accumulator, vin.Tex0);

	return float4( convert_from_linear_space( color.xyz, gamma_correction_factor), 1.0f);
}
