#include "common.h"
#include "gbuffer.h"
#include "gamma_correction.h"

Texture2D t_frame_color1;

struct v2p_gather
{
	float4	hpos	: SV_POSITION;
	float2	tc		: TEXCOORD0;
};

float4 main( v2p_gather vin) : SV_TARGET
{
	float average_result_luminance	= 0.0f;
	float min_result_luminance 		= pow(2, 31);
	float max_result_luminance		= -pow(2, 31);

	[unroll] for(int y=-1; y<1; y++)
	[unroll] for(int x=-1; x<1; x++)
	{
		average_result_luminance 	+= t_frame_color1.Sample(s_position, vin.tc, int2(x,y)).r;
		min_result_luminance  		=  min(min_result_luminance, t_frame_color1.Sample(s_position, vin.tc, int2(x,y)).g);
		max_result_luminance  		=  max(max_result_luminance, t_frame_color1.Sample(s_position, vin.tc, int2(x,y)).b);
	}

	return							float4( average_result_luminance/65536.0f, min_result_luminance, max_result_luminance, 0 );
}
