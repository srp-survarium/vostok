////////////////////////////////////////////////////////////////////////////
//	Reconstructed 2026-08-17 from the shipped v0.100b blob
//	(shaders/sm_4_0/ssao_filter_upsample.ps, plain permutation) - the file
//	was absent from the recovered source drop. Byte-identity against the
//	blob is the acceptance test:
//	python3 -m vostok.shaders roundtrip ssao_filter_upsample.ps
//
//	CLOSED 2026-08-18, byte-identical (was 2096 against ship's 2124).  The
//	residual was one `max r0.x, r0.y, l(0.0)` after the ao_sum/total_weight
//	divide: fxc 9.29 removes max(a/b, 0) once it can prove a >= 0 and b >= 0,
//	and with `weight = 1.f - saturate(...)` it can.  Roughly 70 spellings of
//	max(), of the ratio, of the accumulators and of the branch were tried
//	against that prover and every one of them folded.  The answer was not in
//	the max at all - it is the WEIGHT's clamp:
//
//	    weight = clamp( 1.f - saturate( range ), 0.f, 1.f)
//
//	**`saturate(x)` and `clamp(x, 0.f, 1.f)` emit the same `_sat` and are NOT
//	interchangeable to fxc's non-negativity prover.**  Written as
//	`saturate( 1.f - saturate( range))` the outer clamp is a saturate NODE,
//	the prover reads [0,1] off it, and the max folds (2096).  Written as
//	`clamp(...)` - or `min(max(...,0.f),1.f)` - the pair is fused straight
//	into the producing instruction's `_sat` destination modifier without ever
//	becoming a saturate node, the prover is blind to it, and the max survives.
//	Every member of that family compiles byte-identically here:
//	clamp/min-max on the outside over saturate/clamp/min-max on the inside;
//	only an outer `saturate()` folds.  The position matters too: the INNER
//	clamp has to sit on the ratio (that is ship's `div_sat`) and the OUTER one
//	on `1.f - ratio` (that is what stays opaque).  Swap them - clamp the ratio
//	only - and the max folds; drop the inner one and the `_sat` moves from the
//	div to the add.
//
//	Measurements that framed it, kept because they are the cheap probes:
//	dropping ONLY ao's saturate keeps the max and costs exactly the mov_sat
//	(2104 = 2124 - 20); dropping ONLY the weight's saturate keeps the max at
//	ship's exact size (2124) with `div` where ship has `div_sat`.  So the
//	proof needs both operands, and a lever exists on either side; only the
//	weight side has one that is free.
//	Tried and folded, for the record: statement order and `+=` vs `a = b + a`
//	for both accumulators; the max written max(0,x), `x > 0 ? x : 0`,
//	`x >= 0 ? x : 0`, `x < 0 ? 0 : x`, on a named ratio, through
//	asfloat(asuint()) and asfloat(asint()), against a local, a `static const`
//	zero, `asfloat(0u)`, an icb element and -0.f; `precise` on the ratio, on
//	ao, on the weight (2132) and on the sums (2152); the sums as float2
//	components, a struct, `(filter_sums)0`, an initialiser list, a float
//	array, half, file-scope statics, a by-value `add_tap` helper and an
//	`inout` one, and a helper returning the whole struct; the resolve in a
//	helper and behind an `out` parameter; the loop as while, with [loop],
//	uint-counted, with the counter hoisted; `[branch]` on the if, the if's
//	operands swapped, `!=` with the bodies swapped, the result initialised
//	before the if; the offsets at file scope; `void main` with an `out`
//	parameter.  Sinking the max below the endif does keep it - fxc cannot
//	prove the centre-tap branch non-negative - but fuses it into the output
//	write as `max o0.x, r0.x, l(0)` (2104).  The same fix closes
//	ssao_filter_upsample_temporal.ps, which shares this loop.
////////////////////////////////////////////////////////////////////////////

#include "common.h"
#include "gbuffer.h"
#include "filters.h"

Texture2D	t_ssao_accumulator;

struct filter_sums
{
	float	total_weight;
	float	ao_sum;
};

struct v2p_ssao_filter_upsample
{
	float4	hpos	: SV_POSITION;
	float2	tc		: TEXCOORD0;
};

float2 main( v2p_ssao_filter_upsample I ) : SV_Target
{
	static const float2 offsets[9] =
	{
		float2(  1.0f,  1.0f),
		float2(  1.0f,  0.0f),
		float2(  1.0f, -1.0f),
		float2(  0.0f,  1.0f),
		float2(  0.0f, -1.0f),
		float2( -1.0f,  1.0f),
		float2( -1.0f,  0.0f),
		float2( -1.0f, -1.0f),
		float2(  0.0f,  0.0f)
	};

	float	center_depth	= gbuffer_read_frame_depth( I.tc);
	float2	half_res		= screen_res.xy*0.5f;
	filter_sums	sums;
	sums.total_weight	= 0.f;
	sums.ao_sum			= 0.f;

	for (int i = 0; i < 9; i++)
	{
		float2	tc			= offsets[i]/half_res + I.tc;
		float2	value		= t_ssao_accumulator.SampleLevel( s_linear, tc, 0).xy;
		float	ao			= saturate( value.x);
		float	depth		= value.y*0.01f;
		float	weight		= clamp( 1.f - saturate( ( center_depth*0.01f - depth)/( depth*0.01f)), 0.f, 1.f);

		sums.total_weight	+= weight;
		sums.ao_sum			+= ao*weight;
	}

	float	result;
	if (sums.ao_sum == sums.total_weight)
		result				= t_ssao_accumulator.SampleLevel( s_linear, I.tc, 0).x*0.5f;
	else
		result				= max( sums.ao_sum/sums.total_weight, 0.f);

	return	float2( result, 0.f);
}
