#include "common.h"
#include "gbuffer.h"
#include "filters.h"

Texture2D	t_ssao_accumulator;

struct filter_sums
{
	float	total_weight;
	float	ao_sum;
};

struct v2p_ssao_filter_upsample
{
	float4	hpos	: SV_POSITION;
	float2	tc		: TEXCOORD0;
};

float2 main( v2p_ssao_filter_upsample I ) : SV_Target
{
	static const float2 offsets[9] =
	{
		float2(  1.0f,  1.0f),
		float2(  1.0f,  0.0f),
		float2(  1.0f, -1.0f),
		float2(  0.0f,  1.0f),
		float2(  0.0f, -1.0f),
		float2( -1.0f,  1.0f),
		float2( -1.0f,  0.0f),
		float2( -1.0f, -1.0f),
		float2(  0.0f,  0.0f)
	};

	float	center_depth	= gbuffer_read_frame_depth( I.tc);
	float2	half_res		= screen_res.xy*0.5f;
	filter_sums	sums;
	sums.total_weight	= 0.f;
	sums.ao_sum			= 0.f;

	for (int i = 0; i < 9; i++)
	{
		float2	tc			= offsets[i]/half_res + I.tc;
		float2	value		= t_ssao_accumulator.SampleLevel( s_linear, tc, 0).xy;
		float	ao			= saturate( value.x);
		float	depth		= value.y*0.01f;
		float	weight		= clamp( 1.f - saturate( ( center_depth*0.01f - depth)/( depth*0.01f)), 0.f, 1.f);

		sums.total_weight	+= weight;
		sums.ao_sum			+= ao*weight;
	}

	float	result;
	if (sums.ao_sum == sums.total_weight)
		result				= t_ssao_accumulator.SampleLevel( s_linear, I.tc, 0).x*0.5f;
	else
		result				= max( sums.ao_sum/sums.total_weight, 0.f);

	return	float2( result, 0.f);
}
