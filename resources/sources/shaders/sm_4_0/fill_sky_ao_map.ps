#include "common.h"
#include "gbuffer.h"

Texture2D			t_sao_map_texture;

struct pixel_shader_input
{
	float4	position	: SV_POSITION;
	float2	uv			: TEXCOORD0;
};

float4 main( pixel_shader_input input ) : SV_Target
{
	float	height			=
		saturate(
			t_sao_map_texture.Sample( s_linear, input.uv, 0).x*0.000001f +
			gbuffer_read_frame_depth( input.uv)/512.f
		);

	int		packed			= height*255.f*255.f*255.f;

	return	float4(
		(float)( packed & 255)/255.f,
		(float)(( packed >> 8) & 255)/255.f,
		(float)( packed >> 16)/255.f,
		0.f
	);
}
