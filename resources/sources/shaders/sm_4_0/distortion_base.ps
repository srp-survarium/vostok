// CLOSED 2026-08-18 (third pass): 15/15 byte-identical, and 15/15 for
// distortion_panner.ps with the same one-line change.
//
// The whole residual was the order of the two output multiplies:
//
//	mul r0.y, r0.y, cb0[1].y	; dist.y * distortion_scale.y
//	mul o0.y, r0.y, l(-1.000000)	; ship emits the flip FIRST ...
//	mul o0.x, r0.x, cb0[1].x	; ... and the x scale after it
//
// The first two passes wrote the flip as a lane of a MIXED cbuffer/literal
// scale vector - `float2(dist.x, dist.y*sy) * float2(sx, -1.0f)`. That
// reaches ship's exact instructions but always transposed, and the reason is
// now measured rather than guessed: **when fxc splits a mixed
// cbuffer/immediate vector multiply into per-lane scalars it emits the
// cbuffer-operand lane first and the immediate lane second, whatever the
// destination lanes are.** Put the -1 in lane x and the cb scale in lane y and
// the emission flips with it (`mul o0.y, r0.x, cb0[1].x` before
// `mul o0.x, r0.y, l(-1)`), which is what proved the rule and proved the
// mixed vector could never produce ship's order.
//
// The fix is to keep the flip out of the scale multiply entirely: apply it as
// its own `float2(1.0f, -1.0f)` on the remapped vector and let the scale
// follow. Then
//
//   * the flip's x lane is 1.0f, so that half folds away and what is left is a
//     one-lane immediate multiply - a separate DAG node, not a split lane;
//   * fxc reassociates it to the TAIL of the y chain, so the y store is two
//     deep (scale, then flip) while the x store is one deep;
//   * a store whose chain is still unfinished cannot be emitted, so the y
//     chain runs to completion first and x follows. Same mechanism as
//     copy_image.vs and fill_sky_ao_map.ps, which ship the same y-before-x
//     order and round-trip today.
//
// Note the flip must be written BEFORE the scale in the source even though it
// lands after it in the output: `(dist * float2(1,-1)) * distortion_scale.xy`
// is ship, `(dist * distortion_scale.xy) * float2(1,-1)` is 1,036 bytes with
// both lanes fused into one `mul o0.xy, r0.xyxx, l(1,-1,0,0)`.
//
// Rules established on the way, all measured against the shipped blobs and
// worth keeping - they explain why ~120 earlier spellings failed:
//
//   1. A SCALAR `x * -1.0f` is always folded into a neg modifier
//      (`mov o0.y, -r0.y`), whatever the spelling. The literal survives only
//      when the -1 is a lane of a multi-lane vector multiply.
//   2. A masked write to o0 keeps its multiply a vector op (and so keeps the
//      -1, or keeps the x scale from merging) only if the write owns lane w,
//      or its constant vector has at least two NON-TRIVIAL lanes - a lane
//      multiplied by 1.0f folds away and the write collapses to a scalar.
//      Over all 32 (x-mask, y-mask) pairs of {x,xz,xw,xzw} x {y,yz,yw,yzw}:
//      1,040 bytes when neither survives, 1,044 when only the flip does,
//      1,052 when only the x scale does, 1,056 when both.
//   3. Two plain scalar scale muls ALWAYS merge into
//      `mul r0.xy, r0.xyxx, cb0[1].xyxx`, and fxc will re-swizzle the mad
//      (`r0.yxyy`) to make the merge fit. Nothing algebraic breaks it: swapped
//      operands, `dot()` with a zero lane, `mad(x,s,0)`, `lerp(0,x,s)`,
//      `mul()`, `mul(float1x1,float1x1)`, `x*s+0`, `.xx` splats, `dot3`, an
//      in-place `*=`, a hoisted temp, or separating the statements. Only an
//      opaque op breaks it, and every opaque op costs an instruction.
//   4. STATEMENT ORDER IS INERT. Measured over all 18 disjoint mask
//      assignments x both orders in pass three: every pair compiled to
//      identical bytes. fxc rebuilds the IR canonically, so the emission order
//      is a pure function of the DAG. `precise`, an `[unroll]` loop running
//      the lanes backwards, a pre-assembled local float4 with y assigned
//      first, `out` parameters, a helper function, permuted write masks
//      (`.yxz`, `.zyx`, `.yzx`, `.yx` - HLSL normalises them) and swizzling
//      the product out (`f.yxzw`) are all inert for the same reason. The one
//      real declaration-order lever is the output struct's MEMBER order, which
//      hoists `mov o1` - between two lanes of one register there is none.
//   5. What is NOT inert is chain depth: give the x lane two extra multiplies
//      and its store moves after the y store immediately. Depth is the only
//      lever that was ever going to work, which is what the fix uses.
//
// First pass's tried-list, still valid, and all of it now explained by rule 1.
// Every scalar spelling of the flip folds: `* -1.0f`, `-1.0f *`, `-(x)`,
// `* -1`, `/ -1.0f`, `*= -1.0f`, `lerp(0,x,-1)`, `mad(x,-1,0)`, `x * -1 + 0`,
// `0 - x`, `mul(x,-1.0f)`, `mul(float1x1(-1),x)`, `* sign(-1.0f)`,
// `* -sqrt(1.0f)`, `* cos(pi)`, `* -exp2(0)`, `* -rsqrt(1)`, `* -abs(1)`,
// `* -floor(1.9)`, `* -normalize(1)`, `* asfloat(0xbf800000)`, a `float1` or
// `vector<float,1>` factor, `precise`, `half`, a one-iteration `[unroll]`
// loop, a `const float2`/`const float[2]`/`static` lane, and the same flip
// inside a helper taking the value by value, by inout or by out.
//
// Distributing the flip into the *2-1 remap does not work either and is worth
// recording so it is not retried: `(1 - raw.y*2) * sy` and `raw.y*-2 + 1`
// fold the sign into the mad (`mad r0.y, -r0.y, l(2), l(1)`) and lose the
// separate flip entirely, and `-(d.y * sy)` folds to `mov o0.y, -r0.y`.
//
// Fixed on the way there, and it affects every file carrying this dispatch:
// CONFIG_VERTEX_INPUT_TYPE 12 was falling into the null branch and inheriting
// its planar tc. It has its own branch below - ship leaves tc at zero for
// type 12 and planar-maps it only for type 0. The old code cost the same
// number of bytes as the right code, so the size-only check missed it.
#include "common.h"
#include "gbuffer.h"
#include "material.h"
// ship vertex-input dispatch (vertex_input.h in the tree is drifted; this
// block is the byte-proven ship mapping, same as the editor family)
#if CONFIG_VERTEX_INPUT_TYPE==7 || CONFIG_VERTEX_INPUT_TYPE==8
#	include "particle_vertex_input.h"
#elif CONFIG_VERTEX_INPUT_TYPE==9
#	include "particle_beamtrail_vertex_input.h"
#elif CONFIG_VERTEX_INPUT_TYPE==10
#	include "decal_vertex_input.h"
#elif CONFIG_VERTEX_INPUT_TYPE==13
#	include "wires_vertex_input.h"
#elif CONFIG_VERTEX_INPUT_TYPE==1 || CONFIG_VERTEX_INPUT_TYPE==2

// ship static_mesh_vertex_input.h
struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float3	tbn_x				: TEXCOORD1;
	float3	tbn_y				: TEXCOORD2;
	float3	tbn_z				: TEXCOORD3;
	float3	view_position		: TEXCOORD4;
	float2	tc					: TEXCOORD5;
#if CONFIG_VERTEX_INPUT_TYPE==2
	float3	color				: TEXCOORD6;
	float	occlusion			: TEXCOORD7;
#endif // #if CONFIG_VERTEX_INPUT_TYPE==2
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);

	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(input.view_position, 1.0f);
	parameters.tc 						= input.tc;
	parameters.detail_tc 				= input.tc;
	parameters.tangent_to_viewspace 	= float3x3( input.tbn_x, input.tbn_y, input.tbn_z);

	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE>=3 && CONFIG_VERTEX_INPUT_TYPE<=6

// ship skeleton_{4,3,2,1}_bones_mesh_vertex_input.h (one shared output)
struct vertex_output_struct
{
	float3	tbn_x				: TEXCOORD0;
	float3	tbn_y				: TEXCOORD1;
	float3	tbn_z				: TEXCOORD2;
	float4  homogeneous_position: SV_Position;
	float3	view_position		: TEXCOORD3;
	float3	position			: TEXCOORD4;
	float3	prev_position		: TEXCOORD5;
	float2	tc					: TEXCOORD6;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);

	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(input.view_position, 1.0f);
	parameters.tc 						= input.tc;
	parameters.detail_tc 				= input.tc;
	parameters.tangent_to_viewspace 	= float3x3( input.tbn_x, input.tbn_y, input.tbn_z);

	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE==11

// ship grassmesh_vertex_input.h
float4 patch_parameters;

struct vertex_output_struct
{
	float3	tbn_x				: TEXCOORD0;
	float3	tbn_y				: TEXCOORD1;
	float3	tbn_z				: TEXCOORD2;
	float4	color				: TEXCOORD3;
	float4  homogeneous_position: SV_Position;
	float4	params				: TEXCOORD4;
	float3	view_position		: TEXCOORD5;
	float3	position			: TEXCOORD6;
	float2	tc					: TEXCOORD7;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);

	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(input.view_position, 1.0f);
	parameters.tc 						= input.tc;
	parameters.detail_tc 				= input.tc;
	parameters.tangent_to_viewspace 	= float3x3( input.tbn_x, input.tbn_y, input.tbn_z);
	parameters.color					= input.color;

	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE==14

// ship user_vertex_input.h
struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float2	tc					: TEXCOORD1;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);

	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(mul(m_V, float4( input.position, 1.f)), 1.0f);
	parameters.tc 						= input.tc;
	parameters.detail_tc 				= input.tc;

	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE==12

// ship: the same interpolants as the null input - SV_Position plus a float3
// position at TEXCOORD0 - but the tc is NOT planar-mapped. The shipped VIT-12
// blob samples t_base at l(0.000000, 0.000000, 0.000000, 0.000000) and leaves
// TEXCOORD0 unused, where the VIT-0 blob samples v1.xz; so this type leaves
// parameters.tc at the clear_material_parameters zero. (What it does with
// world_position / world_view_position is invisible to these two shaders -
// both are unread here - so those lines are carried over from the null case.)
struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);

	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(mul(m_V, float4( input.position, 1.f)), 1.0f);

	return parameters;
}

#else // NULL_VERTEX_INPUT_TYPE

// ship null_mesh_vertex_input.h: no tc interpolator; tc is planar-mapped
// from the world position (the blobs read position.xz)
struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);

	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(mul(m_V, float4( input.position, 1.f)), 1.0f);
	parameters.tc 						= input.position.xz;

	return parameters;
}

#endif

uniform float3 distortion_scale;

struct pixel_output_struct
{
	float4	distortion	: SV_Target0;
	float4	alpha		: SV_Target1;
};

pixel_output_struct	main	(in vertex_output_struct input)
{
	material_parameters parameters = get_material_parameters(input);
	fill_material_parameters(parameters);

	float2 dist_vector 	= t_base.Sample(s_linear, parameters.tc).xy*2.0f - 1.0f;
	pixel_output_struct output;
	output.distortion.xy = (dist_vector * float2(1.0f, -1.0f)) * distortion_scale.xy;
	output.distortion.zw = float2(1.0f, 0.0f);
	output.alpha		= float4(1.0f, 1.0f, 1.0f, 1.0f);

	return output;
}
