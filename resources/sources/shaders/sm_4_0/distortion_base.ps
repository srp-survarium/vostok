// PARKED 2026-08-17 one instruction-shape from byte-identity: ship scales
// dist_vector.y with a SCALAR mul then multiplies by a LITERAL -1.0 into
// o0.y, and scales .x directly into o0.x; every source shape tried
// (constructor, per-member writes in both orders, partial component
// reassignment, compound *= -1, /-1.0f, lerp(0,v,-1) at several depths)
// vectorizes the two scale muls and folds the -1 into a neg modifier.
// Dispatch and semantics are ship-proven; only that split differs.
#include "common.h"
#include "gbuffer.h"
#include "material.h"
// ship vertex-input dispatch (vertex_input.h in the tree is drifted; this
// block is the byte-proven ship mapping, same as the editor family)
#if CONFIG_VERTEX_INPUT_TYPE==7 || CONFIG_VERTEX_INPUT_TYPE==8
#	include "particle_vertex_input.h"
#elif CONFIG_VERTEX_INPUT_TYPE==9
#	include "particle_beamtrail_vertex_input.h"
#elif CONFIG_VERTEX_INPUT_TYPE==10
#	include "decal_vertex_input.h"
#elif CONFIG_VERTEX_INPUT_TYPE==13
#	include "wires_vertex_input.h"
#elif CONFIG_VERTEX_INPUT_TYPE==1 || CONFIG_VERTEX_INPUT_TYPE==2

// ship static_mesh_vertex_input.h
struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float3	tbn_x				: TEXCOORD1;
	float3	tbn_y				: TEXCOORD2;
	float3	tbn_z				: TEXCOORD3;
	float3	view_position		: TEXCOORD4;
	float2	tc					: TEXCOORD5;
#if CONFIG_VERTEX_INPUT_TYPE==2
	float3	color				: TEXCOORD6;
	float	occlusion			: TEXCOORD7;
#endif // #if CONFIG_VERTEX_INPUT_TYPE==2
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);

	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(input.view_position, 1.0f);
	parameters.tc 						= input.tc;
	parameters.detail_tc 				= input.tc;
	parameters.tangent_to_viewspace 	= float3x3( input.tbn_x, input.tbn_y, input.tbn_z);

	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE>=3 && CONFIG_VERTEX_INPUT_TYPE<=6

// ship skeleton_{4,3,2,1}_bones_mesh_vertex_input.h (one shared output)
struct vertex_output_struct
{
	float3	tbn_x				: TEXCOORD0;
	float3	tbn_y				: TEXCOORD1;
	float3	tbn_z				: TEXCOORD2;
	float4  homogeneous_position: SV_Position;
	float3	view_position		: TEXCOORD3;
	float3	position			: TEXCOORD4;
	float3	prev_position		: TEXCOORD5;
	float2	tc					: TEXCOORD6;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);

	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(input.view_position, 1.0f);
	parameters.tc 						= input.tc;
	parameters.detail_tc 				= input.tc;
	parameters.tangent_to_viewspace 	= float3x3( input.tbn_x, input.tbn_y, input.tbn_z);

	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE==11

// ship grassmesh_vertex_input.h
float4 patch_parameters;

struct vertex_output_struct
{
	float3	tbn_x				: TEXCOORD0;
	float3	tbn_y				: TEXCOORD1;
	float3	tbn_z				: TEXCOORD2;
	float4	color				: TEXCOORD3;
	float4  homogeneous_position: SV_Position;
	float4	params				: TEXCOORD4;
	float3	view_position		: TEXCOORD5;
	float3	position			: TEXCOORD6;
	float2	tc					: TEXCOORD7;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);

	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(input.view_position, 1.0f);
	parameters.tc 						= input.tc;
	parameters.detail_tc 				= input.tc;
	parameters.tangent_to_viewspace 	= float3x3( input.tbn_x, input.tbn_y, input.tbn_z);
	parameters.color					= input.color;

	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE==14

// ship user_vertex_input.h
struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float2	tc					: TEXCOORD1;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);

	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(mul(m_V, float4( input.position, 1.f)), 1.0f);
	parameters.tc 						= input.tc;
	parameters.detail_tc 				= input.tc;

	return parameters;
}

#else // NULL_VERTEX_INPUT_TYPE

// ship null_mesh_vertex_input.h: no tc interpolator; tc is planar-mapped
// from the world position (the blobs read position.xz)
struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);

	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(mul(m_V, float4( input.position, 1.f)), 1.0f);
	parameters.tc 						= input.position.xz;

	return parameters;
}

#endif

uniform float3 distortion_scale;

struct pixel_output_struct
{
	float4	distortion	: SV_Target0;
	float4	alpha		: SV_Target1;
};

pixel_output_struct	main	(in vertex_output_struct input)
{
	material_parameters parameters = get_material_parameters(input);
	fill_material_parameters(parameters);

	float2 dist_vector 	= t_base.Sample(s_linear, parameters.tc).xy*2.0f - 1.0f;
	pixel_output_struct output;
	output.distortion = float4(dist_vector.x*distortion_scale.x, lerp(0.0f, dist_vector.y*distortion_scale.y, -1.0f), 1.0f, 0.0f);
	output.alpha		= float4(1.0f, 1.0f, 1.0f, 1.0f);

	return output;
}
