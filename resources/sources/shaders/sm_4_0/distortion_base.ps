// PARKED 2026-08-18 (second pass). Every one of the 15 permutations now
// compiles to the shipped BYTE LENGTH, with the shipped instructions, and
// differs from ship only by two adjacent instructions being transposed:
//
//	mul r0.y, r0.y, cb0[1].y	; dist.y * distortion_scale.y
//	mul o0.y, r0.y, l(-1.000000)	; ship emits the flip here ...
//	mul o0.x, r0.x, cb0[1].x	; ... and the x scale after it
//
// We emit `mul o0.x` first and `mul o0.y` second. Nothing else differs, in any
// permutation: same opcodes, same registers, same literals, same signatures,
// same RDEF (spot-checked on VIT 0, 8, 11, 12; `roundtrip` reports "first
// mismatch at +4" - the container checksum - for all 15, so the lengths agree).
// `mul ..., l(-1.000000)` appears in no other shipped blob: only here and in
// distortion_panner.ps.
//
// What the second pass measured, all against the shipped blobs:
//
//   1. A SCALAR `x * -1.0f` is always folded into a neg modifier
//      (`mov o0.y, -r0.y`), whatever the spelling - see the first pass's list
//      at the bottom, and copy_image.vs, which ships that fold from the same
//      `(...)*-1` idiom. The literal survives only when the -1 is a lane of a
//      MULTI-LANE vector multiply that lives until fxc's late per-lane split.
//   2. A masked write to o0 keeps its multiply a vector op (and so keeps the
//      -1, or keeps the x scale from merging) only if the write owns lane w,
//      or its constant vector has at least two NON-TRIVIAL lanes - a lane
//      multiplied by 1.0f folds away and the write collapses to a scalar.
//      Measured over all 32 (x-mask, y-mask) pairs of {x,xz,xw,xzw} x
//      {y,yz,yw,yzw} in both statement orders: 1,040 bytes when neither
//      survives, 1,044 when only the flip does, 1,052 when only the x scale
//      does. This is the sharp form of the first pass's "five of four lanes":
//      lane w is one resource and both halves wanted it.
//   3. Two plain scalar scale muls ALWAYS merge into
//      `mul r0.xy, r0.xyxx, cb0[1].xyxx` - they are lane-aligned, and nothing
//      tried breaks that: mismatched operand order between the two, `precise`
//      (which only splits the mad into mul+add, costing an instruction),
//      scalar-times-float3 spellings, a hoisted temp, an in-place
//      `dist_vector.y *= distortion_scale.y`, separating the two statements
//      with the alpha or the zw write, or parking the x product in a dead lane
//      of the y write.
//   4. Giving BOTH writes a live multiplier DOES reach the shipped size with
//      ship's exact instructions. Two ways: one mixed cbuffer/literal scale
//      vector (what this file now does), or two separate writes whose spare
//      lanes carry non-trivial constants, e.g. `.xz = float2(dist.x, 0.5f) *
//      float2(distortion_scale.x, 2.0f)` beside `.yw = float2(y, 1.0f) *
//      float2(-1.0f, 0.0f)`. Both land on 1,056 with the pair transposed.
//   5. fxc emits the lanes of an o0 store in x,y,z,w order, and that is what
//      leaves the two muls transposed. It did not move for any of: permuted
//      write masks (`.yxz`, `.zyx`, `.yzx`, `.yx` - HLSL normalises them),
//      either statement order, the alpha written before/between/after, the
//      output struct's members declared in the other order (which DOES hoist
//      `mov o1` to the top - declaration order is a scheduling lever, just not
//      between two lanes of one register), `out` parameters instead of a
//      returned struct, a local float4 assembled first, a helper function
//      returning the packed vector, or swizzling the product out (`f.yxzw`).
//
// So the open question is narrow: what makes fxc schedule the o0.y lane of a
// store before the o0.x lane? Ship proves it can - `fill_sky_ao_map.ps` writes
// o0.y, o0.z, o0.x, o0.w in that order, and `copy_image.vs` emits its whole y
// chain before its x chain from source that writes x first - but in both of
// those the lanes carry multi-instruction chains that cannot be vectorised
// (dp2 with splat swizzles; integer unpacks), so the scheduler orders them by
// chain instead of by lane. Here each lane is one mul and the tie breaks the
// other way. Probes that replace the flip with `* 3.0f` or
// `* distortion_scale.z` reproduce the same transposition, so this is
// scheduling, not the -1: solve the order and the -1 is already solved.
//
// First pass's tried-list, still valid. Every scalar spelling of the flip
// folds: `* -1.0f`, `-1.0f *`, `-(x)`, `* -1`, `/ -1.0f`, `*= -1.0f`,
// `lerp(0,x,-1)`, `mad(x,-1,0)`, `x * -1 + 0`, `0 - x`, `mul(x,-1.0f)`,
// `mul(float1x1(-1),x)`, `* sign(-1.0f)`, `* -sqrt(1.0f)`, `* cos(pi)`,
// `* -exp2(0)`, `* -rsqrt(1)`, `* -abs(1)`, `* -floor(1.9)`,
// `* -normalize(1)`, `* asfloat(0xbf800000)`, a `float1` or
// `vector<float,1>` factor, `precise`, `half`, a one-iteration `[unroll]`
// loop, a `const float2`/`const float[2]`/`static` lane, and the same flip
// inside a helper taking the value by value, by inout or by out.
//
// Everything else in this file is byte-exact for all 15 permutations - the
// vertex-input dispatch, the cbuffer layout, the signatures, the sample, the
// *2-1 remap, the zw constants and the second render target.
//
// Fixed on the way there, and it affects every file carrying this dispatch:
// CONFIG_VERTEX_INPUT_TYPE 12 was falling into the null branch and inheriting
// its planar tc. It has its own branch below - ship leaves tc at zero for
// type 12 and planar-maps it only for type 0. The old code cost the same
// number of bytes as the right code, so the size-only check missed it.
#include "common.h"
#include "gbuffer.h"
#include "material.h"
// ship vertex-input dispatch (vertex_input.h in the tree is drifted; this
// block is the byte-proven ship mapping, same as the editor family)
#if CONFIG_VERTEX_INPUT_TYPE==7 || CONFIG_VERTEX_INPUT_TYPE==8
#	include "particle_vertex_input.h"
#elif CONFIG_VERTEX_INPUT_TYPE==9
#	include "particle_beamtrail_vertex_input.h"
#elif CONFIG_VERTEX_INPUT_TYPE==10
#	include "decal_vertex_input.h"
#elif CONFIG_VERTEX_INPUT_TYPE==13
#	include "wires_vertex_input.h"
#elif CONFIG_VERTEX_INPUT_TYPE==1 || CONFIG_VERTEX_INPUT_TYPE==2

// ship static_mesh_vertex_input.h
struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float3	tbn_x				: TEXCOORD1;
	float3	tbn_y				: TEXCOORD2;
	float3	tbn_z				: TEXCOORD3;
	float3	view_position		: TEXCOORD4;
	float2	tc					: TEXCOORD5;
#if CONFIG_VERTEX_INPUT_TYPE==2
	float3	color				: TEXCOORD6;
	float	occlusion			: TEXCOORD7;
#endif // #if CONFIG_VERTEX_INPUT_TYPE==2
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);

	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(input.view_position, 1.0f);
	parameters.tc 						= input.tc;
	parameters.detail_tc 				= input.tc;
	parameters.tangent_to_viewspace 	= float3x3( input.tbn_x, input.tbn_y, input.tbn_z);

	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE>=3 && CONFIG_VERTEX_INPUT_TYPE<=6

// ship skeleton_{4,3,2,1}_bones_mesh_vertex_input.h (one shared output)
struct vertex_output_struct
{
	float3	tbn_x				: TEXCOORD0;
	float3	tbn_y				: TEXCOORD1;
	float3	tbn_z				: TEXCOORD2;
	float4  homogeneous_position: SV_Position;
	float3	view_position		: TEXCOORD3;
	float3	position			: TEXCOORD4;
	float3	prev_position		: TEXCOORD5;
	float2	tc					: TEXCOORD6;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);

	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(input.view_position, 1.0f);
	parameters.tc 						= input.tc;
	parameters.detail_tc 				= input.tc;
	parameters.tangent_to_viewspace 	= float3x3( input.tbn_x, input.tbn_y, input.tbn_z);

	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE==11

// ship grassmesh_vertex_input.h
float4 patch_parameters;

struct vertex_output_struct
{
	float3	tbn_x				: TEXCOORD0;
	float3	tbn_y				: TEXCOORD1;
	float3	tbn_z				: TEXCOORD2;
	float4	color				: TEXCOORD3;
	float4  homogeneous_position: SV_Position;
	float4	params				: TEXCOORD4;
	float3	view_position		: TEXCOORD5;
	float3	position			: TEXCOORD6;
	float2	tc					: TEXCOORD7;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);

	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(input.view_position, 1.0f);
	parameters.tc 						= input.tc;
	parameters.detail_tc 				= input.tc;
	parameters.tangent_to_viewspace 	= float3x3( input.tbn_x, input.tbn_y, input.tbn_z);
	parameters.color					= input.color;

	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE==14

// ship user_vertex_input.h
struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
	float2	tc					: TEXCOORD1;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);

	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(mul(m_V, float4( input.position, 1.f)), 1.0f);
	parameters.tc 						= input.tc;
	parameters.detail_tc 				= input.tc;

	return parameters;
}

#elif CONFIG_VERTEX_INPUT_TYPE==12

// ship: the same interpolants as the null input - SV_Position plus a float3
// position at TEXCOORD0 - but the tc is NOT planar-mapped. The shipped VIT-12
// blob samples t_base at l(0.000000, 0.000000, 0.000000, 0.000000) and leaves
// TEXCOORD0 unused, where the VIT-0 blob samples v1.xz; so this type leaves
// parameters.tc at the clear_material_parameters zero. (What it does with
// world_position / world_view_position is invisible to these two shaders -
// both are unread here - so those lines are carried over from the null case.)
struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);

	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(mul(m_V, float4( input.position, 1.f)), 1.0f);

	return parameters;
}

#else // NULL_VERTEX_INPUT_TYPE

// ship null_mesh_vertex_input.h: no tc interpolator; tc is planar-mapped
// from the world position (the blobs read position.xz)
struct vertex_output_struct
{
	float4  homogeneous_position: SV_Position;
	float3	position			: TEXCOORD0;
};

material_parameters get_material_parameters(inout vertex_output_struct input)
{
	material_parameters 				parameters;
	clear_material_parameters			(parameters);

	parameters.world_position			= input.position;
	parameters.world_view_position 		= float4(mul(m_V, float4( input.position, 1.f)), 1.0f);
	parameters.tc 						= input.position.xz;

	return parameters;
}

#endif

uniform float3 distortion_scale;

struct pixel_output_struct
{
	float4	distortion	: SV_Target0;
	float4	alpha		: SV_Target1;
};

pixel_output_struct	main	(in vertex_output_struct input)
{
	material_parameters parameters = get_material_parameters(input);
	fill_material_parameters(parameters);

	float2 dist_vector 	= t_base.Sample(s_linear, parameters.tc).xy*2.0f - 1.0f;
	pixel_output_struct output;
	output.distortion.xy = float2(dist_vector.x, dist_vector.y*distortion_scale.y) * float2(distortion_scale.x, -1.0f);
	output.distortion.zw = float2(1.0f, 0.0f);
	output.alpha		= float4(1.0f, 1.0f, 1.0f, 1.0f);

	return output;
}
