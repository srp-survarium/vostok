diff --git a/src/function_index.rs b/src/function_index.rs
new file mode 100644
index 0000000..d3aed84
--- /dev/null
+++ b/src/function_index.rs
@@ -0,0 +1,51 @@
+use crate::pdb_symbols::PdbSymbols;
+
+use std::fmt::Write as _;
+use std::path::Path;
+
+const HEADER: &str = "rva\tsize\tname_hex\n";
+
+pub fn write(symbols: &PdbSymbols, path: &Path) -> anyhow::Result<()> {
+    let aliases = symbols.functions.values().map(Vec::len).sum::<usize>();
+    let mut output = String::with_capacity(aliases * 80);
+    output.push_str(HEADER);
+    for (rva, names) in &symbols.functions {
+        let size = symbols
+            .function_sizes
+            .get(rva)
+            .map(|value| value.to_string())
+            .unwrap_or_else(|| "-".to_owned());
+        for name in names {
+            write!(output, "{rva:#x}\t{size}\t")?;
+            for byte in name.as_bytes() {
+                write!(output, "{byte:02x}")?;
+            }
+            output.push('\n');
+        }
+    }
+    if let Some(parent) = path.parent() {
+        std::fs::create_dir_all(parent)?;
+    }
+    std::fs::write(path, output)?;
+    eprintln!(
+        "[function-index] wrote {} PDB function aliases at {} starts -> {}",
+        aliases,
+        symbols.functions.len(),
+        path.display()
+    );
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn empty_index_has_only_the_stable_header() {
+        let symbols = PdbSymbols::default();
+        let mut output = String::new();
+        output.push_str(HEADER);
+        assert_eq!(output, "rva\tsize\tname_hex\n");
+        assert!(symbols.functions.is_empty());
+    }
+}
