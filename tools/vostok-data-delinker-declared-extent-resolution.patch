+// Multiple declarations of the same linked datum can carry incomplete arrays.
+// Keep a complete declaration only when all positive extents agree.
+fn unique_declared_extent(sizes: impl Iterator<Item = Option<u64>>) -> Option<u64> {
+    let mut positive = None;
+    let mut has_zero = false;
+    for size in sizes {
+        match size {
+            Some(0) => has_zero = true,
+            Some(size) => match positive {
+                Some(previous) if previous != size => return None,
+                _ => positive = Some(size),
+            },
+            None => {}
+        }
+    }
+    positive.or(if has_zero { Some(0) } else { None })
+}
+
+fn deduplicate_rows(rows: Vec<Row>) -> Vec<Row> {
+    let mut groups: BTreeMap<(usize, Vec<u8>, Vec<u8>), Vec<Row>> = BTreeMap::new();
+    for row in rows {
+        groups
+            .entry((row.rva, row.module.clone(), row.name.clone()))
+            .or_default()
+            .push(row);
+    }
+    groups
+        .into_values()
+        .map(|mut group| {
+            let size = unique_declared_extent(group.iter().map(|row| row.size));
+            group.sort_unstable_by(|left, right| {
+                (
+                    left.size != size,
+                    left.type_index.0,
+                    &left.archive,
+                    left.scope,
+                    left.section,
+                    left.storage,
+                    &left.public_name,
+                )
+                    .cmp(&(
+                        right.size != size,
+                        right.type_index.0,
+                        &right.archive,
+                        right.scope,
+                        right.section,
+                        right.storage,
+                        &right.public_name,
+                    ))
+            });
+            let mut row = group.remove(0);
+            row.size = size;
+            row
+        })
+        .collect()
+}
