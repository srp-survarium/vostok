## stk2 crash reports
user_data/

## Build data
binaries/
target/
debug/

## Prebuilt 3rd-party libraries (staged from vostok-libs by copy_lib_files.py;
## mirrors the shipped game's binaries.prebuilt/ layout - blobs, not source)
binaries.prebuilt/

# rustfmt backup files
**/*.rs.bk

## Libraries are stored in a different repository
*.pdb
*.exe
*.dll
*.a
*.lib

# Claude Code local state (keep shared agents + commands, ignore the rest)
.claude/*
!.claude/agents/
!.claude/commands/

# LGPL license files staged from vostok-libs into the cell SDK tree
sources/cell/host-win32/ppu/COPYING.LIB
sources/cell/host-win32/spu/COPYING.LIB

# Python
**/__pycache__/
*.pyc

# Windows Installer files (toolchain build outputs)
*.cab
*.msi
*.msix
*.msm
*.msp

