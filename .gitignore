*~
~$*

# Editors (VS Code, history)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# Nix build result symlinks
/result
/result-*

# clangd inputs (generated by `vostok tool toolchain`; renewed by
# vostok.build.ninja_regen when missing or the TU set changes) + index cache
/compile_commands.json
/clangd-vfs.yaml
/.cache/
binaries.old*/
